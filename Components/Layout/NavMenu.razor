@using Microsoft.AspNetCore.Components.Authorization

<div class="app-sidebar">
    <div class="sidebar-header">
        <div class="d-flex align-items-center gap-2">
            <div class="logo-badge">
                <i class="bi bi-shield-check"></i>
            </div>
            <div>
                <div class="logo-text">OzBI Audit</div>
                <div class="logo-subtitle">AI & SQL Monitor</div>
            </div>
        </div>
        <button class="sidebar-close-btn" @onclick="HandleMenuClick" aria-label="Kapat">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>

    <div class="sidebar-menu">
        <NavLink class="nav-item-link" href="" Match="NavLinkMatch.All" @onclick="HandleMenuClick">
            <i class="bi bi-building"></i>
            <span>Tenant Seçimi</span>
        </NavLink>

        <NavLink class="nav-item-link" href="queries" @onclick="HandleMenuClick">
            <i class="bi bi-database-fill-gear"></i>
            <span>SQL Sorgu Denetimi</span>
        </NavLink>

        <NavLink class="nav-item-link" href="users" @onclick="HandleMenuClick">
            <i class="bi bi-people"></i>
            <span>Portal Yönetimi</span>
        </NavLink>

        <NavLink class="nav-item-link" href="tenant-users" @onclick="HandleMenuClick">
            <i class="bi bi-person-search"></i>
            <span>Tenant Kullanıcı Arama</span>
        </NavLink>
    </div>

    <div class="sidebar-footer">
        <AuthorizeView>
            <Authorized>
                <div class="user-pill">
                    <div class="user-avatar">
                        @context.User.Identity?.Name?.Substring(0, 1).ToUpper()
                    </div>
                    <div style="flex: 1; min-width: 0;">
                        <div style="font-size: 0.85rem; font-weight: 600; text-overflow: ellipsis; overflow: hidden; white-space: nowrap;">
                            @context.User.Identity?.Name
                        </div>
                        <div style="font-size: 0.725rem; color: var(--text-muted); text-overflow: ellipsis; overflow: hidden; white-space: nowrap;">
                            @context.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                        </div>
                    </div>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="text-muted text-center" style="font-size: 0.8rem;">Giriş Yapılmadı</div>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback OnMenuItemClicked { get; set; }

    private async Task HandleMenuClick()
    {
        if (OnMenuItemClicked.HasDelegate)
        {
            await OnMenuItemClicked.InvokeAsync();
        }
    }
}
