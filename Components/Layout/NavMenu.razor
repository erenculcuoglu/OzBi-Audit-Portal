@using Microsoft.AspNetCore.Components.Authorization

<div class="app-sidebar">
    <div class="sidebar-header">
        <div class="header-brand-container d-flex align-items-center gap-2">
            <div class="logo-badge" style="width: 36px; height: 36px;">
                <img src="logo.png" alt="OzBI Logo" style="width: 100%; height: 100%; object-fit: contain;" />
            </div>
            <div class="logo-details d-flex align-items-center">
                <div class="logo-text mb-0">OzBI Control Tower</div>
            </div>
        </div>
        <div class="header-actions-container d-flex align-items-center gap-1">
            <button class="btn-sidebar-toggle d-none d-lg-flex" @onclick="HandleToggleCollapse" title="@(IsCollapsed ? "Menüyü Genişlet" : "Menüyü Daralt")" aria-label="Menüyü Daralt/Genişlet">
                <i class="bi @(IsCollapsed ? "bi-chevron-right" : "bi-chevron-left")"></i>
            </button>
            <button class="sidebar-close-btn" @onclick="HandleMenuClick" aria-label="Kapat">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    </div>

    <div class="sidebar-menu">
        <NavLink class="nav-item-link" href="" Match="NavLinkMatch.All" @onclick="HandleMenuClick" title="Tenant Seçimi" data-tooltip="Tenant Seçimi">
            <i class="bi bi-building"></i>
            <span>Tenant Seçimi</span>
        </NavLink>

        <NavLink class="nav-item-link" href="queries" @onclick="HandleMenuClick" title="Son İşlemler" data-tooltip="Son İşlemler">
            <i class="bi bi-database-fill-gear"></i>
            <span>Son İşlemler</span>
        </NavLink>

        <NavLink class="nav-item-link" href="feedbacks" @onclick="HandleMenuClick" title="Geri Bildirimler" data-tooltip="Geri Bildirimler">
            <i class="bi bi-chat-square-quote-fill text-warning"></i>
            <span>Geri Bildirimler</span>
        </NavLink>

        <NavLink class="nav-item-link" href="users" @onclick="HandleMenuClick" title="Kullanıcı Yönetimi" data-tooltip="Kullanıcı Yönetimi">
            <i class="bi bi-people-fill"></i>
            <span>Kullanıcı Yönetimi</span>
        </NavLink>

        <NavLink class="nav-item-link" href="tenant-users" @onclick="HandleMenuClick" title="Kullanıcı Ara" data-tooltip="Kullanıcı Ara">
            <i class="bi bi-person-vcard"></i>
            <span>Kullanıcı Ara</span>
        </NavLink>
    </div>

    <div class="sidebar-footer">
        <AuthorizeView>
            <Authorized>
                <div class="user-pill" title="@context.User.Identity?.Name" data-tooltip="@context.User.Identity?.Name">
                    <div class="user-avatar">
                        @context.User.Identity?.Name?.Substring(0, 1).ToUpper()
                    </div>
                    <div class="user-details-text" style="flex: 1; min-width: 0;">
                        <div style="font-size: 0.85rem; font-weight: 600; text-overflow: ellipsis; overflow: hidden; white-space: nowrap;">
                            @context.User.Identity?.Name
                        </div>
                        <div style="font-size: 0.725rem; color: var(--text-muted); text-overflow: ellipsis; overflow: hidden; white-space: nowrap;">
                            @context.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                        </div>
                    </div>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="text-muted text-center user-details-text" style="font-size: 0.8rem;">Giriş Yapılmadı</div>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback OnMenuItemClicked { get; set; }

    [Parameter]
    public bool IsCollapsed { get; set; }

    [Parameter]
    public EventCallback OnToggleCollapse { get; set; }

    private async Task HandleMenuClick()
    {
        if (OnMenuItemClicked.HasDelegate)
        {
            await OnMenuItemClicked.InvokeAsync();
        }
    }

    private async Task HandleToggleCollapse()
    {
        if (OnToggleCollapse.HasDelegate)
        {
            await OnToggleCollapse.InvokeAsync();
        }
    }
}

