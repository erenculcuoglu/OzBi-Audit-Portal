@code {
    [Parameter]
    public string ChatId { get; set; } = string.Empty;

    private OzBiChat? chat;
    private List<OzBiChatMessage>? messagesList;
    private bool isLoading = true;
    private string activeTab = "veri";

    private bool isComplianceModalOpen = false;
    private MikroComplianceReport? selectedComplianceReport;
    private string selectedTestedSql = string.Empty;

    private int UserPromptCount => messagesList?.Count(m => m.Role?.ToLower() == "user" || !string.IsNullOrEmpty(m.Prompt)) ?? 0;
    private int AiResponseCount => messagesList?.Count(m => m.Role?.ToLower() != "user") ?? 0;
    private int QueryModeCount => messagesList?.Count(m => !m.IsAssistantModeEffective && m.Role?.ToLower() != "user") ?? 0;
    private int AssistantModeCount => messagesList?.Count(m => m.IsAssistantModeEffective && m.Role?.ToLower() != "user") ?? 0;
    private int TotalSqlCount => GetQuestionSqlGroups().Sum(g => g.SqlQueries.Count);
    private int DislikedCount => messagesList?.Count(m => m.IsLiked == false) ?? 0;
    private int LikedCount => messagesList?.Count(m => m.IsLiked == true) ?? 0;
    private int FeedbackCommentCount => messagesList?.Count(m => !string.IsNullOrEmpty(m.FeedbackReason)) ?? 0;

    public class ConversationTurn
    {
        public int TurnIndex { get; set; }
        public string UserQuestion { get; set; } = string.Empty;
        public DateTime? QuestionDate { get; set; }
        public string? UserName { get; set; }

        public string? AiMessage { get; set; }
        public string? AiSummary { get; set; }
        public string? RawQuery { get; set; }
        public List<SqlLogItem> SqlQueries { get; set; } = new();
        public bool IsAsistantMode { get; set; }
        public string? AssistantName { get; set; }
        public string? AiModelName { get; set; }
        public long? TotalDurationMs { get; set; }
        public DateTime? ResponseDate { get; set; }
        public bool IsSucceeded { get; set; } = true;
        public string? ErrorMessage { get; set; }

        public bool? IsLiked { get; set; }
        public string? FeedbackReason { get; set; }
    }

    public class QuestionSqlGroup
    {
        public int QuestionIndex { get; set; }
        public string QuestionText { get; set; } = string.Empty;
        public bool IsAsistantMode { get; set; }
        public string? AssistantName { get; set; }
        public string? AiModelName { get; set; }
        public DateTime? DateCreated { get; set; }
        public bool? IsLiked { get; set; }
        public string? FeedbackReason { get; set; }
        public List<SqlLogItem> SqlQueries { get; set; } = new();
    }

    public class SqlLogItem
    {
        public int SubIndex { get; set; }
        public string Description { get; set; } = string.Empty;
        public string Sql { get; set; } = string.Empty;
        public bool IsSucceeded { get; set; }
        public string? ErrorMessage { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            chat = await AuditService.GetChatByIdAsync(ChatId);
            messagesList = await AuditService.GetMessagesForChatAsync(ChatId);
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error loading chat detail: " + ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SetActiveTab(string tabName)
    {
        activeTab = tabName;
    }

    private void OpenComplianceModal(MikroComplianceReport report, string sql)
    {
        selectedComplianceReport = report;
        selectedTestedSql = sql;
        isComplianceModalOpen = true;
    }

    private string GetScoreColor(int score)
    {
        if (score >= 90) return "#10b981"; // Green
        if (score >= 75) return "#3b82f6"; // Blue
        if (score >= 60) return "#f59e0b"; // Yellow/Amber
        return "#ef4444"; // Red
    }

    private List<ConversationTurn> GetConversationTurns()
    {
        var turns = new List<ConversationTurn>();
        if (messagesList == null || messagesList.Count == 0) return turns;

        ConversationTurn? currentTurn = null;
        int turnCounter = 0;

        foreach (var msg in messagesList.OrderBy(m => m.DateCreated))
        {
            bool isUserRole = msg.Role?.ToLower() == "user";
            var promptText = !string.IsNullOrWhiteSpace(msg.Prompt) 
                ? msg.Prompt 
                : (isUserRole ? msg.Message : null);

            if (!string.IsNullOrWhiteSpace(promptText))
            {
                turnCounter++;
                currentTurn = new ConversationTurn
                {
                    TurnIndex = turnCounter,
                    UserQuestion = promptText,
                    QuestionDate = msg.DateCreated,
                    UserName = chat?.CreatedByUser?.NameSurname ?? chat?.CreatedByUser?.Email ?? "Kullanıcı",
                    IsLiked = msg.IsLiked,
                    FeedbackReason = msg.FeedbackReason,
                    IsAsistantMode = msg.IsAssistantModeEffective,
                    AssistantName = msg.Assistant?.Name,
                    AiModelName = msg.AIModel?.Name ?? msg.AIModel?.ProgrammaticName
                };
                turns.Add(currentTurn);
            }

            if (currentTurn != null)
            {
                if (msg.IsLiked.HasValue) currentTurn.IsLiked = msg.IsLiked;
                if (!string.IsNullOrEmpty(msg.FeedbackReason)) currentTurn.FeedbackReason = msg.FeedbackReason;
                if (msg.IsAssistantModeEffective) currentTurn.IsAsistantMode = true;
                if (!string.IsNullOrEmpty(msg.Assistant?.Name)) currentTurn.AssistantName = msg.Assistant.Name;
                if (!string.IsNullOrEmpty(msg.AIModel?.Name ?? msg.AIModel?.ProgrammaticName)) 
                    currentTurn.AiModelName = msg.AIModel?.Name ?? msg.AIModel?.ProgrammaticName;
                
                if (!isUserRole)
                {
                    if (!string.IsNullOrWhiteSpace(msg.Message)) currentTurn.AiMessage = msg.Message;
                    if (!string.IsNullOrWhiteSpace(msg.Summary)) currentTurn.AiSummary = msg.Summary;
                    if (msg.TotalDurationMs.HasValue && msg.TotalDurationMs > 0) currentTurn.TotalDurationMs = msg.TotalDurationMs;
                    if (msg.DateCreated.HasValue) currentTurn.ResponseDate = msg.DateCreated;
                    if (!string.IsNullOrEmpty(msg.ErrorMessage)) currentTurn.ErrorMessage = msg.ErrorMessage;
                    
                    if (!string.IsNullOrWhiteSpace(msg.Query))
                    {
                        currentTurn.RawQuery = msg.Query;
                        var extracted = ExtractSqlItemsFromQuery(msg.Query, msg.IsSucceeded, msg.ErrorMessage);
                        foreach (var sql in extracted)
                        {
                            if (!currentTurn.SqlQueries.Any(s => s.Sql == sql.Sql))
                            {
                                sql.SubIndex = currentTurn.SqlQueries.Count + 1;
                                currentTurn.SqlQueries.Add(sql);
                            }
                        }
                    }
                }
            }
            else if (!isUserRole)
            {
                // Standalone AI message without preceding user prompt
                turnCounter++;
                currentTurn = new ConversationTurn
                {
                    TurnIndex = turnCounter,
                    UserQuestion = chat?.Title ?? "Sohbet Talebi",
                    QuestionDate = msg.DateCreated,
                    UserName = chat?.CreatedByUser?.NameSurname ?? chat?.CreatedByUser?.Email ?? "Kullanıcı",
                    AiMessage = msg.Message,
                    AiSummary = msg.Summary,
                    RawQuery = msg.Query,
                    TotalDurationMs = msg.TotalDurationMs,
                    ResponseDate = msg.DateCreated,
                    IsLiked = msg.IsLiked,
                    FeedbackReason = msg.FeedbackReason,
                    IsAsistantMode = msg.IsAssistantModeEffective,
                    AssistantName = msg.Assistant?.Name,
                    AiModelName = msg.AIModel?.Name ?? msg.AIModel?.ProgrammaticName,
                    ErrorMessage = msg.ErrorMessage
                };
                if (!string.IsNullOrWhiteSpace(msg.Query))
                {
                    currentTurn.SqlQueries = ExtractSqlItemsFromQuery(msg.Query, msg.IsSucceeded, msg.ErrorMessage);
                }
                turns.Add(currentTurn);
            }
        }

        return turns;
    }

    private List<QuestionSqlGroup> GetQuestionSqlGroups()
    {
        var groups = new List<QuestionSqlGroup>();
        if (messagesList == null) return groups;

        QuestionSqlGroup? currentGroup = null;
        int questionCounter = 0;

        foreach (var msg in messagesList)
        {
            var promptText = !string.IsNullOrEmpty(msg.Prompt) ? msg.Prompt : (msg.Role?.ToLower() == "user" ? msg.Message : null);
            bool isAssistant = msg.IsAssistantModeEffective;

            if (!string.IsNullOrEmpty(promptText))
            {
                questionCounter++;
                currentGroup = new QuestionSqlGroup
                {
                    QuestionIndex = questionCounter,
                    QuestionText = promptText,
                    IsAsistantMode = isAssistant,
                    AssistantName = msg.Assistant?.Name,
                    AiModelName = msg.AIModel?.Name ?? msg.AIModel?.ProgrammaticName,
                    DateCreated = msg.DateCreated,
                    IsLiked = msg.IsLiked,
                    FeedbackReason = msg.FeedbackReason,
                    SqlQueries = new List<SqlLogItem>()
                };
                groups.Add(currentGroup);
            }

            if (currentGroup != null)
            {
                if (isAssistant)
                {
                    currentGroup.IsAsistantMode = true;
                }
                if (string.IsNullOrEmpty(currentGroup.AssistantName) && msg.Assistant != null)
                {
                    currentGroup.AssistantName = msg.Assistant.Name;
                }
                if (string.IsNullOrEmpty(currentGroup.AiModelName) && msg.AIModel != null)
                {
                    currentGroup.AiModelName = msg.AIModel.Name ?? msg.AIModel.ProgrammaticName;
                }
                if (msg.IsLiked.HasValue)
                {
                    currentGroup.IsLiked = msg.IsLiked;
                }
                if (!string.IsNullOrEmpty(msg.FeedbackReason))
                {
                    currentGroup.FeedbackReason = msg.FeedbackReason;
                }
            }

            if (!string.IsNullOrWhiteSpace(msg.Query))
            {
                if (currentGroup == null)
                {
                    questionCounter++;
                    currentGroup = new QuestionSqlGroup
                    {
                        QuestionIndex = questionCounter,
                        QuestionText = chat?.Title ?? "Sohbet Sorusu",
                        IsAsistantMode = isAssistant,
                        AssistantName = msg.Assistant?.Name,
                        DateCreated = msg.DateCreated,
                        IsLiked = msg.IsLiked,
                        FeedbackReason = msg.FeedbackReason,
                        SqlQueries = new List<SqlLogItem>()
                    };
                    groups.Add(currentGroup);
                }

                var extractedSqls = ExtractSqlItemsFromQuery(msg.Query, msg.IsSucceeded, msg.ErrorMessage);
                foreach (var sqlItem in extractedSqls)
                {
                    sqlItem.SubIndex = currentGroup.SqlQueries.Count + 1;
                    currentGroup.SqlQueries.Add(sqlItem);
                }
            }
        }

        var groupsWithSql = groups.Where(g => g.SqlQueries.Count > 0).ToList();
        return groupsWithSql.Count > 0 ? groupsWithSql : groups;
    }

    private List<SqlLogItem> ExtractSqlItemsFromQuery(string rawQuery, bool isSucceeded, string? errorMessage)
    {
        var result = new List<SqlLogItem>();
        if (string.IsNullOrWhiteSpace(rawQuery)) return result;

        var trimmed = rawQuery.Trim();
        bool actualSuccess = string.IsNullOrEmpty(errorMessage);

        if ((trimmed.StartsWith("[") && trimmed.EndsWith("]")) || (trimmed.StartsWith("{") && trimmed.EndsWith("}")))
        {
            try
            {
                using var doc = System.Text.Json.JsonDocument.Parse(trimmed);
                var root = doc.RootElement;

                if (root.ValueKind == System.Text.Json.JsonValueKind.Array)
                {
                    foreach (var element in root.EnumerateArray())
                    {
                        var item = ExtractFromElement(element, actualSuccess, errorMessage);
                        if (item != null) result.Add(item);
                    }
                }
                else if (root.ValueKind == System.Text.Json.JsonValueKind.Object)
                {
                    var item = ExtractFromElement(root, actualSuccess, errorMessage);
                    if (item != null) result.Add(item);
                }
            }
            catch
            {
                // Fallback
            }
        }

        if (result.Count == 0)
        {
            result.Add(new SqlLogItem
            {
                Description = string.Empty,
                Sql = trimmed,
                IsSucceeded = actualSuccess,
                ErrorMessage = errorMessage
            });
        }

        return result;
    }

    private SqlLogItem? ExtractFromElement(System.Text.Json.JsonElement elem, bool isSucceeded, string? errorMessage)
    {
        string desc = string.Empty;
        string sql = string.Empty;

        if (TryGetJsonProp(elem, "description", out var val) ||
            TryGetJsonProp(elem, "Description", out val) ||
            TryGetJsonProp(elem, "summary", out val) ||
            TryGetJsonProp(elem, "title", out val))
        {
            desc = val;
        }

        if (TryGetJsonProp(elem, "sql", out var sqlVal) ||
            TryGetJsonProp(elem, "Sql", out sqlVal) ||
            TryGetJsonProp(elem, "query", out sqlVal) ||
            TryGetJsonProp(elem, "Query", out sqlVal) ||
            TryGetJsonProp(elem, "tSql", out sqlVal))
        {
            sql = sqlVal;
        }

        if (string.IsNullOrWhiteSpace(sql))
        {
            if (elem.ValueKind == System.Text.Json.JsonValueKind.String)
                sql = elem.GetString() ?? string.Empty;
            else
                sql = elem.GetRawText();
        }

        if (string.IsNullOrWhiteSpace(sql)) return null;

        return new SqlLogItem
        {
            Description = desc,
            Sql = sql,
            IsSucceeded = isSucceeded,
            ErrorMessage = errorMessage
        };
    }

    private bool TryGetJsonProp(System.Text.Json.JsonElement elem, string propName, out string value)
    {
        value = string.Empty;
        if (elem.ValueKind == System.Text.Json.JsonValueKind.Object && elem.TryGetProperty(propName, out var prop))
        {
            if (prop.ValueKind == System.Text.Json.JsonValueKind.String)
            {
                value = prop.GetString() ?? string.Empty;
                return !string.IsNullOrWhiteSpace(value);
            }
        }
        return false;
    }

    private async Task CopySql(string text)
    {
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
    }
}

