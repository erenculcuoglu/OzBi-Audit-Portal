@page "/chat/{ChatId}"
@inject IOzBiAuditService AuditService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@using OzBiPortalCRM.Services
@using OzBiPortalCRM.Models

<div class="mb-4">
    @if (chat != null)
    {
        <a href="tenant/@chat.TenantId/chats" class="btn btn-outline-secondary btn-sm mb-3">
            <i class="bi bi-arrow-left"></i> Chat Listesine Dön
        </a>

        <div class="glass-card mb-4">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge-status badge-info"><i class="bi bi-building"></i> @(chat.Tenant?.Name ?? "Tenant")</span>
                        <span class="badge-status badge-purple"><i class="bi bi-chat-dots"></i> Chat Detayı</span>
                    </div>
                    <h3 class="fw-bold mb-1">@(string.IsNullOrWhiteSpace(chat.Title) ? "Başlıksız Sohbet" : chat.Title)</h3>
                    <div class="text-muted small d-flex align-items-center gap-3 flex-wrap">
                        <span><i class="bi bi-person"></i> Oluşturan: @(chat.CreatedByUser?.NameSurname ?? chat.CreatedByUser?.Email ?? "Sistem/Kullanıcı")</span>
                        <span><i class="bi bi-calendar3"></i> Tarih: @(chat.DateCreated?.ToString("dd.MM.yyyy HH:mm:ss") ?? "-")</span>
                        <span style="font-family: monospace;">Chat ID: @chat.Id</span>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <div class="text-center p-2 rounded bg-black bg-opacity-30 border border-secondary border-opacity-25 px-3">
                        <div class="fs-5 fw-bold text-info">@UserPromptCount</div>
                        <div class="text-muted small">Kullanıcı Sorusu</div>
                    </div>
                    <div class="text-center p-2 rounded bg-black bg-opacity-30 border border-secondary border-opacity-25 px-3">
                        <div class="fs-5 fw-bold text-primary">@AiResponseCount</div>
                        <div class="text-muted small">AI Analiz Yanıtı</div>
                    </div>
                    <div class="text-center p-2 rounded bg-black bg-opacity-30 border border-secondary border-opacity-25 px-3">
                        <div class="fs-5 fw-bold text-success">@TotalIndividualSqlCount</div>
                        <div class="text-muted small">Üretilen SQL</div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (isLoading)
{
    <div class="glass-card text-center py-5">
        <div class="spinner-border text-primary mb-3" role="status"></div>
        <div class="text-muted">Chat mesajları ve SQL detayları yükleniyor...</div>
    </div>
}
else if (messagesList == null || messagesList.Count == 0)
{
    <div class="glass-card text-center py-5">
        <i class="bi bi-chat-square-x text-muted" style="font-size: 3rem;"></i>
        <h5 class="mt-3 text-muted">Bu sohbete ait mesaj bulunamadı</h5>
    </div>
}
else
{
    <!-- Tab Switcher Header (Veri | Sorgu) -->
    <div class="tab-container mb-4">
        <button class="btn-tab @(activeTab == "veri" ? "active" : "")" @onclick='() => SetActiveTab("veri")'>
            Veri
        </button>
        <button class="btn-tab @(activeTab == "sorgu" ? "active" : "")" @onclick='() => SetActiveTab("sorgu")'>
            Sorgu
        </button>
    </div>

    @if (activeTab == "veri")
    {
        <!-- VERİ TAB: Displays User Prompts & AI Analysis Response Text -->
        <div class="d-flex flex-column gap-4">
            @foreach (var (msg, index) in messagesList.Select((m, i) => (m, i + 1)))
            {
                <div class="glass-card border-secondary border-opacity-25">
                    <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-secondary opacity-75 rounded-pill px-2 py-1" style="font-size: 0.75rem;">#@index</span>
                            <span class="fw-bold text-main" style="font-size: 0.95rem;">
                                @if (msg.Role?.ToLower() == "user")
                                {
                                    <i class="bi bi-person-fill text-info me-1"></i><span>Kullanıcı Sorduğu Soru</span>
                                }
                                else
                                {
                                    <i class="bi bi-robot text-primary me-1"></i><span>OzBI AI Analiz Yanıtı</span>
                                }
                            </span>
                        </div>

                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            @if (msg.AIModel != null)
                            {
                                <span class="badge-status badge-purple" title="Çalıştırılan AI Modeli">
                                    <i class="bi bi-cpu-fill"></i> Model: @(msg.AIModel.Name ?? msg.AIModel.ProgrammaticName)
                                </span>
                            }

                            @if (msg.Assistant != null)
                            {
                                <span class="badge-status badge-info" title="Asistan Adı">
                                    <i class="bi bi-bot"></i> Asistan: @msg.Assistant.Name
                                </span>
                            }

                            <span class="text-muted small"><i class="bi bi-clock"></i> @(msg.DateCreated?.ToString("dd.MM.yyyy HH:mm:ss") ?? "-")</span>
                        </div>
                    </div>

                    <!-- User Prompt / Question Text -->
                    @if (!string.IsNullOrEmpty(msg.Prompt) || (msg.Role?.ToLower() == "user" && !string.IsNullOrEmpty(msg.Message)))
                    {
                        <div class="p-3 mb-3 rounded bg-black bg-opacity-40 border border-secondary border-opacity-25">
                            <div class="text-muted small fw-bold mb-1 text-uppercase" style="letter-spacing: 0.5px; font-size: 0.7rem;">
                                <i class="bi bi-question-circle text-info me-1"></i> Kullanıcı İletisi (Prompt)
                            </div>
                            <div class="text-main" style="white-space: pre-wrap; font-size: 0.95rem;">
                                @(string.IsNullOrEmpty(msg.Prompt) ? msg.Message : msg.Prompt)
                            </div>
                        </div>
                    }

                    <!-- AI Analysis Response Message Text -->
                    @if (msg.Role?.ToLower() != "user" && !string.IsNullOrEmpty(msg.Message))
                    {
                        <div class="p-3 rounded bg-black bg-opacity-30 border border-secondary border-opacity-25">
                            <div class="text-muted small fw-bold mb-1 text-uppercase" style="letter-spacing: 0.5px; font-size: 0.7rem;">
                                <i class="bi bi-chat-quote text-primary me-1"></i> OzBI AI Analiz Yanıtı / Özet
                            </div>
                            <div class="text-main" style="white-space: pre-wrap; font-size: 0.925rem;">
                                @msg.Message
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else if (activeTab == "sorgu")
    {
        <!-- SORGU TAB: Displays SQL Queries with summaries above code blocks matching reference design -->
        var allQueries = GetAllSqlQueriesWithDetails();

        if (allQueries.Count == 0)
        {
            <div class="glass-card text-center py-5">
                <i class="bi bi-code-slash text-muted" style="font-size: 3rem;"></i>
                <h5 class="mt-3 text-muted">Bu sohbete ait üretilmiş SQL sorgusu bulunamadı</h5>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-4">
                @foreach (var sqlItem in allQueries)
                {
                    <div class="glass-card border-secondary border-opacity-25">
                        <!-- Query Summary Description Header (Above dark code block) -->
                        @if (!string.IsNullOrEmpty(sqlItem.Description))
                        {
                            <div class="fw-bold text-main mb-3" style="font-size: 0.95rem; line-height: 1.45;">
                                @sqlItem.Description
                            </div>
                        }

                        <!-- Dark Code Block with SQL Code -->
                        <div class="sql-header py-2 px-3">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-info bg-opacity-20 text-info border border-info border-opacity-30" style="font-size: 0.7rem;">
                                    @sqlItem.Label
                                </span>
                                @if (sqlItem.IsSucceeded)
                                {
                                    <span class="badge-status badge-success ms-1"><i class="bi bi-check-circle"></i> Başarılı</span>
                                }
                                else
                                {
                                    <span class="badge-status badge-danger ms-1"><i class="bi bi-exclamation-triangle"></i> Sorgu Hatalı</span>
                                }
                            </div>
                            <button class="btn-copy" @onclick="() => CopySql(sqlItem.Query)">
                                <i class="bi bi-clipboard"></i> SQL Kopyala
                            </button>
                        </div>
                        <div class="sql-code-block">
                            <code>@sqlItem.Query</code>
                        </div>

                        @if (!string.IsNullOrEmpty(sqlItem.ErrorMessage))
                        {
                            <div class="p-2.5 mt-3 rounded bg-danger bg-opacity-10 border border-danger border-opacity-20 text-danger small font-monospace">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i> <strong>Hata Detayı:</strong> @sqlItem.ErrorMessage
                            </div>
                        }
                    </div>
                }
            </div>
        }
    }
}

@code {
    [Parameter]
    public string ChatId { get; set; } = string.Empty;

    private OzBiChat? chat;
    private List<OzBiChatMessage>? messagesList;
    private bool isLoading = true;
    private string activeTab = "sorgu"; // Default to "Sorgu" tab per user preference

    private int UserPromptCount => messagesList?.Count(m => m.Role?.ToLower() == "user" || !string.IsNullOrEmpty(m.Prompt)) ?? 0;
    private int AiResponseCount => messagesList?.Count(m => m.Role?.ToLower() != "user" && !string.IsNullOrEmpty(m.Message)) ?? 0;
    private int TotalIndividualSqlCount => GetAllSqlQueriesWithDetails().Count;

    public class SqlItemDetail
    {
        public string Label { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string Query { get; set; } = string.Empty;
        public bool IsSucceeded { get; set; }
        public string? ErrorMessage { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            chat = await AuditService.GetChatByIdAsync(ChatId);
            messagesList = await AuditService.GetMessagesForChatAsync(ChatId);
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error loading chat detail: " + ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SetActiveTab(string tabName)
    {
        activeTab = tabName;
    }

    private List<SqlItemDetail> GetAllSqlQueriesWithDetails()
    {
        var result = new List<SqlItemDetail>();
        if (messagesList == null) return result;

        foreach (var (msg, msgIdx) in messagesList.Select((m, i) => (m, i + 1)))
        {
            if (string.IsNullOrWhiteSpace(msg.Query)) continue;

            var rawStatements = msg.Query.Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries)
                .Select(s => s.Trim())
                .Where(s => s.Length > 5)
                .ToList();

            if (rawStatements.Count == 0)
            {
                rawStatements.Add(msg.Query.Trim());
            }

            var promptText = !string.IsNullOrEmpty(msg.Prompt) ? msg.Prompt : (msg.Role?.ToLower() == "user" ? msg.Message : null);
            var defaultDesc = promptText ?? chat?.Title ?? $"Sohbet Sorgusu #{msgIdx}";

            for (int subIdx = 0; subIdx < rawStatements.Count; subIdx++)
            {
                var stmt = rawStatements[subIdx];
                result.Add(new SqlItemDetail
                {
                    Label = rawStatements.Count > 1 ? $"Sorgu #{msgIdx}.{subIdx + 1}" : $"Sorgu #{msgIdx}",
                    Description = rawStatements.Count > 1 ? $"{defaultDesc} (Parça {subIdx + 1})" : defaultDesc,
                    Query = stmt,
                    IsSucceeded = msg.IsSucceeded,
                    ErrorMessage = msg.ErrorMessage
                });
            }
        }

        return result;
    }

    private async Task CopySql(string text)
    {
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
    }
}
