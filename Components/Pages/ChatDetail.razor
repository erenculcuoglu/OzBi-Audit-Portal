@page "/chat/{ChatId}"
@inject IOzBiAuditService AuditService
@inject IMikroAuditEngine MikroAuditEngine
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@using OzBiPortalCRM.Services
@using OzBiPortalCRM.Models
@using OzBiPortalCRM.Components.Shared

<div class="mb-4">
    @if (chat != null)
    {
        <a href="tenant/@chat.TenantId/chats" class="btn btn-outline-secondary btn-sm mb-3">
            <i class="bi bi-arrow-left"></i> Chat Listesine Dön
        </a>

        <div class="glass-card mb-4">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge-status badge-info"><i class="bi bi-building"></i> @(chat.Tenant?.Name ?? "Tenant")</span>
                        <span class="badge-status badge-purple"><i class="bi bi-chat-dots"></i> Chat Denetim Kaydı</span>
                    </div>
                    <h3 class="fw-bold mb-1">@(string.IsNullOrWhiteSpace(chat.Title) ? "Başlıksız Sohbet" : chat.Title)</h3>
                    <div class="text-muted small d-flex align-items-center gap-3 flex-wrap">
                        <span><i class="bi bi-person"></i> Oluşturan: @(chat.CreatedByUser?.NameSurname ?? chat.CreatedByUser?.Email ?? "Sistem/Kullanıcı")</span>
                        <span><i class="bi bi-calendar3"></i> Tarih: @(chat.DateCreated?.ToString("dd.MM.yyyy HH:mm:ss") ?? "-")</span>
                        <span style="font-family: monospace;">Chat ID: @chat.Id</span>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <div class="text-center p-2 rounded bg-black bg-opacity-30 border border-secondary border-opacity-25 px-3">
                        <div class="fs-5 fw-bold text-info">@UserPromptCount</div>
                        <div class="text-muted small">Kullanıcı Sorusu</div>
                    </div>
                    <div class="text-center p-2 rounded bg-black bg-opacity-30 border border-secondary border-opacity-25 px-3">
                        <div class="fs-5 fw-bold text-primary">@AiResponseCount</div>
                        <div class="text-muted small">AI Analiz Yanıtı</div>
                    </div>
                    <div class="text-center p-2 rounded bg-black bg-opacity-30 border border-secondary border-opacity-25 px-3">
                        <div class="fs-5 fw-bold text-success">@TotalSqlCount</div>
                        <div class="text-muted small">Üretilen Toplam SQL</div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (isLoading)
{
    <div class="glass-card text-center py-5">
        <div class="spinner-border text-primary mb-3" role="status"></div>
        <div class="text-muted">Chat veritabanı logları yükleniyor...</div>
    </div>
}
else if (messagesList == null || messagesList.Count == 0)
{
    <div class="glass-card text-center py-5">
        <i class="bi bi-chat-square-x text-muted" style="font-size: 3rem;"></i>
        <h5 class="mt-3 text-muted">Bu sohbete ait veritabanı logu bulunamadı</h5>
    </div>
}
else
{
    <!-- Tab Switcher Header (Sorgu | Veri) -->
    <div class="tab-container mb-4">
        <button class="btn-tab @(activeTab == "sorgu" ? "active" : "")" @onclick='() => SetActiveTab("sorgu")'>
            <i class="bi bi-code-slash me-1"></i> SQL Sorguları (@TotalSqlCount)
        </button>
        <button class="btn-tab @(activeTab == "veri" ? "active" : "")" @onclick='() => SetActiveTab("veri")'>
            <i class="bi bi-file-earmark-text me-1"></i> AI Yanıtları
        </button>
    </div>

    @if (activeTab == "sorgu")
    {
        <!-- SORGU TAB: Grouped BY USER QUESTION / PROMPT -->
        var questionGroups = GetQuestionSqlGroups();

        if (questionGroups.Count == 0)
        {
            <div class="glass-card text-center py-5">
                <i class="bi bi-code-slash text-muted" style="font-size: 3rem;"></i>
                <h5 class="mt-3 text-muted">Bu sohbete ait üretilmiş SQL sorgusu bulunamadı</h5>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-4">
                @foreach (var qGroup in questionGroups)
                {
                    <div class="glass-card border-primary border-opacity-30">
                        <!-- User Question Group Header -->
                        <div class="p-3 mb-3 rounded bg-black bg-opacity-40 border border-primary border-opacity-25 d-flex align-items-center justify-content-between flex-wrap gap-2">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="badge bg-primary text-white px-2 py-1" style="font-size: 0.8rem;">
                                        Soru #@qGroup.QuestionIndex
                                    </span>
                                    <span class="text-muted small">
                                        <i class="bi bi-clock"></i> @(qGroup.DateCreated?.ToString("dd.MM.yyyy HH:mm:ss") ?? "-")
                                    </span>
                                </div>
                                <div class="fs-6 fw-bold text-main">
                                    <i class="bi bi-question-circle-fill text-info me-1"></i> @qGroup.QuestionText
                                </div>
                            </div>

                            <span class="badge-status badge-success">
                                <i class="bi bi-database-gear me-1"></i> @qGroup.SqlQueries.Count SQL Sorgusu Üretildi
                            </span>
                        </div>

                        <!-- SQL Queries generated for THIS Question -->
                        <div class="d-flex flex-column gap-3">
                            @foreach (var sqlItem in qGroup.SqlQueries)
                            {
                                var compliance = MikroAuditEngine.EvaluateQuery(sqlItem.Sql, qGroup.QuestionText, chat?.Tenant?.Name);

                                <div class="p-3 rounded bg-black bg-opacity-20 border border-secondary border-opacity-25">
                                    @if (!string.IsNullOrEmpty(sqlItem.Description))
                                    {
                                        <div class="text-main fw-semibold mb-2" style="font-size: 0.9rem;">
                                            @sqlItem.Description
                                        </div>
                                    }

                                    <div class="sql-header py-2 px-3">
                                        <div class="d-flex align-items-center gap-2 flex-wrap">
                                            <span class="badge bg-dark text-info border border-info border-opacity-50 px-2 py-1 font-monospace" style="font-size: 0.8rem;">
                                                Sorgu #@qGroup.QuestionIndex.@sqlItem.SubIndex
                                            </span>

                                            <!-- Multi-ERP Compliance Score Badge (Mikro / Logo) -->
                                            @if (compliance.IsMikroQuery)
                                            {
                                                var erpLabel = compliance is ErpComplianceReport erpRep ? erpRep.SystemTypeName : "Mikro v27";
                                                <button type="button" class="btn btn-sm p-0 border-0 bg-transparent text-decoration-none" @onclick="() => OpenComplianceModal(compliance, sqlItem.Sql)">
                                                    <span class="badge-status" style="background: rgba(15, 23, 42, 0.8); border: 1px solid @GetScoreColor(compliance.Score); color: @GetScoreColor(compliance.Score); cursor: pointer;" title="Detaylı ERP Uyum Raporu İçin Tıklayın">
                                                        <i class="bi bi-shield-check me-1"></i>@erpLabel Uyum: <strong>@compliance.Score/100</strong> (@compliance.Grade)
                                                    </span>
                                                </button>
                                            }

                                            @if (sqlItem.IsSucceeded)
                                            {
                                                <span class="badge-status badge-success ms-1"><i class="bi bi-check-circle"></i> Başarılı</span>
                                            }
                                            else
                                            {
                                                <span class="badge-status badge-danger ms-1"><i class="bi bi-exclamation-triangle"></i> Sorgu Hatalı</span>
                                            }
                                        </div>
                                        <button class="btn-copy" @onclick="() => CopySql(sqlItem.Sql)">
                                            <i class="bi bi-clipboard"></i> SQL Kopyala
                                        </button>
                                    </div>
                                    <div class="sql-code-block">
                                        <code>@sqlItem.Sql</code>
                                    </div>

                                    @if (!string.IsNullOrEmpty(sqlItem.ErrorMessage))
                                    {
                                        <div class="p-2.5 mt-2 rounded bg-danger bg-opacity-10 border border-danger border-opacity-20 text-danger small font-monospace">
                                            <i class="bi bi-exclamation-triangle-fill me-1"></i> <strong>Hata Detayı:</strong> @sqlItem.ErrorMessage
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }
    else if (activeTab == "veri")
    {
        <!-- VERİ TAB: Displays User Prompts & AI Analysis Response Text -->
        <div class="d-flex flex-column gap-4">
            @foreach (var (msg, index) in messagesList.Select((m, i) => (m, i + 1)))
            {
                var isUser = msg.Role?.ToLower() == "user";
                var cardBorderClass = isUser ? "border-start border-4 border-info" : "border-start border-4 border-primary";
                var cardBgStyle = isUser ? "background: linear-gradient(135deg, rgba(6, 182, 212, 0.05) 0%, rgba(15, 23, 42, 0.6) 100%);" : "background: linear-gradient(135deg, rgba(139, 92, 246, 0.06) 0%, rgba(15, 23, 42, 0.6) 100%);";

                <div class="glass-card @cardBorderClass" style="@cardBgStyle">
                    <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2 pb-2 border-bottom border-secondary border-opacity-25">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge @(isUser ? "bg-info text-dark" : "bg-primary text-white") rounded-pill px-2.5 py-1" style="font-size: 0.75rem; font-weight: 700;">#@index Log Kaydı</span>
                            <span class="fw-bold text-main" style="font-size: 0.95rem;">
                                @if (isUser)
                                {
                                    <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-30 px-2.5 py-1 rounded-pill">
                                        <i class="bi bi-person-fill me-1"></i>Kullanıcı Sorusu
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-primary bg-opacity-15 text-primary border border-primary border-opacity-30 px-2.5 py-1 rounded-pill">
                                        <i class="bi bi-robot me-1"></i>AI Yanıtı
                                    </span>
                                }
                            </span>
                        </div>

                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            @if (msg.AIModel != null)
                            {
                                <span class="badge-status badge-purple" title="AI Modeli">
                                    <i class="bi bi-cpu-fill"></i> Model: @(msg.AIModel.Name ?? msg.AIModel.ProgrammaticName)
                                </span>
                            }
                            @if (msg.Assistant != null)
                            {
                                <span class="badge-status badge-info" title="Asistan">
                                    <i class="bi bi-bot"></i> Asistan: @msg.Assistant.Name
                                </span>
                            }
                            <span class="text-muted small"><i class="bi bi-clock"></i> @(msg.DateCreated?.ToString("dd.MM.yyyy HH:mm:ss") ?? "-")</span>
                        </div>
                    </div>

                    <!-- Kullanıcı Sorusu (Prompt) -->
                    @if (!string.IsNullOrEmpty(msg.Prompt) || (isUser && !string.IsNullOrEmpty(msg.Message)))
                    {
                        <div class="p-3.5 mb-2 rounded border" style="background: rgba(6, 182, 212, 0.06); border-color: rgba(6, 182, 212, 0.25) !important;">
                            <div class="text-info small fw-bold mb-2 text-uppercase d-flex align-items-center gap-2" style="letter-spacing: 0.5px; font-size: 0.725rem;">
                                <i class="bi bi-chat-left-text-fill text-info fs-6"></i>
                                <span>Kullanıcı Sorusu</span>
                            </div>
                            <div class="text-main fw-semibold" style="white-space: pre-wrap; font-size: 0.95rem; line-height: 1.5;">
                                @(string.IsNullOrEmpty(msg.Prompt) ? msg.Message : msg.Prompt)
                            </div>
                        </div>
                    }

                    <!-- AI Yanıtı -->
                    @if (!isUser)
                    {
                        <div class="p-3.5 rounded border" style="background: rgba(139, 92, 246, 0.08); border-color: rgba(139, 92, 246, 0.3) !important;">
                            <div class="text-primary small fw-bold mb-2 text-uppercase d-flex align-items-center justify-content-between" style="letter-spacing: 0.5px; font-size: 0.725rem;">
                                <span class="d-flex align-items-center gap-2"><i class="bi bi-stars text-primary fs-6"></i> AI Yanıtı</span>
                                @if (msg.TotalDurationMs.HasValue && msg.TotalDurationMs > 0)
                                {
                                    <span class="text-muted opacity-75 font-monospace"><i class="bi bi-stopwatch me-1"></i>@(msg.TotalDurationMs)ms</span>
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(msg.Message))
                            {
                                <div class="text-main" style="white-space: pre-wrap; font-size: 0.935rem; line-height: 1.6;">
                                    @msg.Message
                                </div>
                            }
                            else if (!string.IsNullOrWhiteSpace(msg.Summary))
                            {
                                <div class="text-main" style="white-space: pre-wrap; font-size: 0.935rem; line-height: 1.6;">
                                    @msg.Summary
                                </div>
                            }
                            else
                            {
                                <div class="text-muted small italic opacity-75 py-2">
                                    <i class="bi bi-exclamation-circle text-warning me-1"></i> 
                                    <span>AI doğal dil yanıt metni veritabanına boş kaydedilmiş (Ana OzBI uygulamasındaki akış/kayıt aşamasında `Message` alanı doldurulmamış).</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }
}

<!-- Mikro Compliance Modal -->
<ErpComplianceModal @bind-IsOpen="isComplianceModalOpen" Report="@selectedComplianceReport" TestedSql="@selectedTestedSql" />

@code {
    [Parameter]
    public string ChatId { get; set; } = string.Empty;

    private OzBiChat? chat;
    private List<OzBiChatMessage>? messagesList;
    private bool isLoading = true;
    private string activeTab = "sorgu";

    private bool isComplianceModalOpen = false;
    private MikroComplianceReport? selectedComplianceReport;
    private string selectedTestedSql = string.Empty;

    private int UserPromptCount => messagesList?.Count(m => m.Role?.ToLower() == "user" || !string.IsNullOrEmpty(m.Prompt)) ?? 0;
    private int AiResponseCount => messagesList?.Count(m => m.Role?.ToLower() != "user") ?? 0;
    private int TotalSqlCount => GetQuestionSqlGroups().Sum(g => g.SqlQueries.Count);

    public class QuestionSqlGroup
    {
        public int QuestionIndex { get; set; }
        public string QuestionText { get; set; } = string.Empty;
        public DateTime? DateCreated { get; set; }
        public List<SqlLogItem> SqlQueries { get; set; } = new();
    }

    public class SqlLogItem
    {
        public int SubIndex { get; set; }
        public string Description { get; set; } = string.Empty;
        public string Sql { get; set; } = string.Empty;
        public bool IsSucceeded { get; set; }
        public string? ErrorMessage { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            chat = await AuditService.GetChatByIdAsync(ChatId);
            messagesList = await AuditService.GetMessagesForChatAsync(ChatId);
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error loading chat detail: " + ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SetActiveTab(string tabName)
    {
        activeTab = tabName;
    }

    private void OpenComplianceModal(MikroComplianceReport report, string sql)
    {
        selectedComplianceReport = report;
        selectedTestedSql = sql;
        isComplianceModalOpen = true;
    }

    private string GetScoreColor(int score)
    {
        if (score >= 90) return "#10b981"; // Green
        if (score >= 75) return "#3b82f6"; // Blue
        if (score >= 60) return "#f59e0b"; // Yellow/Amber
        return "#ef4444"; // Red
    }

    private List<QuestionSqlGroup> GetQuestionSqlGroups()
    {
        var groups = new List<QuestionSqlGroup>();
        if (messagesList == null) return groups;

        QuestionSqlGroup? currentGroup = null;
        int questionCounter = 0;

        foreach (var msg in messagesList)
        {
            var promptText = !string.IsNullOrEmpty(msg.Prompt) ? msg.Prompt : (msg.Role?.ToLower() == "user" ? msg.Message : null);

            if (!string.IsNullOrEmpty(promptText))
            {
                questionCounter++;
                currentGroup = new QuestionSqlGroup
                {
                    QuestionIndex = questionCounter,
                    QuestionText = promptText,
                    DateCreated = msg.DateCreated,
                    SqlQueries = new List<SqlLogItem>()
                };
                groups.Add(currentGroup);
            }

            if (!string.IsNullOrWhiteSpace(msg.Query))
            {
                if (currentGroup == null)
                {
                    questionCounter++;
                    currentGroup = new QuestionSqlGroup
                    {
                        QuestionIndex = questionCounter,
                        QuestionText = chat?.Title ?? "Sohbet Sorusu",
                        DateCreated = msg.DateCreated,
                        SqlQueries = new List<SqlLogItem>()
                    };
                    groups.Add(currentGroup);
                }

                var extractedSqls = ExtractSqlItemsFromQuery(msg.Query, msg.IsSucceeded, msg.ErrorMessage);
                foreach (var sqlItem in extractedSqls)
                {
                    sqlItem.SubIndex = currentGroup.SqlQueries.Count + 1;
                    currentGroup.SqlQueries.Add(sqlItem);
                }
            }
        }

        var groupsWithSql = groups.Where(g => g.SqlQueries.Count > 0).ToList();
        return groupsWithSql.Count > 0 ? groupsWithSql : groups;
    }

    private List<SqlLogItem> ExtractSqlItemsFromQuery(string rawQuery, bool isSucceeded, string? errorMessage)
    {
        var result = new List<SqlLogItem>();
        if (string.IsNullOrWhiteSpace(rawQuery)) return result;

        var trimmed = rawQuery.Trim();
        bool actualSuccess = string.IsNullOrEmpty(errorMessage);

        if ((trimmed.StartsWith("[") && trimmed.EndsWith("]")) || (trimmed.StartsWith("{") && trimmed.EndsWith("}")))
        {
            try
            {
                using var doc = System.Text.Json.JsonDocument.Parse(trimmed);
                var root = doc.RootElement;

                if (root.ValueKind == System.Text.Json.JsonValueKind.Array)
                {
                    foreach (var element in root.EnumerateArray())
                    {
                        var item = ExtractFromElement(element, actualSuccess, errorMessage);
                        if (item != null) result.Add(item);
                    }
                }
                else if (root.ValueKind == System.Text.Json.JsonValueKind.Object)
                {
                    var item = ExtractFromElement(root, actualSuccess, errorMessage);
                    if (item != null) result.Add(item);
                }
            }
            catch
            {
                // Fallback
            }
        }

        if (result.Count == 0)
        {
            result.Add(new SqlLogItem
            {
                Description = string.Empty,
                Sql = trimmed,
                IsSucceeded = actualSuccess,
                ErrorMessage = errorMessage
            });
        }

        return result;
    }

    private SqlLogItem? ExtractFromElement(System.Text.Json.JsonElement elem, bool isSucceeded, string? errorMessage)
    {
        string desc = string.Empty;
        string sql = string.Empty;

        if (TryGetJsonProp(elem, "description", out var val) ||
            TryGetJsonProp(elem, "Description", out val) ||
            TryGetJsonProp(elem, "summary", out val) ||
            TryGetJsonProp(elem, "title", out val))
        {
            desc = val;
        }

        if (TryGetJsonProp(elem, "sql", out var sqlVal) ||
            TryGetJsonProp(elem, "Sql", out sqlVal) ||
            TryGetJsonProp(elem, "query", out sqlVal) ||
            TryGetJsonProp(elem, "Query", out sqlVal) ||
            TryGetJsonProp(elem, "tSql", out sqlVal))
        {
            sql = sqlVal;
        }

        if (string.IsNullOrWhiteSpace(sql))
        {
            if (elem.ValueKind == System.Text.Json.JsonValueKind.String)
                sql = elem.GetString() ?? string.Empty;
            else
                sql = elem.GetRawText();
        }

        if (string.IsNullOrWhiteSpace(sql)) return null;

        return new SqlLogItem
        {
            Description = desc,
            Sql = sql,
            IsSucceeded = isSucceeded,
            ErrorMessage = errorMessage
        };
    }

    private bool TryGetJsonProp(System.Text.Json.JsonElement elem, string propName, out string value)
    {
        value = string.Empty;
        if (elem.ValueKind == System.Text.Json.JsonValueKind.Object && elem.TryGetProperty(propName, out var prop))
        {
            if (prop.ValueKind == System.Text.Json.JsonValueKind.String)
            {
                value = prop.GetString() ?? string.Empty;
                return !string.IsNullOrWhiteSpace(value);
            }
        }
        return false;
    }

    private async Task CopySql(string text)
    {
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
    }
}
