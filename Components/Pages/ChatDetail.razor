@page "/chat/{ChatId}"
@page "/chats/{ChatId}"
@inject IOzBiAuditService AuditService
@inject IMikroAuditEngine MikroAuditEngine
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@using OzBiPortalCRM.Services
@using OzBiPortalCRM.Models
@using OzBiPortalCRM.Components.Shared

<div class="mb-4">
    @if (chat != null)
    {
        <a href="tenant/@chat.TenantId/chats" class="btn btn-outline-secondary btn-sm mb-3">
            <i class="bi bi-arrow-left"></i> Chat Listesine Dön
        </a>

        <div class="glass-card mb-4">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge-status badge-info"><i class="bi bi-building"></i> @(chat.Tenant?.Name ?? "Tenant")</span>
                        <span class="badge-status badge-purple"><i class="bi bi-chat-dots"></i> Chat Denetim Kaydı</span>
                    </div>
                    <h3 class="fw-bold mb-1">@(string.IsNullOrWhiteSpace(chat.Title) ? "Başlıksız Sohbet" : chat.Title)</h3>
                    <div class="text-muted small d-flex align-items-center gap-3 flex-wrap">
                        <span><i class="bi bi-person"></i> Oluşturan: @(chat.CreatedByUser?.NameSurname ?? chat.CreatedByUser?.Email ?? "Sistem/Kullanıcı")</span>
                        <span><i class="bi bi-calendar3"></i> Tarih: @(chat.DateCreated?.ToString("dd.MM.yyyy HH:mm:ss") ?? "-")</span>
                        <span style="font-family: monospace;">Chat ID: @chat.Id</span>
                    </div>
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    <div class="text-center p-2 rounded bg-black bg-opacity-30 border border-secondary border-opacity-25 px-3">
                        <div class="fs-5 fw-bold text-info">@UserPromptCount</div>
                        <div class="text-muted small">Kullanıcı Sorusu</div>
                    </div>
                    <div class="text-center p-2 rounded bg-black bg-opacity-30 border border-secondary border-opacity-25 px-3">
                        <div class="fs-5 fw-bold text-primary">@AiResponseCount</div>
                        <div class="text-muted small">AI Log Kaydı</div>
                    </div>
                    <div class="text-center p-2 rounded bg-black bg-opacity-30 border border-info border-opacity-30 px-3" style="background: rgba(14, 165, 233, 0.08);">
                        <div class="fs-5 fw-bold" style="color: #38bdf8;">@QueryModeCount</div>
                        <div class="text-muted small">Sorgu Modu</div>
                    </div>
                    <div class="text-center p-2 rounded bg-black bg-opacity-30 border border-purple border-opacity-30 px-3" style="background: rgba(168, 85, 247, 0.08);">
                        <div class="fs-5 fw-bold" style="color: #c084fc;">@AssistantModeCount</div>
                        <div class="text-muted small">Agent Modu</div>
                    </div>
                    <div class="text-center p-2 rounded bg-black bg-opacity-30 border border-secondary border-opacity-25 px-3">
                        <div class="fs-5 fw-bold text-success">@TotalSqlCount</div>
                        <div class="text-muted small">Üretilen SQL</div>
                    </div>
                    @if (DislikedCount > 0)
                    {
                        <div class="text-center p-2 rounded bg-black bg-opacity-30 border border-danger border-opacity-30 px-3" style="background: rgba(239, 68, 68, 0.08);">
                            <div class="fs-5 fw-bold text-danger"><i class="bi bi-hand-thumbs-down-fill me-1"></i>@DislikedCount</div>
                            <div class="text-muted small">Beğenilmeyen</div>
                        </div>
                    }
                    @if (LikedCount > 0)
                    {
                        <div class="text-center p-2 rounded bg-black bg-opacity-30 border border-success border-opacity-30 px-3" style="background: rgba(16, 185, 129, 0.08);">
                            <div class="fs-5 fw-bold text-success"><i class="bi bi-hand-thumbs-up-fill me-1"></i>@LikedCount</div>
                            <div class="text-muted small">Beğenilen</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@if (isLoading)
{
    <div class="glass-card text-center py-5">
        <div class="spinner-border text-primary mb-3" role="status"></div>
        <div class="text-muted">Chat veritabanı logları yükleniyor...</div>
    </div>
}
else if (messagesList == null || messagesList.Count == 0)
{
    <div class="glass-card text-center py-5">
        <i class="bi bi-chat-square-x text-muted" style="font-size: 3rem;"></i>
        <h5 class="mt-3 text-muted">Bu sohbete ait veritabanı logu bulunamadı</h5>
    </div>
}
else
{
    <!-- Tab Switcher Header (Agent Modu | Sorgu Modu) -->
    <div class="tab-container mb-4">
        <button class="btn-tab @(activeTab == "veri" ? "active" : "")" @onclick='() => SetActiveTab("veri")'>
            <i class="bi bi-robot me-1.5" style="color: #c084fc;"></i> Agent Modu (@GetConversationTurns().Count)
        </button>
        <button class="btn-tab @(activeTab == "sorgu" ? "active" : "")" @onclick='() => SetActiveTab("sorgu")'>
            <i class="bi bi-terminal-fill me-1.5" style="color: #38bdf8;"></i> Sorgu Modu (@TotalSqlCount)
        </button>
    </div>

    @if (activeTab == "veri")
    {
        <!-- VERİ / AKIŞ TAB: Unified Question & AI Response Turn Cards -->
        var turns = GetConversationTurns();

        if (turns.Count == 0)
        {
            <div class="glass-card text-center py-5">
                <i class="bi bi-chat-square-dots text-muted" style="font-size: 3rem;"></i>
                <h5 class="mt-3 text-muted">Bu sohbete ait soru & yanıt kaydı bulunamadı</h5>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-4">
                @foreach (var turn in turns)
                {
                    var isTurnDisliked = turn.IsLiked == false;
                    var isTurnLiked = turn.IsLiked == true;
                    var hasTurnComment = !string.IsNullOrWhiteSpace(turn.FeedbackReason);
                    var turnCardClass = isTurnDisliked ? "turn-card-disliked" : (isTurnLiked ? "turn-card-liked" : (hasTurnComment ? "turn-card-comment" : "turn-card-default"));

                    <div class="turn-card @turnCardClass mb-3">
                        <!-- Top Header Bar -->
                        <div class="turn-card-header">
                            <div class="d-flex align-items-center gap-3 flex-wrap">
                                <!-- Turn Index -->
                                <span class="turn-index-badge">
                                    #@turn.TurnIndex Soru & Yanıt
                                </span>

                                <!-- Mode Badge -->
                                @if (turn.IsAsistantMode)
                                {
                                    <span class="turn-mode-badge agent" title="Agent Modu: Doğal dil ile açıklama ve yanıt metni üretilir">
                                        <i class="bi bi-robot me-1"></i> Agent Modu
                                    </span>
                                }
                                else
                                {
                                    <span class="turn-mode-badge query" title="Sorgu Modu (SQL Raporu): Doğrudan veritabanı sorgusu ve dinamik tablo üretilir">
                                        <i class="bi bi-table me-1"></i> Sorgu Modu
                                    </span>
                                }

                                <!-- Feedback Reaction Badge (If any) -->
                                @if (isTurnDisliked)
                                {
                                    <span class="status-pill status-pill-disliked">
                                        <i class="bi bi-hand-thumbs-down-fill me-1"></i> Beğenilmedi
                                    </span>
                                }
                                else if (isTurnLiked)
                                {
                                    <span class="status-pill status-pill-liked">
                                        <i class="bi bi-hand-thumbs-up-fill me-1"></i> Beğenildi
                                    </span>
                                }
                                else if (hasTurnComment)
                                {
                                    <span class="status-pill status-pill-comment">
                                        <i class="bi bi-chat-square-text-fill me-1"></i> Yorum Girildi
                                    </span>
                                }

                                <!-- Metadata Group -->
                                <div class="meta-tags-container">
                                    <span class="meta-tag" title="Kullanıcı">
                                        <i class="bi bi-person text-secondary opacity-75"></i>
                                        <span>@turn.UserName</span>
                                    </span>
                                    @if (!string.IsNullOrEmpty(turn.AiModelName) || !string.IsNullOrEmpty(turn.AssistantName))
                                    {
                                        <span class="meta-divider">•</span>
                                        <span class="meta-tag" title="Model & Asistan">
                                            <i class="bi bi-cpu text-primary opacity-75"></i>
                                            <span>@(turn.AiModelName ?? "AI") @(!string.IsNullOrEmpty(turn.AssistantName) ? $"· {turn.AssistantName}" : "")</span>
                                        </span>
                                    }
                                </div>
                            </div>

                            <!-- Right Side: Duration & Timestamp (Spacious layout) -->
                            <div class="d-flex align-items-center gap-3 flex-wrap ms-auto">
                                @if (turn.TotalDurationMs.HasValue && turn.TotalDurationMs > 0)
                                {
                                    <span class="duration-pill"><i class="bi bi-stopwatch me-1 opacity-75"></i>@(turn.TotalDurationMs)ms</span>
                                }
                                <span class="date-chip">
                                    <i class="bi bi-clock me-1 opacity-75"></i>@((turn.ResponseDate ?? turn.QuestionDate)?.ToString("dd.MM.yyyy HH:mm:ss") ?? "-")
                                </span>
                            </div>
                        </div>

                        <!-- Customer Voice / Feedback Callout (If customer wrote a comment) -->
                        @if (hasTurnComment)
                        {
                            <div class="customer-quote-box">
                                <div class="quote-header">
                                    <i class="bi bi-chat-quote-fill quote-icon"></i>
                                    <span class="quote-title">MÜŞTERİ GERİ BİLDİRİMİ / ELEŞTİRİSİ</span>
                                </div>
                                <div class="quote-body">
                                    “@turn.FeedbackReason”
                                </div>
                            </div>
                        }

                        <!-- 1. KULLANICI SORUSU (Prompt) -->
                        <div class="prompt-flow-block">
                            <div class="prompt-flow-header">
                                <span class="prompt-icon-badge"><i class="bi bi-question-lg"></i></span>
                                <div class="prompt-flow-content">
                                    <span class="prompt-flow-label">Kullanıcı Sorusu:</span>
                                    <span class="prompt-flow-text">@turn.UserQuestion</span>
                                </div>
                            </div>
                        </div>

                        <!-- 2. AI YANITI & ÇIKTISI (In the same card) -->
                        <div class="turn-ai-response-container">
                            <div class="turn-ai-header mb-2.5">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-stars text-primary fs-5"></i>
                                    <span class="turn-ai-title">AI YANITI & ÇIKTISI</span>
                                </div>
                                @if (turn.SqlQueries.Count > 0)
                                {
                                    <span class="badge-status" style="background: rgba(16, 185, 129, 0.12); border: 1px solid rgba(52, 211, 153, 0.3); color: #34d399; font-size: 0.725rem;">
                                        <i class="bi bi-database-check me-1"></i> @turn.SqlQueries.Count SQL Sorgusu Üretildi
                                    </span>
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(turn.AiMessage))
                            {
                                <div class="ai-markdown-view mb-3">
                                    @turn.AiMessage
                                </div>
                            }
                            else if (!string.IsNullOrWhiteSpace(turn.AiSummary))
                            {
                                <div class="ai-markdown-view mb-3">
                                    @turn.AiSummary
                                </div>
                            }

                            <!-- Generated SQL Queries for this Turn -->
                            @if (turn.SqlQueries.Count > 0)
                            {
                                <div class="sql-flow-container">
                                    @foreach (var sqlItem in turn.SqlQueries)
                                    {
                                        var compliance = MikroAuditEngine.EvaluateQuery(sqlItem.Sql, turn.UserQuestion, chat?.Tenant?.Name);
                                        var erpLabel = compliance is ErpComplianceReport erpRep ? erpRep.SystemTypeName : "Mikro v27";

                                        <div class="sql-flow-card">
                                            <div class="sql-flow-topbar">
                                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                                    <span class="terminal-dots">
                                                        <span class="dot red"></span>
                                                        <span class="dot yellow"></span>
                                                        <span class="dot green"></span>
                                                    </span>
                                                    <span class="sql-tag-title"><i class="bi bi-terminal-fill me-1 text-info opacity-75"></i>SQL Sorgusu</span>

                                                    @if (compliance.IsMikroQuery)
                                                    {
                                                        <button type="button" class="compliance-chip" @onclick="() => OpenComplianceModal(compliance, sqlItem.Sql)" title="Detaylı ERP Uyum Raporunu İncele">
                                                            <span class="compliance-dot" style="background-color: @GetScoreColor(compliance.Score);"></span>
                                                            <span>@erpLabel Uyum: <strong>@compliance.Score/100</strong> (@compliance.Grade)</span>
                                                            <i class="bi bi-chevron-right ms-1 opacity-50" style="font-size: 0.65rem;"></i>
                                                        </button>
                                                    }

                                                    @if (!string.IsNullOrEmpty(sqlItem.ErrorMessage) || !string.IsNullOrEmpty(turn.ErrorMessage))
                                                    {
                                                        <span class="sql-status-badge error">
                                                            <i class="bi bi-exclamation-triangle-fill me-1"></i> SQL Hatası
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="sql-status-badge success">
                                                            <i class="bi bi-check2 me-1"></i> SQL Çalıştırıldı
                                                        </span>
                                                    }
                                                </div>

                                                <button class="btn-copy-sql" @onclick="() => CopySql(sqlItem.Sql)" title="SQL Panoya Kopyala">
                                                    <i class="bi bi-clipboard me-1"></i> Kopyala
                                                </button>
                                            </div>

                                            @if (!string.IsNullOrEmpty(sqlItem.Description))
                                            {
                                                <div class="sql-desc-text">@sqlItem.Description</div>
                                            }

                                            <div class="sql-code-wrapper">
                                                <code>@sqlItem.Sql</code>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else if (string.IsNullOrWhiteSpace(turn.AiMessage) && string.IsNullOrWhiteSpace(turn.AiSummary))
                            {
                                <div class="p-3 rounded-3" style="background: rgba(14, 165, 233, 0.06); border: 1px solid rgba(56, 189, 248, 0.2);">
                                    <div class="text-info small fw-semibold">
                                        <i class="bi bi-info-circle me-1"></i> Bu soru için doğrudan dinamik tablo raporu üretilmiş ve kullanıcı ekranında gösterilmiştir.
                                    </div>
                                </div>
                            }

                            <!-- Error Box (If any) -->
                            @if (!string.IsNullOrEmpty(turn.ErrorMessage))
                            {
                                <div class="error-alert-box mt-2.5">
                                    <div class="d-flex align-items-start gap-2.5">
                                        <i class="bi bi-exclamation-octagon-fill text-danger fs-5 mt-0.5 flex-shrink-0"></i>
                                        <div>
                                            <div class="fw-bold text-danger small text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">Hata Detayı</div>
                                            <div class="font-monospace text-light small mt-1" style="white-space: pre-wrap; font-size: 0.825rem; line-height: 1.5;">@turn.ErrorMessage</div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }
    else if (activeTab == "sorgu")
    {
        <!-- SORGU MODU TAB: Dedicated SQL Audit View with Identical Executive UI/UX -->
        var questionGroups = GetQuestionSqlGroups();

        if (questionGroups.Count == 0)
        {
            <div class="glass-card text-center py-5">
                <i class="bi bi-terminal-x text-muted" style="font-size: 3rem;"></i>
                <h5 class="mt-3 text-muted">Bu sohbete ait üretilmiş SQL sorgusu bulunamadı</h5>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-4">
                @foreach (var qGroup in questionGroups)
                {
                    var isGroupDisliked = qGroup.IsLiked == false;
                    var isGroupLiked = qGroup.IsLiked == true;
                    var hasGroupComment = !string.IsNullOrWhiteSpace(qGroup.FeedbackReason);
                    var turnCardClass = isGroupDisliked ? "turn-card-disliked" : (isGroupLiked ? "turn-card-liked" : (hasGroupComment ? "turn-card-comment" : "turn-card-default"));

                    <div class="turn-card @turnCardClass mb-3">
                        <!-- Top Header Bar -->
                        <div class="turn-card-header">
                            <div class="d-flex align-items-center gap-3 flex-wrap">
                                <!-- Question Index -->
                                <span class="turn-index-badge">
                                    #@qGroup.QuestionIndex Soru & SQL
                                </span>

                                <!-- Mode Badge -->
                                @if (qGroup.IsAsistantMode)
                                {
                                    <span class="turn-mode-badge agent" title="Agent Modu: Doğal dil ile açıklama ve yanıt metni üretilir">
                                        <i class="bi bi-robot me-1"></i> Agent Modu
                                    </span>
                                }
                                else
                                {
                                    <span class="turn-mode-badge query" title="Sorgu Modu (SQL Raporu): Doğrudan veritabanı sorgusu ve dinamik tablo üretilir">
                                        <i class="bi bi-table me-1"></i> Sorgu Modu
                                    </span>
                                }

                                <!-- Feedback Reaction Badge (If any) -->
                                @if (isGroupDisliked)
                                {
                                    <span class="status-pill status-pill-disliked">
                                        <i class="bi bi-hand-thumbs-down-fill me-1"></i> Beğenilmedi
                                    </span>
                                }
                                else if (isGroupLiked)
                                {
                                    <span class="status-pill status-pill-liked">
                                        <i class="bi bi-hand-thumbs-up-fill me-1"></i> Beğenildi
                                    </span>
                                }
                                else if (hasGroupComment)
                                {
                                    <span class="status-pill status-pill-comment">
                                        <i class="bi bi-chat-square-text-fill me-1"></i> Yorum Girildi
                                    </span>
                                }

                                <!-- Metadata Group -->
                                <div class="meta-tags-container">
                                    <span class="meta-tag" title="Kullanıcı">
                                        <i class="bi bi-person text-secondary opacity-75"></i>
                                        <span>@(chat?.CreatedByUser?.NameSurname ?? chat?.CreatedByUser?.Email ?? "Kullanıcı")</span>
                                    </span>
                                    @if (!string.IsNullOrEmpty(qGroup.AiModelName) || !string.IsNullOrEmpty(qGroup.AssistantName))
                                    {
                                        <span class="meta-divider">•</span>
                                        <span class="meta-tag" title="Model & Asistan">
                                            <i class="bi bi-cpu text-primary opacity-75"></i>
                                            <span>@(qGroup.AiModelName ?? "AI") @(!string.IsNullOrEmpty(qGroup.AssistantName) ? $"· {qGroup.AssistantName}" : "")</span>
                                        </span>
                                    }
                                </div>
                            </div>

                            <!-- Right Side: Date & Sql Count -->
                            <div class="d-flex align-items-center gap-3 flex-wrap ms-auto">
                                <span class="badge-status" style="background: rgba(56, 189, 248, 0.12); border: 1px solid rgba(56, 189, 248, 0.3); color: #38bdf8; font-size: 0.775rem; font-weight: 700;">
                                    <i class="bi bi-database-check me-1"></i> @qGroup.SqlQueries.Count SQL Sorgusu
                                </span>
                                <span class="date-chip">
                                    <i class="bi bi-clock me-1 opacity-75"></i>@(qGroup.DateCreated?.ToString("dd.MM.yyyy HH:mm:ss") ?? "-")
                                </span>
                            </div>
                        </div>

                        <!-- Customer Voice / Feedback Callout (If customer wrote a comment) -->
                        @if (hasGroupComment)
                        {
                            <div class="customer-quote-box">
                                <div class="quote-header">
                                    <i class="bi bi-chat-quote-fill quote-icon"></i>
                                    <span class="quote-title">MÜŞTERİ GERİ BİLDİRİMİ / ELEŞTİRİSİ</span>
                                </div>
                                <div class="quote-body">
                                    “@qGroup.FeedbackReason”
                                </div>
                            </div>
                        }

                        <!-- 1. KULLANICI SORUSU (Prompt Flow Block) -->
                        <div class="prompt-flow-block">
                            <div class="prompt-flow-header">
                                <span class="prompt-icon-badge"><i class="bi bi-question-lg"></i></span>
                                <div class="prompt-flow-content">
                                    <span class="prompt-flow-label">Kullanıcı Sorusu:</span>
                                    <span class="prompt-flow-text">@qGroup.QuestionText</span>
                                </div>
                            </div>
                        </div>

                        <!-- 2. ÜRETİLEN SQL SORGULARI & ERP DENETİMİ -->
                        <div class="turn-ai-response-container">
                            <div class="turn-ai-header mb-2.5">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-terminal-fill text-info fs-5"></i>
                                    <span class="turn-ai-title" style="color: #38bdf8;">ÜRETİLEN SQL SORGULARI & ERP DENETİMİ</span>
                                </div>
                                <span class="badge-status" style="background: rgba(16, 185, 129, 0.12); border: 1px solid rgba(52, 211, 153, 0.3); color: #34d399; font-size: 0.725rem;">
                                    <i class="bi bi-shield-check me-1"></i> @qGroup.SqlQueries.Count Sorgu Doğrulandı
                                </span>
                            </div>

                            <div class="sql-flow-container">
                                @foreach (var sqlItem in qGroup.SqlQueries)
                                {
                                    var compliance = MikroAuditEngine.EvaluateQuery(sqlItem.Sql, qGroup.QuestionText, chat?.Tenant?.Name);
                                    var erpLabel = compliance is ErpComplianceReport erpRep ? erpRep.SystemTypeName : "Mikro v27";

                                    <div class="sql-flow-card">
                                        <div class="sql-flow-topbar">
                                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                                <span class="terminal-dots">
                                                    <span class="dot red"></span>
                                                    <span class="dot yellow"></span>
                                                    <span class="dot green"></span>
                                                </span>
                                                <span class="sql-tag-title">
                                                    <i class="bi bi-terminal-fill me-1 text-info opacity-75"></i>Sorgu #@qGroup.QuestionIndex.@sqlItem.SubIndex
                                                </span>

                                                @if (compliance.IsMikroQuery)
                                                {
                                                    <button type="button" class="compliance-chip" @onclick="() => OpenComplianceModal(compliance, sqlItem.Sql)" title="Detaylı ERP Uyum Raporunu İncele">
                                                        <span class="compliance-dot" style="background-color: @GetScoreColor(compliance.Score);"></span>
                                                        <span>@erpLabel Uyum: <strong>@compliance.Score/100</strong> (@compliance.Grade)</span>
                                                        <i class="bi bi-chevron-right ms-1 opacity-50" style="font-size: 0.65rem;"></i>
                                                    </button>
                                                }

                                                @if (!string.IsNullOrEmpty(sqlItem.ErrorMessage))
                                                {
                                                    <span class="sql-status-badge error">
                                                        <i class="bi bi-exclamation-triangle-fill me-1"></i> SQL Hatası
                                                    </span>
                                                }
                                                else if (sqlItem.IsSucceeded)
                                                {
                                                    <span class="sql-status-badge success">
                                                        <i class="bi bi-check2 me-1"></i> SQL Başarılı
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="sql-status-badge success">
                                                        <i class="bi bi-check2 me-1"></i> SQL Çalıştırıldı
                                                    </span>
                                                }
                                            </div>

                                            <button class="btn-copy-sql" @onclick="() => CopySql(sqlItem.Sql)" title="SQL Panoya Kopyala">
                                                <i class="bi bi-clipboard me-1"></i> Kopyala
                                            </button>
                                        </div>

                                        @if (!string.IsNullOrEmpty(sqlItem.Description))
                                        {
                                            <div class="sql-desc-text">@sqlItem.Description</div>
                                        }

                                        <div class="sql-code-wrapper">
                                            <code>@sqlItem.Sql</code>
                                        </div>

                                        @if (!string.IsNullOrEmpty(sqlItem.ErrorMessage))
                                        {
                                            <div class="error-alert-box mt-2.5">
                                                <div class="d-flex align-items-start gap-2.5">
                                                    <i class="bi bi-exclamation-octagon-fill text-danger fs-5 mt-0.5 flex-shrink-0"></i>
                                                    <div>
                                                        <div class="fw-bold text-danger small text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">Hata Detayı</div>
                                                        <div class="font-monospace text-light small mt-1" style="white-space: pre-wrap; font-size: 0.825rem; line-height: 1.5;">@sqlItem.ErrorMessage</div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
}

