@page "/queries"
@inject IOzBiAuditService AuditService
@inject IMikroAuditEngine MikroAuditEngine
@inject IJSRuntime JSRuntime
@using OzBiPortalCRM.Services
@using OzBiPortalCRM.Models
@using OzBiPortalCRM.Components.Shared

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-database-fill-gear text-info me-2"></i>Son İşlemler</h2>
        <div class="text-muted">Tüm tenant ve sohbetlerde çalıştırılan SQL sorgularını ve sorularını canlı akış halinde inceleyin</div>
    </div>
    <button class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1.5" @onclick="LoadData">
        <i class="bi bi-arrow-clockwise"></i> Yenile
    </button>
</div>

<!-- Search & Filters -->
<div class="glass-card mb-4 p-3.5">
    <div class="row g-3 align-items-center">
        <div class="col-12 col-md-7">
            <label class="form-label text-muted small mb-1">Soru, Tablo veya SQL İle Ara</label>
            <div class="input-group">
                <span class="input-group-text bg-dark border-secondary text-muted"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control input-custom" placeholder="Soru metni, tablo adı, SQL anahtar kelimesi..." @bind="searchQuery" @bind:event="oninput" @onkeyup="HandleSearch" />
            </div>
        </div>

        <div class="col-12 col-md-5 d-flex align-items-center justify-content-md-end gap-3 pt-md-3">
            <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" role="switch" id="failedOnlySwitch" @bind="failedOnly" @bind:after="LoadData">
                <label class="form-check-label text-danger small fw-semibold cursor-pointer" for="failedOnlySwitch">
                    Sadece Hatalı Sorgular
                </label>
            </div>
            <span class="badge-status" style="background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.15); color: #cbd5e1;">
                Bulunan: <strong>@(feedItems?.Count ?? 0)</strong>
            </span>
        </div>
    </div>
</div>

<!-- SQL Query Feed List -->
@if (isLoading)
{
    <div class="glass-card text-center py-5">
        <div class="spinner-border text-primary mb-3" role="status"></div>
        <div class="text-muted">Son soru ve SQL sorguları veritabanından taranıyor...</div>
    </div>
}
else if (feedItems == null || feedItems.Count == 0)
{
    <div class="glass-card text-center py-5">
        <i class="bi bi-database-x text-muted" style="font-size: 3rem;"></i>
        <h5 class="mt-3 text-muted">Arama kriterlerine uygun soru veya SQL sorgusu bulunamadı</h5>
    </div>
}
else
{
    <div class="d-flex flex-column gap-4">
        @foreach (var feedItem in feedItems)
        {
            var item = feedItem.MessageItem;
            var isFailed = !string.IsNullOrEmpty(item.ErrorMessage);
            var isDisliked = item.IsLiked == false;
            var isLiked = item.IsLiked == true;
            var hasComment = !string.IsNullOrWhiteSpace(item.FeedbackReason);
            var cardBorderClass = isFailed ? "query-card-error" : (isDisliked ? "query-card-disliked" : (isLiked ? "query-card-liked" : (hasComment ? "query-card-comment" : "query-card-default")));

            <div class="query-feed-card @cardBorderClass">
                <!-- Top Header Bar: Unified, sleek metadata & badges -->
                <div class="query-card-header">
                    <div class="header-left-group">
                        <!-- Mode Badge (Agent vs Query) -->
                        @if (item.IsAssistantModeEffective)
                        {
                            <span class="badge-mode badge-mode-agent" title="Agent Modu">
                                <i class="bi bi-robot me-1.5"></i>Agent Modu
                            </span>
                        }
                        else
                        {
                            <span class="badge-mode badge-mode-query" title="Sorgu Modu (SQL Raporu)">
                                <i class="bi bi-table me-1.5"></i>Sorgu Modu
                            </span>
                        }

                        <!-- SQL Execution Status & Count -->
                        @if (isFailed)
                        {
                            <span class="badge-pill badge-pill-error" title="Sorguda hata oluştu">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i>SQL Hatası
                            </span>
                        }
                        else if (feedItem.SqlQueries.Count > 0)
                        {
                            <span class="badge-pill badge-pill-sql" title="Asistan bu işlem için toplam @feedItem.SqlQueries.Count adet SQL sorgusu çalıştırdı">
                                <i class="bi bi-cpu-fill me-1.5"></i>@(feedItem.SqlQueries.Count) SQL Çalıştırıldı
                            </span>
                        }
                        else
                        {
                            <span class="badge-pill badge-pill-success" title="İşlem Başarılı">
                                <i class="bi bi-check2-circle me-1"></i>Başarılı
                            </span>
                        }

                        <!-- Reaction Pill (If any) -->
                        @if (isDisliked)
                        {
                            <span class="badge-pill badge-pill-disliked">
                                <i class="bi bi-hand-thumbs-down-fill me-1"></i>Beğenilmedi
                            </span>
                        }
                        else if (isLiked)
                        {
                            <span class="badge-pill badge-pill-liked">
                                <i class="bi bi-hand-thumbs-up-fill me-1"></i>Beğenildi
                            </span>
                        }

                        <!-- Structured Metadata Strip (Tenant, User, AI Model) -->
                        <div class="meta-strip">
                            <span class="meta-chip" title="Firma / Tenant">
                                <i class="bi bi-building text-info"></i>
                                <span class="meta-text-highlight">@(item.Chat?.Tenant?.Name ?? "Tenant")</span>
                            </span>
                            <span class="meta-separator">•</span>
                            <span class="meta-chip" title="Kullanıcı">
                                <i class="bi bi-person text-secondary"></i>
                                <span>@(item.Chat?.CreatedByUser?.NameSurname ?? item.Chat?.CreatedByUser?.Email ?? "Kullanıcı")</span>
                            </span>
                            @if (item.AIModel != null || item.Assistant != null)
                            {
                                <span class="meta-separator">•</span>
                                <span class="meta-chip" title="AI Modeli ve Asistan">
                                    <i class="bi bi-cpu text-primary"></i>
                                    <span>@(item.AIModel?.Name ?? item.AIModel?.ProgrammaticName ?? "AI")@(item.Assistant != null ? $" · {item.Assistant.Name}" : "")</span>
                                </span>
                            }
                        </div>
                    </div>

                    <!-- Right Side: Duration, Date & Sohbete Git Button -->
                    <div class="header-right-group">
                        @if (item.TotalDurationMs.HasValue && item.TotalDurationMs > 0)
                        {
                            <span class="duration-chip" title="Toplam Süre">
                                <i class="bi bi-stopwatch opacity-75"></i>
                                <span>@FormatDuration(item.TotalDurationMs.Value)</span>
                            </span>
                        }
                        <span class="date-chip" title="İşlem Tarihi">
                            <i class="bi bi-clock opacity-75"></i>
                            <span>@(item.DateCreated?.ToString("dd.MM.yyyy HH:mm:ss") ?? "-")</span>
                        </span>
                        <a href="chat/@item.ChatId" class="btn-goto-chat" title="Bu sohbetin tüm akışını ve geçmişini aç">
                            <span>Sohbete Git</span>
                            <i class="bi bi-arrow-up-right"></i>
                        </a>
                    </div>
                </div>

                <!-- Customer Voice / Feedback Callout (If user wrote feedback reason on this message) -->
                @if (hasComment)
                {
                    <div class="customer-quote-box">
                        <div class="quote-header">
                            <i class="bi bi-chat-quote-fill quote-icon"></i>
                            <span class="quote-title">MÜŞTERİ GERİ BİLDİRİMİ / ELEŞTİRİSİ</span>
                        </div>
                        <div class="quote-body">
                            “@item.FeedbackReason”
                        </div>
                    </div>
                }

                <!-- User Question / Prompt Flow Block -->
                <div class="prompt-flow-block">
                    <div class="prompt-flow-header">
                        <span class="prompt-icon-badge"><i class="bi bi-question-lg"></i></span>
                        <div class="prompt-flow-content">
                            <span class="prompt-flow-label">Kullanıcı Sorusu:</span>
                            <span class="prompt-flow-text">@feedItem.QuestionText</span>
                        </div>
                    </div>
                </div>

                <!-- All Executed SQL Queries Rendered Sequentially (No internal vertical scroll) -->
                <div class="d-flex flex-column gap-3">
                    @for (int i = 0; i < feedItem.SqlQueries.Count; i++)
                    {
                        var sqlIndex = i + 1;
                        var sqlItem = feedItem.SqlQueries[i];
                        var compliance = sqlItem.Compliance;
                        var erpLabel = compliance is ErpComplianceReport erpRep ? erpRep.SystemTypeName : (compliance.IsMikroQuery ? "Mikro ERP (v27.1)" : "Logo ERP (v8.0)");

                        <div class="sql-flow-card">
                            <div class="sql-flow-topbar">
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <span class="terminal-dots">
                                        <span class="dot red"></span>
                                        <span class="dot yellow"></span>
                                        <span class="dot green"></span>
                                    </span>
                                    <span class="sql-tag-title">
                                        <i class="bi bi-terminal-fill me-1 text-info opacity-75"></i>
                                        @(feedItem.SqlQueries.Count > 1 ? $"SQL Sorgusu #{sqlIndex}" : "SQL Sorgusu")
                                    </span>

                                    <!-- Multi-ERP Compliance Score Badge -->
                                    @if (compliance.IsMikroQuery)
                                    {
                                        <button type="button" class="compliance-chip" @onclick="() => OpenComplianceModal(compliance, sqlItem.Sql)" title="Detaylı ERP Uyum Raporunu İncele">
                                            <span class="compliance-dot" style="background-color: @GetScoreColor(compliance.Score);"></span>
                                            <span>@erpLabel Uyum: <strong>@compliance.Score/100</strong> (@compliance.Grade)</span>
                                            @if (compliance.Violations.Count > 0)
                                            {
                                                <span class="badge bg-danger bg-opacity-25 text-danger ms-1" style="font-size: 0.68rem; font-weight: 700;">
                                                    @compliance.Violations.Count İhlal
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success bg-opacity-25 text-success ms-1" style="font-size: 0.68rem; font-weight: 700;">
                                                    Tam Uyum
                                                </span>
                                            }
                                            <i class="bi bi-chevron-right ms-1 opacity-50" style="font-size: 0.65rem;"></i>
                                        </button>
                                    }
                                </div>

                                <button class="btn-copy-sql" @onclick="() => CopySql(sqlItem.Sql)" title="SQL Panoya Kopyala">
                                    <i class="bi bi-clipboard me-1"></i> Kopyala
                                </button>
                            </div>

                            @if (!string.IsNullOrEmpty(sqlItem.Description))
                            {
                                <div class="sql-desc-text">@sqlItem.Description</div>
                            }

                            <!-- Full Code View without Clipping / Scrollbar -->
                            <div class="sql-code-wrapper">
                                <code>@sqlItem.Sql</code>
                            </div>
                        </div>
                    }
                </div>

                <!-- Error Message if present -->
                @if (!string.IsNullOrEmpty(item.ErrorMessage))
                {
                    <div class="error-alert-box mt-3">
                        <div class="d-flex align-items-start gap-2.5">
                            <i class="bi bi-exclamation-octagon-fill text-danger fs-5 mt-0.5 flex-shrink-0"></i>
                            <div>
                                <div class="fw-bold text-danger small text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">Hata Detayı</div>
                                <div class="font-monospace text-light small mt-1" style="white-space: pre-wrap; font-size: 0.825rem; line-height: 1.5;">@item.ErrorMessage</div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
}

<!-- ERP Compliance Modal -->
<ErpComplianceModal @bind-IsOpen="isComplianceModalOpen" Report="@selectedComplianceReport" TestedSql="@selectedTestedSql" />

@code {
    private List<OzBiChatMessage>? rawQueriesList;
    private List<QueryFeedCardItem>? feedItems;
    private string searchQuery = string.Empty;
    private bool failedOnly = false;
    private bool isLoading = true;

    private bool isComplianceModalOpen = false;
    private MikroComplianceReport? selectedComplianceReport;
    private string selectedTestedSql = string.Empty;

    public class FeedSqlItem
    {
        public string Description { get; set; } = string.Empty;
        public string Sql { get; set; } = string.Empty;
    }

    public class FeedSqlItemWithCompliance
    {
        public string Sql { get; set; } = string.Empty;
        public string? Description { get; set; }
        public MikroComplianceReport Compliance { get; set; } = default!;
    }

    public class QueryFeedCardItem
    {
        public OzBiChatMessage MessageItem { get; set; } = default!;
        public string QuestionText { get; set; } = string.Empty;
        public List<FeedSqlItemWithCompliance> SqlQueries { get; set; } = new();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            rawQueriesList = await AuditService.SearchGlobalQueriesAsync(
                tenantId: null,
                querySearch: searchQuery,
                failedOnly: failedOnly,
                minDurationMs: null);

            BuildFeedItems();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error loading global queries: " + ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void BuildFeedItems()
    {
        feedItems = new List<QueryFeedCardItem>();
        if (rawQueriesList == null) return;

        foreach (var item in rawQueriesList)
        {
            var sqlItems = ExtractSqlItemsFromQuery(item.Query);
            if (sqlItems.Count == 0 && !string.IsNullOrWhiteSpace(item.Query))
            {
                sqlItems.Add(new FeedSqlItem { Sql = item.Query.Trim() });
            }

            // Determine question text
            string qText;
            if (!string.IsNullOrWhiteSpace(item.Prompt))
            {
                qText = item.Prompt.Trim();
            }
            else if (sqlItems.Count > 0 && !string.IsNullOrWhiteSpace(sqlItems[0].Description))
            {
                qText = sqlItems[0].Description.Trim();
            }
            else if (!string.IsNullOrWhiteSpace(item.Chat?.Title))
            {
                qText = item.Chat.Title.Trim();
            }
            else
            {
                qText = "Sohbet Sorgusu";
            }

            // Filter by searchQuery if present
            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                var term = searchQuery.Trim().ToLower();
                bool matchesQuery = sqlItems.Any(s => s.Sql.ToLower().Contains(term) || (!string.IsNullOrEmpty(s.Description) && s.Description.ToLower().Contains(term)));
                bool matchesQText = qText.ToLower().Contains(term);
                bool matchesPrompt = item.Prompt?.ToLower().Contains(term) ?? false;
                bool matchesChatTitle = item.Chat?.Title?.ToLower().Contains(term) ?? false;

                if (!matchesQuery && !matchesQText && !matchesPrompt && !matchesChatTitle)
                {
                    continue;
                }
            }

            var sqlWithCompliance = new List<FeedSqlItemWithCompliance>();
            foreach (var s in sqlItems)
            {
                var compliance = MikroAuditEngine.EvaluateQuery(s.Sql, qText, item.Chat?.Tenant?.Name);
                sqlWithCompliance.Add(new FeedSqlItemWithCompliance
                {
                    Sql = s.Sql,
                    Description = s.Description,
                    Compliance = compliance
                });
            }

            feedItems.Add(new QueryFeedCardItem
            {
                MessageItem = item,
                QuestionText = qText,
                SqlQueries = sqlWithCompliance
            });
        }
    }

    private async Task HandleSearch(KeyboardEventArgs e)
    {
        await LoadData();
    }

    private void OpenComplianceModal(MikroComplianceReport report, string sql)
    {
        selectedComplianceReport = report;
        selectedTestedSql = sql;
        isComplianceModalOpen = true;
    }

    private string GetScoreColor(int score)
    {
        if (score >= 90) return "#10b981"; // Green
        if (score >= 75) return "#3b82f6"; // Blue
        if (score >= 60) return "#f59e0b"; // Yellow/Amber
        return "#ef4444"; // Red
    }

    private string FormatDuration(long ms)
    {
        if (ms >= 1000)
        {
            return $"{(ms / 1000.0):0.0}s";
        }
        return $"{ms}ms";
    }

    private List<FeedSqlItem> ExtractSqlItemsFromQuery(string? rawQuery)
    {
        var result = new List<FeedSqlItem>();
        if (string.IsNullOrWhiteSpace(rawQuery)) return result;

        var trimmed = rawQuery.Trim();

        // JSON array/object parsing
        if ((trimmed.StartsWith("[") && trimmed.EndsWith("]")) || (trimmed.StartsWith("{") && trimmed.EndsWith("}")))
        {
            try
            {
                using var doc = System.Text.Json.JsonDocument.Parse(trimmed);
                var root = doc.RootElement;

                if (root.ValueKind == System.Text.Json.JsonValueKind.Array)
                {
                    foreach (var element in root.EnumerateArray())
                    {
                        var item = ExtractFromElement(element);
                        if (item != null) result.Add(item);
                    }
                }
                else if (root.ValueKind == System.Text.Json.JsonValueKind.Object)
                {
                    var item = ExtractFromElement(root);
                    if (item != null) result.Add(item);
                }
            }
            catch
            {
                // Fallback
            }
        }

        // Fallback for non-JSON raw query strings
        if (result.Count == 0)
        {
            result.Add(new FeedSqlItem
            {
                Description = string.Empty,
                Sql = trimmed
            });
        }

        return result;
    }

    private FeedSqlItem? ExtractFromElement(System.Text.Json.JsonElement elem)
    {
        string desc = string.Empty;
        string sql = string.Empty;

        if (TryGetJsonProp(elem, "description", out var val) ||
            TryGetJsonProp(elem, "Description", out val) ||
            TryGetJsonProp(elem, "summary", out val) ||
            TryGetJsonProp(elem, "title", out val))
        {
            desc = val;
        }

        if (TryGetJsonProp(elem, "sql", out var sqlVal) ||
            TryGetJsonProp(elem, "Sql", out sqlVal) ||
            TryGetJsonProp(elem, "query", out sqlVal) ||
            TryGetJsonProp(elem, "Query", out sqlVal) ||
            TryGetJsonProp(elem, "tSql", out sqlVal))
        {
            sql = sqlVal;
        }

        if (string.IsNullOrWhiteSpace(sql))
        {
            if (elem.ValueKind == System.Text.Json.JsonValueKind.String)
                sql = elem.GetString() ?? string.Empty;
            else
                sql = elem.GetRawText();
        }

        if (string.IsNullOrWhiteSpace(sql)) return null;

        return new FeedSqlItem
        {
            Description = desc,
            Sql = sql
        };
    }

    private bool TryGetJsonProp(System.Text.Json.JsonElement elem, string propName, out string value)
    {
        value = string.Empty;
        if (elem.ValueKind == System.Text.Json.JsonValueKind.Object && elem.TryGetProperty(propName, out var prop))
        {
            if (prop.ValueKind == System.Text.Json.JsonValueKind.String)
            {
                value = prop.GetString() ?? string.Empty;
                return !string.IsNullOrWhiteSpace(value);
            }
        }
        return false;
    }

    private async Task CopySql(string text)
    {
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
    }
}

<style>
    /* ==========================================================================
       Global Queries (Son İşlemler) Executive Design System
       ========================================================================== */
    
    .query-feed-card {
        background: linear-gradient(180deg, rgba(17, 24, 39, 0.75) 0%, rgba(15, 23, 42, 0.85) 100%);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 14px;
        padding: 1.25rem 1.5rem;
        box-shadow: 0 8px 24px -6px rgba(0, 0, 0, 0.4);
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
    }

    .query-feed-card:hover {
        border-color: rgba(255, 255, 255, 0.16);
        box-shadow: 0 14px 32px -6px rgba(0, 0, 0, 0.55);
        transform: translateY(-2px);
    }

    .query-card-default {
        border-left: 4px solid #38bdf8 !important;
    }

    .query-card-error {
        border-left: 4px solid #f43f5e !important;
    }

    .query-card-disliked {
        border-left: 4px solid #fb7185 !important;
    }

    .query-card-liked {
        border-left: 4px solid #10b981 !important;
    }

    .query-card-comment {
        border-left: 4px solid #f59e0b !important;
    }

    /* Query Header & Meta */
    .query-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-bottom: 0.85rem;
        margin-bottom: 1rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.07);
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    .header-left-group {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .header-right-group {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        flex-wrap: wrap;
        margin-left: auto;
    }

    /* Mode Badges */
    .badge-mode {
        display: inline-flex;
        align-items: center;
        height: 28px;
        padding: 0 0.65rem;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.3px;
        white-space: nowrap;
    }

    .badge-mode-agent {
        background: rgba(168, 85, 247, 0.12);
        border: 1px solid rgba(192, 132, 252, 0.35);
        color: #c084fc;
    }

    .badge-mode-query {
        background: rgba(14, 165, 233, 0.12);
        border: 1px solid rgba(56, 189, 248, 0.35);
        color: #38bdf8;
    }

    /* Status & Count Badges */
    .badge-pill {
        display: inline-flex;
        align-items: center;
        height: 28px;
        padding: 0 0.65rem;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.2px;
        white-space: nowrap;
    }

    .badge-pill-sql {
        background: rgba(20, 184, 166, 0.12);
        border: 1px solid rgba(45, 212, 191, 0.35);
        color: #2dd4bf;
    }

    .badge-pill-success {
        background: rgba(16, 185, 129, 0.12);
        border: 1px solid rgba(16, 185, 129, 0.35);
        color: #34d399;
    }

    .badge-pill-error {
        background: rgba(244, 63, 94, 0.15);
        border: 1px solid rgba(244, 63, 94, 0.4);
        color: #fb7185;
    }

    .badge-pill-liked {
