        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
    }

    .meta-text-highlight {
        color: #f1f5f9;
        font-weight: 600;
    }

    .meta-separator {
        color: rgba(255, 255, 255, 0.18);
        font-size: 0.65rem;
    }

    /* Right side stats */
    .duration-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        height: 28px;
