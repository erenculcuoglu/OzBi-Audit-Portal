@page "/docs"
@page "/setup-docs"
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime

<!-- Header -->
<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h3 class="fw-bold mb-0 text-white d-flex align-items-center gap-2">
                <i class="bi bi-shield-check text-cyan"></i>
                <span>OzBI Kurulum & Hızlı Hata Teşhis Merkezi</span>
            </h3>
            <span class="badge bg-cyan-subtle text-cyan border border-cyan-subtle px-2.5 py-1 rounded-pill small fw-semibold">
                v8.0 Teşhis Akışı
            </span>
        </div>
        <div class="text-muted small">
            Müşteri sunucusunda nereden ne yapılacağını adım adım takip edin, ekrandaki sonuca göre tek tıkla çözün.
        </div>
    </div>
    
    <div class="d-flex align-items-center gap-2">
        <button class="btn btn-outline-cyan btn-sm px-3.5 py-2 rounded-pill d-inline-flex align-items-center gap-2 shadow-sm" 
                @onclick="CopyQuickDiagnosticScript" title="Tüm kontrolleri tek satırda yapıp masaüstüne rapor çıkaran script">
            <i class="bi @(isDiagCopied ? "bi-check-circle-fill text-success" : "bi-magic text-warning")"></i>
            <span class="fw-medium">@(isDiagCopied ? "Otomatik Tanı Script'i Kopyalandı!" : "⚡ Tek Satırlık Otomatik Tanı Script'i")</span>
        </button>
        <a href="https://dotnet.microsoft.com/en-us/download/dotnet/8.0" target="_blank" 
           class="btn btn-primary-gradient btn-sm px-3.5 py-2 rounded-pill text-decoration-none d-inline-flex align-items-center gap-1.5 shadow-sm">
            <i class="bi bi-cloud-arrow-down-fill"></i>
            <span class="fw-medium">.NET 8 Hosting Bundle</span>
        </a>
    </div>
</div>

<!-- 2-Mode Segmented Switcher -->
<div class="d-flex justify-content-center mb-4">
    <div class="segmented-control p-1 rounded-pill">
        <button class="segment-btn @(currentMode == "DIAGNOSE" ? "active" : "")" @onclick='() => currentMode = "DIAGNOSE"'>
            <i class="bi bi-search-heart-fill me-2 text-warning"></i>
            <span>Adım Adım Hata Teşhisi (Sorun Çöz)</span>
        </button>
        <button class="segment-btn @(currentMode == "INSTALL" ? "active" : "")" @onclick='() => currentMode = "INSTALL"'>
            <i class="bi bi-rocket-takeoff-fill me-2 text-cyan"></i>
            <span>Sıfırdan Kurulum & Ayarlar</span>
        </button>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════════════════════ -->
<!-- MOD 1: ADIM ADIM HATA TEŞHİS AKIŞI -->
<!-- ═══════════════════════════════════════════════════════════════════════════════ -->
@if (currentMode == "DIAGNOSE")
{
    <!-- Altın Kural Callout -->
    <div class="golden-rule-banner p-4 rounded-4 mb-4 d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="golden-badge">
                <i class="bi bi-lightning-charge-fill fs-4 text-warning"></i>
            </div>
            <div>
                <div class="fw-bold text-white small text-uppercase" style="letter-spacing: 0.05em;">
                    ⚡ En Hızlı Teşhis (Altın Kural — 5 Saniyede Kök Neden):
                </div>
                <div class="text-muted small">
                    Sunucuda <strong>PowerShell</strong> açıp programı elle çalıştırın. Ekrana düşen kırmızı yazı hatanın kesin sebebidir:
                </div>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <code class="text-cyan small bg-dark px-3 py-2 rounded-3 border border-secondary font-monospace">cd "C:\Program Files\OzBi" ; .\AgentBi.exe</code>
            <button class="btn btn-outline-cyan btn-sm rounded-pill px-3 py-1.5 d-inline-flex align-items-center gap-1.5" @onclick='() => CopyCode("cd \"C:\\Program Files\\OzBi\"\n.\\AgentBi.exe", "golden-cmd")'>
                <i class="bi @(IsCopied("golden-cmd") ? "bi-check2 text-success" : "bi-clipboard")"></i>
                <span class="fw-semibold">@(IsCopied("golden-cmd") ? "Kopyalandı" : "Kopyala")</span>
            </button>
        </div>
    </div>

    <!-- Senaryo Seçim Kartları (Grid) -->
    <div class="glass-card p-4 rounded-4 mb-4">
        <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
            <div>
                <h5 class="fw-bold text-white mb-1">Müşteri Ne Yaşıyor? (Senaryo Seçin):</h5>
                <div class="text-muted small">Müşterinin belirttiği duruma tıklayın, sırayla neyi nereden yapacağınız açılsın:</div>
            </div>
        </div>

        <div class="row g-3 mb-4">
            @foreach (var s in diagnosticScenarios)
            {
                var isSelected = selectedScenarioId == s.Id;
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="diagnostic-nav-card @(isSelected ? "selected" : "")" @onclick="() => selectedScenarioId = s.Id">
                        <div class="d-flex align-items-center gap-2.5 mb-2">
                            <div class="scenario-icon @s.ThemeClass">
                                <i class="bi @s.Icon"></i>
                            </div>
                            <div>
                                <div class="fw-bold text-white" style="font-size: 0.95rem;">@s.Title</div>
                                <div class="badge @s.BadgeClass" style="font-size: 0.675rem;">@s.ErrorCode</div>
                            </div>
                        </div>
                        <div class="text-muted small mb-2" style="font-size: 0.825rem; line-height: 1.45;">
                            @s.Description
                        </div>
                        <div class="mt-auto pt-2 border-top border-secondary-subtle d-flex align-items-center justify-content-between text-muted" style="font-size: 0.75rem;">
                            <span class="text-cyan fw-semibold">@s.StepCount Adımda Teşhis &rarr;</span>
                            <span class="badge bg-dark border border-secondary text-muted">@s.EstimatedTime</span>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Seçilen Senaryonun Sıralı Kontrol Akışı -->
        @if (selectedScenario != null)
        {
            <div class="scenario-detail-box p-4 p-md-5 rounded-4 border">
                <!-- Header -->
                <div class="d-flex align-items-start justify-content-between mb-4 flex-wrap gap-3 pb-3 border-bottom border-secondary-subtle">
                    <div class="d-flex align-items-center gap-3.5">
                        <div class="scenario-icon @selectedScenario.ThemeClass" style="width: 52px; height: 52px; font-size: 1.5rem;">
                            <i class="bi @selectedScenario.Icon"></i>
                        </div>
                        <div>
                            <div class="badge @selectedScenario.BadgeClass mb-1 px-2.5 py-1">@selectedScenario.ErrorCode</div>
                            <h4 class="fw-bold text-white mb-1">@selectedScenario.Title</h4>
                            <div class="text-muted small">Olası Kök Neden: <span class="text-white fw-semibold">@selectedScenario.ProbableCauses</span></div>
                        </div>
                    </div>

                    <button class="btn btn-success px-4 py-2.5 rounded-pill fw-bold d-inline-flex align-items-center gap-2 shadow"
                            @onclick='() => CopyCode(selectedScenario.OneClickFix, "one-click-fix")'>
                        <i class="bi @(IsCopied("one-click-fix") ? "bi-check2-circle" : "bi-lightning-fill") fs-5"></i>
                        <span>@(IsCopied("one-click-fix") ? "Çözüm Komutu Kopyalandı!" : "⚡ Tek Tıkla Tamir Komutu")</span>
                    </button>
                </div>

                <!-- Sıralı Teşhis Adımları (İlkokul Düzeyinde Yönlendirme) -->
                <div class="d-flex align-items-center justify-content-between mb-3.5">
                    <h6 class="fw-bold text-white mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-diagram-3-fill text-cyan"></i> Müşteri Sunucusunda Sırayla Uygulayın (@selectedScenario.Steps.Count Adım):
                    </h6>
                    <span class="text-muted small">Adımları 1'den başlayarak sırayla yapın</span>
                </div>

                <div class="step-flow-container d-flex flex-column gap-4">
                    @foreach (var step in selectedScenario.Steps)
                    {
                        <div class="step-card p-4 rounded-4 border">
                            <!-- Step Top Header -->
                            <div class="d-flex align-items-center justify-content-between gap-3 mb-2.5 flex-wrap">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="step-circle-badge">@step.StepNo</div>
                                    <div>
                                        <div class="fw-bold text-white fs-6">@step.Title</div>
                                        <div class="text-muted small">@step.SubTitle</div>
                                    </div>
                                </div>
                                <button class="btn btn-outline-cyan btn-sm rounded-pill px-3.5 py-1.5 d-inline-flex align-items-center gap-2 shadow-sm" 
                                        @onclick='() => CopyCode(step.Command, "step-cmd-" + step.StepNo)'>
                                    <i class="bi @(IsCopied("step-cmd-" + step.StepNo) ? "bi-check2 text-success" : "bi-clipboard")"></i>
                                    <span class="fw-semibold">@(IsCopied("step-cmd-" + step.StepNo) ? "Kopyalandı!" : "Komutu Kopyala")</span>
                                </button>
                            </div>

                            <!-- İlkokul Düzeyinde "Nereden ve Nasıl Yapılır?" Yönlendirme Kutusu -->
                            <div class="how-to-box p-3 rounded-3 mb-3 d-flex align-items-start gap-2.5">
                                <i class="bi bi-geo-alt-fill text-cyan fs-5 flex-shrink-0 mt-0.5"></i>
                                <div>
                                    <div class="text-cyan fw-bold small text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.05em;">
                                        Nereden & Nasıl Yapacaksınız?
                                    </div>
                                    <div class="text-white small fw-medium" style="font-size: 0.875rem; line-height: 1.5;">
                                        @((MarkupString)step.WhereAndHow)
                                    </div>
                                </div>
                            </div>

                            <!-- Terminal Code Box -->
                            <div class="terminal-box mb-3.5">
                                <div class="terminal-header d-flex align-items-center justify-content-between px-3.5 py-2 border-bottom border-secondary-subtle">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="terminal-dot bg-danger"></span>
                                        <span class="terminal-dot bg-warning"></span>
                                        <span class="terminal-dot bg-success"></span>
                                        <span class="text-muted small font-monospace ms-2" style="font-size: 0.75rem;">@step.ToolName</span>
                                    </div>
                                    <span class="badge bg-dark border border-secondary text-muted font-monospace" style="font-size: 0.7rem;">Enter</span>
                                </div>
                                <pre class="code-snippet-pre mb-0"><code>@step.Command</code></pre>
                            </div>

                            <!-- Ekranda Ne Görüyorsunuz? (Ferah Satır Tasarımı) -->
                            <div class="decision-matrix-wrap">
                                <div class="text-muted small fw-bold mb-2 text-uppercase d-flex align-items-center gap-1.5" style="font-size: 0.75rem; letter-spacing: 0.05em;">
                                    <i class="bi bi-signpost-split-fill text-warning"></i>
                                    <span>Ekrana Çıkan Yazıya Göre Ne Yapacaksınız?</span>
                                </div>

                                <div class="d-flex flex-column gap-2.5">
                                    @foreach (var outcome in step.Outcomes)
                                    {
                                        <div class="outcome-row p-3 rounded-3 @outcome.ThemeClass d-flex align-items-center justify-content-between flex-wrap gap-3">
                                            <!-- Sol Taraf: Durum & Açıklama -->
                                            <div class="d-flex align-items-center gap-3 flex-grow-1 flex-wrap">
                                                <span class="badge @outcome.BadgeClass px-3 py-1.5 fw-bold font-monospace text-nowrap" style="font-size: 0.8rem;">
                                                    @outcome.Condition
                                                </span>
                                                <div class="text-white small" style="font-size: 0.875rem; line-height: 1.45;">
                                                    @((MarkupString)outcome.Meaning)
                                                </div>
                                            </div>

                                            <!-- Sağ Taraf: Çözüm Komutu / Buton -->
                                            <div class="d-flex align-items-center gap-2.5 flex-shrink-0 flex-wrap">
                                                @if (!string.IsNullOrEmpty(outcome.FixCommand))
                                                {
                                                    <div class="outcome-code-pill font-monospace">@outcome.FixCommand</div>
                                                    <button class="btn btn-action-fix btn-sm px-3 py-1.5 rounded-pill d-inline-flex align-items-center gap-1.5 shadow-sm" 
                                                            @onclick='() => CopyCode(outcome.FixCommand, "fix-cmd-" + step.StepNo + "-" + outcome.Condition)'>
                                                        <i class="bi @(IsCopied("fix-cmd-" + step.StepNo + "-" + outcome.Condition) ? "bi-check2 text-success" : "bi-lightning-charge-fill text-warning")"></i>
                                                        <span class="fw-semibold">@(IsCopied("fix-cmd-" + step.StepNo + "-" + outcome.Condition) ? "Kopyalandı!" : "Çözümü Kopyala")</span>
                                                    </button>
                                                }
                                                @if (!string.IsNullOrEmpty(outcome.NextStepHint))
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 fw-bold d-inline-flex align-items-center gap-1.5">
                                                        <i class="bi bi-arrow-down-circle-fill"></i> @outcome.NextStepHint
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

<!-- ═══════════════════════════════════════════════════════════════════════════════ -->
<!-- MOD 2: SIFIRDAN KURULUM & AYARLAR -->
<!-- ═══════════════════════════════════════════════════════════════════════════════ -->
@if (currentMode == "INSTALL")
{
    <div class="d-flex flex-column gap-3 mb-4">
        <!-- Step 1: .NET 8 Hosting Bundle -->
        <div class="glass-card p-4 rounded-4">
            <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                <div class="d-flex align-items-center gap-3">
                    <div class="step-num bg-primary">1</div>
                    <div>
                        <h6 class="fw-bold text-white mb-0.5">.NET 8.0 ASP.NET Core Hosting Bundle Kurulumu (Zorunlu Önkoşul)</h6>
                        <div class="text-muted small">Sunucuda .NET 8 yoksa uygulama hiç açılmaz (0x80008083 / hostfxr hatası)</div>
                    </div>
                </div>
                <a href="https://dotnet.microsoft.com/en-us/download/dotnet/8.0" target="_blank" class="btn btn-outline-cyan btn-sm rounded-pill px-3.5 py-1.5">
                    <i class="bi bi-cloud-arrow-down-fill me-1"></i>Microsoft'tan İndir (.exe)
                </a>
            </div>

            <div class="how-to-box p-3 rounded-3 mb-3 d-flex align-items-start gap-2.5">
                <i class="bi bi-geo-alt-fill text-cyan fs-5 flex-shrink-0 mt-0.5"></i>
                <div class="text-white small">
                    <strong>Nereden & Nasıl:</strong> İndirdiğiniz <code>dotnet-hosting-8.0.30-win.exe</code> dosyasını sunucuda çift tıklayıp kurun veya aşağıdaki komutu PowerShell'e yapıştırın.
                </div>
            </div>

            <div class="mb-2">
                <div class="d-flex align-items-center justify-content-between mb-1 text-muted small">
                    <span>PowerShell (Yönetici) ile Sessiz Kurulum:</span>
                    <button class="btn-copy-code" @onclick='() => CopyCode(".\\dotnet-hosting-8.0.30-win.exe /install /quiet /norestart", "inst-1")'>
                        <i class="bi @(IsCopied("inst-1") ? "bi-check2 text-success" : "bi-clipboard") me-1"></i>
                        <span>@(IsCopied("inst-1") ? "Kopyalandı" : "Kopyala")</span>
                    </button>
                </div>
                <pre class="code-snippet-pre mb-2"><code>.\dotnet-hosting-8.0.30-win.exe /install /quiet /norestart</code></pre>
            </div>

            <!-- Doğrulama Notu -->
            <div class="output-interpret-box p-3 rounded-3 small d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div>
                    <span class="text-warning fw-semibold"><i class="bi bi-check-circle-fill me-1"></i>Nasıl Doğrularım?</span>
                    <span class="text-muted ms-1">PowerShell'de <code>dotnet --list-runtimes</code> yazın. <code>Microsoft.AspNetCore.App 8.0.x</code> görünmelidir.</span>
                </div>
                <button class="btn-copy-code" @onclick='() => CopyCode("dotnet --list-runtimes", "chk-rt")'>
                    <i class="bi @(IsCopied("chk-rt") ? "bi-check2 text-success" : "bi-clipboard") me-1"></i>
                    <span>Test Komutunu Kopyala</span>
                </button>
            </div>
        </div>

        <!-- Step 2: Dosyaları Kopyalama -->
        <div class="glass-card p-4 rounded-4">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="step-num bg-primary">2</div>
                <div>
                    <h6 class="fw-bold text-white mb-0.5">Dosyaları <code>C:\Program Files\OzBi</code> Klasörüne Yerleştirin</h6>
                    <div class="text-muted small">Uygulama klasörünü oluşturup dağıtım dosyalarını içine kopyalayın</div>
                </div>
            </div>

            <div class="how-to-box p-3 rounded-3 mb-3 d-flex align-items-start gap-2.5">
                <i class="bi bi-geo-alt-fill text-cyan fs-5 flex-shrink-0 mt-0.5"></i>
                <div class="text-white small">
                    <strong>Nereden & Nasıl:</strong> Windows Dosya Gezgini'ni açıp <code>C:\Program Files\OzBi</code> klasörünü oluşturun ve zip'ten çıkardığınız dosyaları buraya yapıştırın.
                </div>
            </div>

            <div class="mb-2">
                <div class="d-flex align-items-center justify-content-between mb-1 text-muted small">
                    <span>PowerShell ile Otomatik Klasör Açma & Kopyalama:</span>
                    <button class="btn-copy-code" @onclick='() => CopyCode("New-Item -ItemType Directory -Path \"C:\\Program Files\\OzBi\" -Force\nCopy-Item -Path \".\\*\" -Destination \"C:\\Program Files\\OzBi\\\" -Recurse -Force", "inst-2")'>
                        <i class="bi @(IsCopied("inst-2") ? "bi-check2 text-success" : "bi-clipboard") me-1"></i>
                        <span>@(IsCopied("inst-2") ? "Kopyalandı" : "Kopyala")</span>
                    </button>
                </div>
                <pre class="code-snippet-pre mb-2"><code>New-Item -ItemType Directory -Path "C:\Program Files\OzBi" -Force
Copy-Item -Path ".\*" -Destination "C:\Program Files\OzBi\" -Recurse -Force</code></pre>
            </div>

            <div class="output-interpret-box p-3 rounded-3 small">
                <span class="text-warning fw-semibold"><i class="bi bi-info-circle-fill me-1"></i>Kontrol:</span>
                <span class="text-muted ms-1"><code>C:\Program Files\OzBi\AgentBi.exe</code> dosyasının klasör içinde olduğunu görün.</span>
            </div>
        </div>

        <!-- Step 3: appsettings.json Oluşturucu -->
        <div class="glass-card p-4 rounded-4">
            <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                <div class="d-flex align-items-center gap-3">
                    <div class="step-num bg-info text-dark">3</div>
                    <div>
                        <h6 class="fw-bold text-white mb-0.5">Müşteri Veritabanı Bilgileri & <code>appsettings.json</code> Üretici</h6>
                        <div class="text-muted small">Aşağıdaki bilgileri doldurun; dosya otomatik oluşsun, elle JSON düzenleme hatası yapmayın:</div>
                    </div>
                </div>
                <button class="btn btn-outline-cyan btn-sm rounded-pill px-3 py-1.5" @onclick='() => CopyCode(SaveAppsettingsScript, "save-cfg-ps")'>
                    <i class="bi @(IsCopied("save-cfg-ps") ? "bi-check2 text-success" : "bi-filetype-json") me-1"></i>
                    <span>@(IsCopied("save-cfg-ps") ? "Script Kopyalandı!" : "appsettings.json'ı Otomatik Kaydet (PowerShell)")</span>
                </button>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-12 col-md-3">
                    <label class="form-label text-muted small fw-semibold">ERP Türü</label>
                    <select class="form-select form-select-sm bg-dark text-white border-secondary" @bind="cfgErpType">
                        <option value="LOGO">Logo Tiger / Go3</option>
                        <option value="MIKRO">Mikro ERP</option>
                    </select>
                </div>
                <div class="col-12 col-md-5">
                    <label class="form-label text-muted small fw-semibold">SQL Server (IP / Sunucu Adı)</label>
                    <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary" placeholder="192.168.1.100 veya localhost" @bind="cfgSqlHost" />
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label text-muted small fw-semibold">Veritabanı Adı</label>
                    <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary" placeholder="TIGERDB" @bind="cfgDatabase" />
                </div>

                <div class="col-12 col-md-3">
                    <label class="form-label text-muted small fw-semibold">SQL Kullanıcı (sa)</label>
                    <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary" @bind="cfgSqlUser" />
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label text-muted small fw-semibold">SQL Şifresi</label>
                    <input type="password" class="form-control form-control-sm bg-dark text-white border-secondary" @bind="cfgSqlPassword" />
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label text-muted small fw-semibold">Logo Firma No (001)</label>
                    <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary" maxlength="3" @bind="cfgFirmaNo" />
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label text-muted small fw-semibold">Logo Dönem No (01)</label>
                    <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary" maxlength="2" @bind="cfgDonemNo" />
                </div>
            </div>

            <!-- Canlı JSON Önizleme -->
            <div class="p-3 rounded-3 bg-dark border border-secondary mb-2">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <span class="text-muted small font-monospace"><i class="bi bi-file-code me-1 text-warning"></i><code>C:\Program Files\OzBi\appsettings.json</code> Önizleme:</span>
                    <button class="btn-copy-code" @onclick='() => CopyCode(GeneratedConfigJson, "cfg-raw")'>
                        <i class="bi @(IsCopied("cfg-raw") ? "bi-check2 text-success" : "bi-clipboard") me-1"></i>
                        <span>JSON Kopyala</span>
                    </button>
                </div>
                <pre class="code-snippet-pre mb-0" style="font-size: 0.775rem;"><code>@GeneratedConfigJson</code></pre>
            </div>
        </div>

        <!-- Step 4: Altın Kural Manuel Test (Servis Kurmadan Önce!) -->
        <div class="glass-card p-4 rounded-4 border-warning-subtle">
