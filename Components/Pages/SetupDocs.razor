    private string currentMode = "DIAGNOSE"; // DIAGNOSE or INSTALL
    private string selectedScenarioId = "refused";
    private bool isDiagCopied = false;
    private HashSet<string> copiedKeys = new();

    // Config Generator Fields
    private string cfgErpType = "LOGO";
    private string cfgSqlHost = "192.168.1.100";
    private string cfgDatabase = "TIGERDB";
    private string cfgSqlUser = "sa";
    private string cfgSqlPassword = "Password123!";
    private string cfgFirmaNo = "001";
    private string cfgDonemNo = "01";

    private string GeneratedConfigJson =>
        "{\n" +
        "  \"ConnectionStrings\": {\n" +
        $"    \"DefaultConnection\": \"Server={cfgSqlHost},1433;Database={cfgDatabase};User Id={cfgSqlUser};Password={cfgSqlPassword};TrustServerCertificate=True;Encrypt=False;\"\n" +
        "  },\n" +
        "  \"AppSettings\": {\n" +
        "    \"Port\": 8500,\n" +
        $"    \"ErpType\": \"{cfgErpType}\",\n" +
        $"    \"FirmaNo\": \"{cfgFirmaNo}\",\n" +
        $"    \"DonemNo\": \"{cfgDonemNo}\"\n" +
        "  },\n" +
        "  \"Logging\": {\n" +
        "    \"LogLevel\": {\n" +
        "      \"Default\": \"Information\",\n" +
        "      \"Microsoft.AspNetCore\": \"Warning\"\n" +
        "    }\n" +
        "  }\n" +
        "}";

    private string SaveAppsettingsScript =>
        $"$config = @'\n{GeneratedConfigJson}\n'@\n" +
        "$config | Out-File -FilePath \"C:\\Program Files\\OzBi\\appsettings.json\" -Encoding UTF8 -Force\n" +
        "Write-Host \"[+] appsettings.json basariyla olusturuldu.\" -ForegroundColor Green";

    private string CompleteSetupScript => 
        $"# 1. Servisi olustur (otomatik baslangic)\n" +
        $"sc.exe create OzBiService binPath= \"\\\"C:\\Program Files\\OzBi\\AgentBi.exe\\\"\" DisplayName= \"OzBi Agent Service\" start= auto obj= \"LocalSystem\"\n" +
        $"# 2. Cokme durumunda 3 kez otomatik yeniden baslatma (Recovery)\n" +
        $"sc.exe failure OzBiService reset= 86400 actions= restart/60000/restart/60000/restart/60000\n" +
        $"# 3. Servisi baslat\n" +
        $"Start-Service OzBiService\n" +
        $"# 4. Windows Guvenlik Duvarinda 8500 portunu ac\n" +
        $"New-NetFirewallRule -DisplayName \"OzBi Agent (8500)\" -Direction Inbound -Protocol TCP -LocalPort 8500 -Action Allow -Profile Any\n" +
        $"Get-Service OzBiService";

    private DiagnosticScenario? selectedScenario => diagnosticScenarios.FirstOrDefault(s => s.Id == selectedScenarioId);

    private bool IsCopied(string key) => copiedKeys.Contains(key);

    private async Task CopyCode(string code, string key)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", code);
            copiedKeys.Add(key);
            StateHasChanged();

            _ = Task.Delay(2000).ContinueWith(_ =>
            {
                copiedKeys.Remove(key);
                InvokeAsync(StateHasChanged);
            });
        }
        catch { }
    }

    private async Task CopyQuickDiagnosticScript()
    {
        await CopyCode(remoteDiagScript, "quick-diag");
        isDiagCopied = true;
        StateHasChanged();
        _ = Task.Delay(2000).ContinueWith(_ =>
        {
            isDiagCopied = false;
            InvokeAsync(StateHasChanged);
        });
    }

