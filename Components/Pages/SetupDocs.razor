    private string remoteDiagScript = @"# =========================================================
# OzBI Hızlı Tanı ve Sistem Raporu Oluşturucu
# =========================================================
$report = @()
$report += ""===============================================""
$report += ""OZBI TANI VE SISTEM RAPORU - $(Get-Date)""
$report += ""===============================================""

$report += ""`n[1] .NET RUNTIME BILGISI:""
$report += (dotnet --list-runtimes 2>&1 | Out-String)

$report += ""`n[2] OZBİ WINDOWS SERVISI DURUMU:""
$report += (Get-Service OzBiService 2>&1 | Format-List Status, StartType, DisplayName | Out-String)

$report += ""`n[3] PORT 8500 DINLEME DURUMU:""
$portChk = netstat -ano | findstr "":8500""
if ($portChk) { $report += $portChk } else { $report += ""UYARI: Port 8500 üzerinde dinleyen uygulama yok."" }

$report += ""`n[4] OZBİ KURULUM DIZINI DOSYALARI:""
$report += (Get-ChildItem ""C:\Program Files\OzBi"" -ErrorAction SilentlyContinue | Select-Object Name, Length, LastWriteTime | Format-Table | Out-String)

$report += ""`n[5] SON WINDOWS APPLICATION LOG HATALARI:""
$report += (Get-EventLog -LogName Application -Newest 10 -EntryType Error 2>&1 | Select-Object TimeGenerated, Source, Message | Format-List | Out-String)

$report += ""`n[6] OZBİ UYGULAMA LOGLARI (SON 20 SATIR):""
$log = Get-ChildItem ""C:\Program Files\OzBi\logs\*"" -ErrorAction SilentlyContinue | Sort-Object LastWriteTime -Descending | Select-Object -First 1
if ($log) { $report += (Get-Content $log.FullName -Tail 20 | Out-String) } else { $report += ""Log dosyasi bulunamadi."" }

$outPath = ""$env:USERPROFILE\Desktop\OzBi_Tani_Raporu.txt""
$report | Out-File $outPath -Encoding UTF8
Write-Host ""[+] Rapor basariyla olusturuldu: $outPath"" -ForegroundColor Green
notepad $outPath";
}

