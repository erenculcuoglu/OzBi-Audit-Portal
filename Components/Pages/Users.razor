@page "/users"
@inject IUserService UserService
@using OzBiPortalCRM.Services
@using OzBiPortalCRM.Models

<div class="mb-4 d-flex align-items-center justify-content-between flex-wrap gap-3">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-people-fill text-primary me-2"></i>Kullanıcı Yönetimi</h2>
        <p class="text-muted small mb-0">Portal kullanıcı hesapları, şifre ve rol yönetimi (SQLite Veritabanı)</p>
    </div>
    <div>
        <button class="btn-primary-custom" @onclick="OpenAddModal">
            <i class="bi bi-person-plus-fill"></i> Yeni Kullanıcı Ekle
        </button>
    </div>
</div>

@if (!string.IsNullOrEmpty(statusMessage))
{
    <div class="alert @(isSuccessStatus ? "alert-success" : "alert-danger") alert-dismissible fade show mb-4" role="alert">
        <i class="bi @(isSuccessStatus ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") me-2"></i>
        @statusMessage
        <button type="button" class="btn-close btn-close-white" @onclick="() => statusMessage = null"></button>
    </div>
}

<!-- Users Table -->
@if (isLoading)
{
    <div class="glass-card text-center py-5">
        <div class="spinner-border text-primary mb-3" role="status"></div>
        <div class="text-muted">Kullanıcılar yükleniyor...</div>
    </div>
}
else if (usersList == null || usersList.Count == 0)
{
    <div class="glass-card text-center py-5">
        <i class="bi bi-person-x text-muted" style="font-size: 3rem;"></i>
        <h5 class="mt-3 text-muted">Kullanıcı kaydı bulunamadı</h5>
    </div>
}
else
{
    <div class="custom-table-wrapper">
        <table class="custom-table">
            <thead>
                <tr>
                    <th>Ad Soyad</th>
                    <th>E-posta Adresi</th>
                    <th>Rol</th>
                    <th>Durum</th>
                    <th>Kayıt Tarihi</th>
                    <th>Son Giriş</th>
                    <th class="col-sticky-action" style="text-align: right; white-space: nowrap;">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in usersList)
                {
                    <tr>
                        <td>
                            <div class="fw-bold text-main text-ellipsis" style="max-width: 180px;" title="@user.FullName">@user.FullName</div>
                            @if (user.Email.Equals("eren@ozbiapp.com.tr", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-primary text-white border border-primary border-opacity-50 mt-1 px-2 py-0.5" style="font-size: 0.7rem; font-weight: 600;">
                                    Seed Yönetici
                                </span>
                            }
                        </td>
                        <td>
                            <code class="text-ellipsis d-inline-block" style="max-width: 180px;" title="@user.Email">@user.Email</code>
                        </td>
                        <td>
                            <span class="badge-status @(user.Role == "Admin" ? "badge-purple" : "badge-info")">
                                <i class="bi @(user.Role == "Admin" ? "bi-shield-lock" : "bi-person")"></i> @user.Role
                            </span>
                        </td>
                        <td>
                            @if (user.IsActive)
                            {
                                <span class="badge-status badge-success"><i class="bi bi-check-circle-fill"></i> Aktif</span>
                            }
                            else
                            {
                                <span class="badge-status badge-danger"><i class="bi bi-x-circle-fill"></i> Pasif</span>
                            }
                        </td>
                        <td>
                            <span class="text-muted small">@user.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                        </td>
                        <td>
                            <span class="text-muted small">@(user.LastLoginAt?.ToString("dd.MM.yyyy HH:mm") ?? "Hiç girmediler")</span>
                        </td>
                        <td class="col-sticky-action" style="text-align: right; white-space: nowrap;">
                            <button class="btn btn-sm btn-outline-info me-1 py-1 px-2.5" @onclick="() => OpenEditModal(user)">
                                <i class="bi bi-pencil-square"></i> Düzenle
                            </button>

                            @if (!user.Email.Equals("eren@ozbiapp.com.tr", StringComparison.OrdinalIgnoreCase))
                            {
                                <button class="btn btn-sm btn-outline-danger py-1 px-2.5" @onclick="() => DeleteUser(user)">
                                    <i class="bi bi-trash"></i> Sil
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- Modal Dialog for Add / Edit User -->
@if (showModal)
{
    <div class="modal-backdrop-custom">
        <div class="modal-dialog-custom">
            <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom border-secondary border-opacity-25">
                <h5 class="fw-bold mb-0 text-main">
                    <i class="bi @(editingUser.Id == 0 ? "bi-person-plus-fill text-primary" : "bi-pencil-square text-info") me-2"></i>
                    @(editingUser.Id == 0 ? "Yeni Kullanıcı Ekle" : "Kullanıcı Bilgilerini Düzenle")
                </h5>
                <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
            </div>

            @if (!string.IsNullOrEmpty(modalErrorMessage))
            {
                <div class="alert alert-danger py-2 px-3 mb-3 small" style="border-radius: var(--radius-md);">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> @modalErrorMessage
                </div>
            }

            <div class="mb-3">
                <label class="form-label text-muted small fw-semibold">Ad Soyad</label>
                <input type="text" class="form-control input-custom" placeholder="Örn: Kaan Arslan" @bind="editingUser.FullName" />
            </div>

            <div class="mb-3">
                <label class="form-label text-muted small fw-semibold">E-posta Adresi</label>
                <input type="email" class="form-control input-custom" placeholder="ornek@ozbiapp.com.tr" @bind="editingUser.Email" />
            </div>

            <div class="mb-3">
                <label class="form-label text-muted small fw-semibold">
                    Şifre @(editingUser.Id > 0 ? "(Boş bırakılırsa mevcut şifre korunur)" : "")
                </label>
                <input type="password" class="form-control input-custom" placeholder="••••••••" @bind="passwordInput" />
            </div>

            <div class="mb-3">
                <label class="form-label text-muted small fw-semibold">Kullanıcı Rolü</label>
                <select class="form-select input-custom" @bind="editingUser.Role">
                    <option value="Admin">Admin (Yönetici)</option>
                    <option value="Auditor">Auditor (Denetçi)</option>
                </select>
            </div>

            <div class="mb-4 form-check form-switch">
                <input class="form-check-input" type="checkbox" id="activeSwitch" @bind="editingUser.IsActive" />
                <label class="form-check-label text-main small ms-2" for="activeSwitch">Kullanıcı Hesabı Aktif</label>
            </div>

            <div class="d-flex justify-content-end gap-2 pt-2 border-top border-secondary border-opacity-25">
                <button type="button" class="btn btn-outline-secondary" @onclick="CloseModal">İptal</button>
                <button type="button" class="btn-primary-custom" @onclick="SaveUser" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        <span>Kaydediliyor...</span>
                    }
                    else
                    {
                        <i class="bi bi-check-lg"></i>
                        <span>Kaydet</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<PortalUser>? usersList;
    private bool isLoading = true;

    private bool showModal = false;
    private PortalUser editingUser = new PortalUser();
    private string passwordInput = string.Empty;
    private bool isSaving = false;

    private string? statusMessage;
    private string? modalErrorMessage;
    private bool isSuccessStatus = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        isLoading = true;
        try
        {
            usersList = await UserService.GetAllUsersAsync();
        }
        catch (Exception ex)
        {
            statusMessage = "Kullanıcılar yüklenirken hata oluştu: " + ex.Message;
            isSuccessStatus = false;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenAddModal()
    {
        editingUser = new PortalUser { IsActive = true, Role = "Auditor" };
        passwordInput = string.Empty;
        modalErrorMessage = null;
        showModal = true;
    }

    private void OpenEditModal(PortalUser user)
    {
        editingUser = new PortalUser
        {
            Id = user.Id,
            Email = user.Email,
            FullName = user.FullName,
            Role = user.Role,
            IsActive = user.IsActive,
            CreatedAt = user.CreatedAt
        };
        passwordInput = string.Empty;
        modalErrorMessage = null;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
    }

    private async Task SaveUser()
    {
        modalErrorMessage = null;

        if (string.IsNullOrWhiteSpace(editingUser.FullName))
        {
            modalErrorMessage = "Lütfen Ad Soyad giriniz.";
            return;
        }

        if (string.IsNullOrWhiteSpace(editingUser.Email))
        {
            modalErrorMessage = "Lütfen geçerli bir E-posta adresi giriniz.";
            return;
        }

        if (editingUser.Id == 0 && (string.IsNullOrWhiteSpace(passwordInput) || passwordInput.Length < 6))
        {
            modalErrorMessage = "Yeni kullanıcı için şifre en az 6 karakter olmalıdır.";
            return;
        }

        isSaving = true;
        try
        {
            (bool Success, string Message) result;
            if (editingUser.Id == 0)
            {
                result = await UserService.CreateUserAsync(editingUser, passwordInput);
            }
            else
            {
                result = await UserService.UpdateUserAsync(editingUser, passwordInput);
            }

            if (result.Success)
            {
                statusMessage = result.Message;
                isSuccessStatus = true;
                showModal = false;
                await LoadUsers();
            }
            else
            {
                modalErrorMessage = result.Message;
            }
        }
        catch (Exception ex)
        {
            modalErrorMessage = "İşlem sırasında hata oluştu: " + ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteUser(PortalUser user)
    {
        if (user.Email.Equals("eren@ozbiapp.com.tr", StringComparison.OrdinalIgnoreCase))
        {
            statusMessage = "Seed yönetici hesabı silinemez.";
            isSuccessStatus = false;
            return;
        }

        var deleted = await UserService.DeleteUserAsync(user.Id);
        if (deleted)
        {
            statusMessage = $"{user.FullName} kullanıcısı silindi.";
            isSuccessStatus = true;
            await LoadUsers();
        }
        else
        {
            statusMessage = "Kullanıcı silinemedi.";
            isSuccessStatus = false;
        }
    }
}
