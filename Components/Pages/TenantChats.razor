@page "/tenant/{TenantId}/chats"
@inject IOzBiAuditService AuditService
@inject NavigationManager Navigation
@using OzBiPortalCRM.Services
@using OzBiPortalCRM.Models
@using OzBiPortalCRM.Components.Shared

<div class="mb-4">
    <a href="tenants" class="btn btn-outline-secondary btn-sm mb-3">
        <i class="bi bi-arrow-left"></i> Tenant Listesine Dön
    </a>

    @if (tenant != null)
    {
        <div class="glass-card d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <span class="badge-status badge-info mb-2"><i class="bi bi-building"></i> Seçilen Tenant</span>
                <h3 class="fw-bold mb-1">@tenant.Name</h3>
                <div class="text-muted small d-flex align-items-center gap-3 flex-wrap">
                    <span><i class="bi bi-envelope"></i> @(tenant.Email ?? "E-posta yok")</span>
                    <span title="Kayıt / Başlangıç Tarihi"><i class="bi bi-calendar3"></i> <strong>Date Created:</strong> @(EffectiveStartDate?.ToString("dd.MM.yyyy") ?? "-")</span>
                    <span class="d-inline-flex align-items-center gap-1">
                        <i class="bi bi-calendar-check text-warning"></i> 
                        <strong>Subscription End:</strong> 
                        <span>@(EffectiveEndDate?.ToString("dd.MM.yyyy") ?? "-")</span>
                        @if (DaysRemaining.HasValue)
                        {
                            if (DaysRemaining.Value < 0)
                            {
                                <span class="badge bg-danger text-white ms-1">Süresi Doldu</span>
                            }
                            else if (DaysRemaining.Value <= 15)
                            {
                                <span class="badge bg-warning text-dark ms-1">@DaysRemaining.Value Gün Kaldı</span>
                            }
                            else
                            {
                                <span class="badge bg-success text-white ms-1">@DaysRemaining.Value Gün Kaldı</span>
                            }
                        }
                    </span>
                    <span style="font-family: monospace;">ID: @tenant.Id</span>
                </div>
            </div>

            <div class="d-flex gap-3 align-items-center">
                <div class="text-center p-2 rounded bg-black bg-opacity-30 border border-secondary border-opacity-25 px-3">
                    <div class="fs-4 fw-bold text-primary">@(chatsList?.Count ?? 0)</div>
                    <div class="text-muted small">Sohbet (Chat)</div>
                </div>
                <div class="text-center p-2 rounded bg-black bg-opacity-30 border border-secondary border-opacity-25 px-3">
                    <div class="fs-4 fw-bold text-info">@TotalQueries / 50</div>
                    <div class="text-muted small">Kullanılan SQL</div>
                </div>
                <div class="text-center p-2 rounded bg-black bg-opacity-30 border border-secondary border-opacity-25 px-3">
                    <div class="fs-4 fw-bold @(RemainingQueries == 0 ? "text-danger" : "text-success")">
                        @RemainingQueries
                    </div>
                    <div class="text-muted small">Kalan Hak</div>
                </div>
            </div>
        </div>

        <!-- ERP Compliance Scorecard Hero Card -->
        @if (scorecard != null)
        {
            <div class="glass-card mb-4 mt-3" style="background: linear-gradient(135deg, rgba(15, 23, 42, 0.9) 0%, rgba(30, 41, 59, 0.8) 100%); border-left: 4px solid @GetScoreColor(scorecard.OverallScore);">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                    <!-- Left: Score Badge & Grade -->
                    <div class="d-flex align-items-center gap-3">
                        <div class="text-center p-2 rounded-circle border"
                             style="width: 72px; height: 72px; display: flex; align-items: center; justify-content: center; flex-direction: column; background: rgba(0,0,0,0.5); border-color: @GetScoreColor(scorecard.OverallScore) !important; box-shadow: 0 0 15px @GetScoreGlowColor(scorecard.OverallScore);">
                            <span class="fs-3 fw-bold" style="color: @GetScoreColor(scorecard.OverallScore); line-height: 1;">@scorecard.OverallScore</span>
                            <span class="text-muted" style="font-size: 0.6rem;">/ 100</span>
                        </div>

                        <div>
                            <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                                <span class="badge px-2.5 py-1 fw-bold" style="background: @GetScoreColor(scorecard.OverallScore); color: #000; font-size: 0.85rem;">
                                    Not: @scorecard.Grade (@scorecard.GradeLabel)
                                </span>
                                <span class="badge-status badge-info" style="font-size: 0.75rem;">
                                    <i class="bi bi-cpu"></i> @scorecard.ErpTypeName
                                </span>
                                @if (!scorecard.IsPromptSynced && scorecard.ErpType != "Generic")
                                {
                                    <span class="badge-status badge-warning" style="font-size: 0.75rem;" title="@scorecard.PromptSyncDetails">
                                        <i class="bi bi-exclamation-triangle me-1"></i>@scorecard.PromptVersionLabel
                                    </span>
                                }
                            </div>
                            <div class="text-muted small">
                                <i class="bi bi-clock-history me-1"></i> @scorecard.TotalQueriesEvaluated SQL sorgusu üzerinden hesaplandı &bull; Son Kontrol: @scorecard.LastEvaluatedAt.ToString("dd.MM.yyyy HH:mm")
                            </div>
                        </div>
                    </div>

                    <!-- Center: Segmented Progress Distribution & Stats -->
                    <div class="d-flex flex-column gap-1.5" style="min-width: 220px; flex: 1; max-width: 320px;">
                        <div class="d-flex justify-content-between small text-muted" style="font-size: 0.75rem;">
                            <span class="text-success fw-semibold"><i class="bi bi-check-circle me-0.5"></i>Uyumlu: @scorecard.CompliantCount</span>
                            <span class="text-warning fw-semibold"><i class="bi bi-exclamation-circle me-0.5"></i>Uyarı: @scorecard.WarningCount</span>
                            <span class="text-danger fw-semibold"><i class="bi bi-x-circle me-0.5"></i>Kritik: @scorecard.CriticalCount</span>
                        </div>
                        <div class="progress" style="height: 8px; background-color: rgba(255, 255, 255, 0.1); border-radius: 4px; overflow: hidden;">
                            @if (scorecard.CompliantPercentage > 0)
                            {
                                <div class="progress-bar bg-success" style="width: @scorecard.CompliantPercentage%;"></div>
                            }
                            @if (scorecard.WarningPercentage > 0)
                            {
                                <div class="progress-bar bg-warning" style="width: @scorecard.WarningPercentage%;"></div>
                            }
                            @if (scorecard.CriticalPercentage > 0)
                            {
                                <div class="progress-bar bg-danger" style="width: @scorecard.CriticalPercentage%;"></div>
                            }
                        </div>
                        @if (scorecard.TopViolations.Count > 0)
                        {
                            var topV = scorecard.TopViolations.First();
                            <div class="text-danger text-truncate small" style="font-size: 0.725rem;" title="En Sık İhlal: [@topV.RuleId] @topV.Title">
                                <i class="bi bi-exclamation-diamond me-1"></i>En Sık: <strong>@topV.Title</strong> (@topV.Count kez)
                            </div>
                        }
                    </div>

                    <!-- Right: Action Buttons -->
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <button class="btn btn-sm btn-outline-info" @onclick="() => isComplianceModalOpen = true" title="Detaylı ERP Uyum Analizini Görüntüle">
                            <i class="bi bi-shield-check me-1"></i> Detaylı Uyum Analizi
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="RefreshScorecardLive" disabled="@isCalculatingScore" title="Canlı Olarak Skoru Yeniden Hesapla">
                            @if (isCalculatingScore)
                            {
                                <span class="spinner-border spinner-border-sm" role="status"></span>
                            }
                            else
                            {
                                <i class="bi bi-arrow-clockwise"></i>
                            }
                        </button>
                    </div>
                </div>
            </div>
        }
    }
</div>

<!-- Search & Filters -->
<div class="glass-card mb-4">
    <div class="row g-3 align-items-center">
        <div class="col-md-6">
            <div class="input-group">
                <span class="input-group-text bg-dark border-secondary text-muted"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control input-custom" placeholder="Sohbet başlığında veya sorularda ara (örn: bordro, cari, mesai)..." @bind="searchTerm" @bind:event="oninput" @onkeyup="HandleSearch" />
                @if (!string.IsNullOrEmpty(searchTerm))
                {
                    <button class="btn btn-outline-secondary" type="button" @onclick="ClearSearch" title="Temizle">
                        <i class="bi bi-x-lg"></i>
                    </button>
                }
            </div>
        </div>
        <div class="col-md-3">
            <select class="form-select input-custom" @bind="selectedUserId" @bind:after="LoadChatsOnly">
                <option value="">Tüm Kullanıcılar (@(tenantUsers?.Count ?? 0) Kullanıcı)</option>
                @if (tenantUsers != null)
                {
                    @foreach (var u in tenantUsers)
                    {
                        <option value="@u.Id">
                            @(string.IsNullOrEmpty(u.NameSurname) ? (u.UserName ?? u.Email) : u.NameSurname) (@u.Email)
                        </option>
                    }
                }
            </select>
        </div>
        <div class="col-md-3 text-end">
            <span class="text-muted small">Bulunan Sohbet: <strong>@chatsList?.Count</strong></span>
        </div>
    </div>
</div>

<!-- Chats Table -->
@if (isLoading)
{
    <div class="glass-card text-center py-5">
        <div class="spinner-border text-primary mb-3" role="status"></div>
        <div class="text-muted">Tenant sohbetleri yükleniyor...</div>
    </div>
}
else if (chatsList == null || chatsList.Count == 0)
{
    <div class="glass-card text-center py-5">
        <i class="bi bi-chat-left-dots text-muted" style="font-size: 3rem;"></i>
        <h5 class="mt-3 text-muted">Aramanıza veya seçilen kullanıcıya uygun sohbet bulunamadı</h5>
    </div>
}
else
{
    <div class="custom-table-wrapper">
        <table class="custom-table">
            <thead>
                <tr>
                    <th style="white-space: nowrap;">Sohbet Başlığı ve İçi (Sorular)</th>
                    <th style="white-space: nowrap;">Kullanıcı</th>
                    <th style="white-space: nowrap; text-align: center;">AI Modeli</th>
                    <th style="white-space: nowrap; text-align: center;">Asistan İsmi</th>
                    <th style="white-space: nowrap; text-align: center;">Mod</th>
                    <th style="white-space: nowrap; text-align: center;">Soru / SQL</th>
                    <th style="white-space: nowrap; text-align: center;">Tarih/Saat</th>
                    <th class="col-sticky-action" style="white-space: nowrap; text-align: center;">İşlem</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in chatsList)
                {
                    <tr>
                        <td>
                            <div class="fw-bold text-main text-ellipsis mb-1" style="max-width: 380px;" title="@item.Chat.Title">
                                <i class="bi bi-chat-text-fill text-primary me-1"></i>
                                @(string.IsNullOrWhiteSpace(item.Chat.Title) ? "Başlıksız Sohbet" : item.Chat.Title)
                            </div>

                            @if (item.UserQuestions != null && item.UserQuestions.Count > 0)
                            {
                                <div class="mt-1 d-flex flex-column gap-1 p-2 rounded bg-black bg-opacity-30 border border-secondary border-opacity-25" style="max-width: 420px;">
                                    @foreach (var (q, qIdx) in item.UserQuestions.Select((val, idx) => (val, idx + 1)))
                                    {
                                        var isMatched = !string.IsNullOrWhiteSpace(searchTerm) && q.ToLower().Contains(searchTerm.Trim().ToLower());
                                        <div class="small d-flex align-items-center gap-2 @(isMatched ? "text-warning fw-bold" : "text-light opacity-90")" style="font-size: 0.78rem;">
                                            <span class="badge @(isMatched ? "bg-warning text-dark" : "bg-secondary text-white") px-1 py-0" style="font-size: 0.68rem; font-family: monospace;">Soru #@qIdx</span>
                                            <span class="text-truncate" style="max-width: 330px;" title="@q">@q</span>
                                        </div>
                                    }
                                </div>
                            }

                            <div class="text-muted text-ellipsis mt-1" style="font-size: 0.7rem; font-family: monospace; opacity: 0.6;" title="Chat ID: @item.Chat.Id">
                                ID: @item.Chat.Id
                            </div>
                        </td>
                        <td>
                            <div class="text-muted text-ellipsis" style="max-width: 180px;">
                                @(item.Chat.CreatedByUser?.NameSurname ?? item.Chat.CreatedByUser?.Email ?? "Sistem / Anonim")
                            </div>
                        </td>
                        <td style="text-align: center;">
                            @if (!string.IsNullOrEmpty(item.PrimaryAiModelName))
                            {
                                <span class="badge-status" style="background: rgba(99, 102, 241, 0.15); border: 1px solid rgba(129, 140, 248, 0.4); color: #818cf8;">
                                    @item.PrimaryAiModelName
                                </span>
                            }
                            else
                            {
                                <span class="text-muted small">-</span>
                            }
                        </td>
                        <td style="text-align: center;">
                            @if (!string.IsNullOrEmpty(item.AssistantName))
                            {
                                <span class="badge-status" style="background: rgba(20, 184, 166, 0.15); border: 1px solid rgba(45, 212, 191, 0.4); color: #2dd4bf;" title="Çalıştırılan Asistan">
                                    @item.AssistantName
                                </span>
                            }
                            else
                            {
                                <span class="text-muted small">-</span>
                            }
                        </td>
                        <td style="text-align: center;">
                            @if (item.IsAsistantMode)
                            {
                                <span class="badge-status" style="background: rgba(168, 85, 247, 0.15); border: 1px solid rgba(192, 132, 252, 0.4); color: #c084fc;" title="Agent Modu">
                                    Agent Modu
                                </span>
                            }
                            else
                            {
                                <span class="badge-status" style="background: rgba(14, 165, 233, 0.15); border: 1px solid rgba(56, 189, 248, 0.4); color: #38bdf8;" title="Sorgu Modu (SQL Raporu)">
                                    Sorgu Modu
                                </span>
                            }
                        </td>
                        <td style="text-align: center;">
                            <div class="d-inline-flex align-items-center gap-2">
                                <span class="badge-status badge-info" title="Soru / Mesaj Sayısı">
                                    @item.MessageCount Soru
                                </span>
                                <span class="badge-status badge-success" title="SQL Sorgu Sayısı">
                                    @item.QueryCount SQL
                                </span>
                            </div>
                        </td>
                        <td style="text-align: center;">
                            <span class="text-muted" style="font-size: 0.85rem;">
                                @(item.Chat.DateCreated?.ToString("dd.MM.yyyy HH:mm") ?? "-")
                            </span>
                        </td>
                        <td class="col-sticky-action" style="text-align: center;">
                            <button class="btn btn-sm btn-primary-custom px-3 py-1" @onclick="() => InspectChat(item.Chat.Id)">
                                <i class="bi bi-eye"></i> İncele
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<TenantComplianceModal IsOpen="@isComplianceModalOpen"
                       Scorecard="@scorecard"
                       OnClose="@(() => isComplianceModalOpen = false)"
                       OnRefresh="@RefreshScorecardLive" />

@code {
    [Parameter]
    public string TenantId { get; set; } = string.Empty;

    private OzBiTenant? tenant;
    private List<OzBiUser>? tenantUsers;
    private List<ChatAuditSummary>? chatsList;
    private TenantSubscription? subscription;
    private TenantComplianceScorecard? scorecard;
    private DateTime? mariaDbStartDate;
    private DateTime? mariaDbEndDate;
    private string searchTerm = string.Empty;
    private string selectedUserId = string.Empty;
    private bool isLoading = true;
    private bool isComplianceModalOpen = false;
    private bool isCalculatingScore = false;

    private int TotalQueries => chatsList?.Sum(c => c.QueryCount) ?? 0;
    private int RemainingQueries => Math.Max(0, 50 - TotalQueries);

    private DateTime? EffectiveStartDate => mariaDbStartDate ?? tenant?.DateCreated;
    private DateTime? EffectiveEndDate => mariaDbEndDate ?? subscription?.SubscriptionEndDate;

    private int? DaysRemaining
    {
        get
        {
            if (EffectiveEndDate == null) return null;
            return (EffectiveEndDate.Value.Date - DateTime.Today).Days;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            tenant = await AuditService.GetTenantByIdAsync(TenantId);
            tenantUsers = await AuditService.GetUsersForTenantAsync(TenantId);
            chatsList = await AuditService.GetChatsForTenantAsync(TenantId, searchTerm, selectedUserId);
            subscription = await AuditService.GetTenantSubscriptionAsync(TenantId);
            scorecard = await AuditService.GetTenantComplianceScorecardAsync(TenantId);

            var (mStart, mEnd) = await AuditService.GetTenantSubscriptionFromMariaDbAsync(TenantId, tenant?.RemoteId);
            mariaDbStartDate = mStart;
            mariaDbEndDate = mEnd;
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error loading chats: " + ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RefreshScorecardLive()
    {
        isCalculatingScore = true;
        try
        {
            scorecard = await AuditService.GetTenantComplianceScorecardAsync(TenantId, forceRefresh: true);
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error refreshing compliance scorecard: " + ex.Message);
        }
        finally
        {
            isCalculatingScore = false;
        }
    }

    private async Task LoadChatsOnly()
    {
        try
        {
            chatsList = await AuditService.GetChatsForTenantAsync(TenantId, searchTerm, selectedUserId);
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error filtering chats by user: " + ex.Message);
        }
    }

    private async Task HandleSearch(KeyboardEventArgs e)
    {
        await LoadChatsOnly();
    }

    private async Task ClearSearch()
    {
        searchTerm = string.Empty;
        await LoadChatsOnly();
    }

    private void InspectChat(string chatId)
    {
        Navigation.NavigateTo($"/chat/{chatId}");
    }

    private string GetScoreColor(int score)
    {
        if (score >= 90) return "#10b981"; // emerald green
        if (score >= 75) return "#38bdf8"; // sky blue
        if (score >= 60) return "#f59e0b"; // amber
        return "#ef4444"; // red
    }

    private string GetScoreGlowColor(int score)
    {
        if (score >= 90) return "rgba(16, 185, 129, 0.3)";
        if (score >= 75) return "rgba(56, 189, 248, 0.3)";
        if (score >= 60) return "rgba(245, 158, 11, 0.3)";
        return "rgba(239, 68, 68, 0.3)";
    }
}
