@page "/tenant/{TenantId}/chats"
@inject IOzBiAuditService AuditService
@inject NavigationManager Navigation
@using OzBiPortalCRM.Services
@using OzBiPortalCRM.Models

<div class="mb-4">
    <a href="tenants" class="btn btn-outline-secondary btn-sm mb-3">
        <i class="bi bi-arrow-left"></i> Tenant Listesine Dön
    </a>

    @if (tenant != null)
    {
        <div class="glass-card d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <span class="badge-status badge-info mb-2"><i class="bi bi-building"></i> Seçilen Tenant</span>
                <h3 class="fw-bold mb-1">@tenant.Name</h3>
                <div class="text-muted small d-flex align-items-center gap-3 flex-wrap">
                    <span><i class="bi bi-envelope"></i> @(tenant.Email ?? "E-posta yok")</span>
                    <span><i class="bi bi-calendar3"></i> Kayıt: @(tenant.DateCreated?.ToString("dd.MM.yyyy") ?? "-")</span>
                    <span style="font-family: monospace;">ID: @tenant.Id</span>
                </div>
            </div>

            <div class="d-flex gap-3">
                <div class="text-center p-2 rounded bg-black bg-opacity-30 border border-secondary border-opacity-25 px-3">
                    <div class="fs-4 fw-bold text-primary">@chatsList?.Count</div>
                    <div class="text-muted small">Sohbet (Chat)</div>
                </div>
                <div class="text-center p-2 rounded bg-black bg-opacity-30 border border-secondary border-opacity-25 px-3">
                    <div class="fs-4 fw-bold text-info">@chatsList?.Sum(c => c.QueryCount)</div>
                    <div class="text-muted small">SQL Sorguları</div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Search & Filters -->
<div class="glass-card mb-4">
    <div class="row g-3 align-items-center">
        <div class="col-md-8">
            <div class="input-group">
                <span class="input-group-text bg-dark border-secondary text-muted"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control input-custom" placeholder="Sohbet başlığında ara..." @bind="searchTerm" @bind:event="oninput" @onkeyup="HandleSearch" />
            </div>
        </div>
        <div class="col-md-4 text-end">
            <span class="text-muted small">Bulunan Sohbet: <strong>@chatsList?.Count</strong></span>
        </div>
    </div>
</div>

<!-- Chats Table -->
@if (isLoading)
{
    <div class="glass-card text-center py-5">
        <div class="spinner-border text-primary mb-3" role="status"></div>
        <div class="text-muted">Tenant sohbetleri yükleniyor...</div>
    </div>
}
else if (chatsList == null || chatsList.Count == 0)
{
    <div class="glass-card text-center py-5">
        <i class="bi bi-chat-left-dots text-muted" style="font-size: 3rem;"></i>
        <h5 class="mt-3 text-muted">Bu tenant için henüz bir sohbet bulunamadı</h5>
    </div>
}
else
{
    <div class="custom-table-wrapper">
        <table class="custom-table">
            <thead>
                <tr>
                    <th>Sohbet Başlığı (Title)</th>
                    <th>Oluşturan Kullanıcı</th>
                    <th>AI Modeli</th>
                    <th>Mesaj / Sorgu</th>
                    <th>Toplam Süre</th>
                    <th>Tarih</th>
                    <th style="text-align: right;">Detay & SQL</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in chatsList)
                {
                    <tr>
                        <td>
                            <div class="fw-bold text-main">
                                @(string.IsNullOrWhiteSpace(item.Chat.Title) ? "Başlıksız Sohbet" : item.Chat.Title)
                            </div>
                            <div class="text-muted" style="font-size: 0.75rem; font-family: monospace;">
                                Chat ID: @item.Chat.Id
                            </div>
                        </td>
                        <td>
                            <span class="text-muted">
                                @(item.Chat.CreatedByUser?.NameSurname ?? item.Chat.CreatedByUser?.Email ?? "Sistem / Anonim")
                            </span>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.PrimaryAiModelName))
                            {
                                <span class="badge-status badge-purple">
                                    <i class="bi bi-cpu"></i> @item.PrimaryAiModelName
                                </span>
                            }
                            else
                            {
                                <span class="text-muted small">-</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge-status badge-info">
                                    @item.MessageCount Mesaj
                                </span>
                                <span class="badge-status badge-success">
                                    @item.QueryCount SQL
                                </span>
                            </div>
                        </td>
                        <td>
                            <span class="text-muted small">
                                @(item.TotalDurationMs > 0 ? $"{item.TotalDurationMs} ms" : "-")
                            </span>
                        </td>
                        <td>
                            <span class="text-muted" style="font-size: 0.85rem;">
                                @(item.Chat.DateCreated?.ToString("dd.MM.yyyy HH:mm") ?? "-")
                            </span>
                        </td>
                        <td style="text-align: right;">
                            <button class="btn btn-sm btn-primary-custom" @onclick="() => InspectChat(item.Chat.Id)">
                                <i class="bi bi-code-square"></i> Mesajlar & SQL Oku
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter]
    public string TenantId { get; set; } = string.Empty;

    private OzBiTenant? tenant;
    private List<ChatAuditSummary>? chatsList;
    private string searchTerm = string.Empty;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            tenant = await AuditService.GetTenantByIdAsync(TenantId);
            chatsList = await AuditService.GetChatsForTenantAsync(TenantId, searchTerm);
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error loading chats: " + ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleSearch(KeyboardEventArgs e)
    {
        await LoadData();
    }

    private void InspectChat(string chatId)
    {
        Navigation.NavigateTo($"/chat/{chatId}");
    }
}
