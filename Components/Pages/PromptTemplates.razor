        border-radius: 6px;
    }

    .usage-count-text {
        font-size: 0.7rem;
        color: var(--text-dim);
    }

    /* Copy Button (Sleek & Clean) */
    .btn-clean-copy {
        background: rgba(99, 102, 241, 0.1);
        border: 1px solid rgba(99, 102, 241, 0.25);
        color: #a5b4fc;
        font-size: 0.775rem;
        font-weight: 600;
        padding: 0.35rem 0.8rem;
        border-radius: 8px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        transition: all 0.2s ease;
    }

    .btn-clean-copy:hover {
