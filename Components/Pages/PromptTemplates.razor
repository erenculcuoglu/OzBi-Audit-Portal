    .btn-fav-icon.active {
        color: #fbbf24;
    }

    /* Alternative Phrasings (Subtle Minimalist Area) */
    .alt-toggle-btn {
        opacity: 0.75;
        transition: opacity 0.15s ease;
    }

    .alt-toggle-btn:hover {
        opacity: 1;
    }

    .alt-phrasings-list {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        padding-left: 0.5rem;
        border-left: 2px solid rgba(99, 102, 241, 0.25);
    }

    .alt-phrase-item {
        background: rgba(0, 0, 0, 0.15);
        border-radius: 6px;
        padding: 0.35rem 0.65rem;
    }
</style>

@code {
    private List<PromptTemplate>? questions;
    private List<PromptTemplate>? filteredQuestions;
    private List<TemplateCategoryInfo>? categories;
    private PromptCategoryType selectedCategory = PromptCategoryType.All;
    private QuestionOriginType selectedOrigin = QuestionOriginType.All;
    private string searchQuery = "";
    private bool onlyFavorited = false;
    private bool isLoading = true;
    private bool isGenerating = false;
    private int currentPortalUserId = 1;

    private HashSet<string> expandedQuestionIds = new();
    private HashSet<string> copiedIds = new();

    private bool showAddModal = false;
    private CustomPromptTemplateItem newCustomItem = new()
    {
        CategoryId = 1,
        OriginTypeId = 1
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrentUserAsync();
        await LoadData();
    }

    private async Task LoadCurrentUserAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity?.IsAuthenticated == true)
            {
                var idClaim = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
                if (int.TryParse(idClaim, out var pId) && pId > 0)
                {
                    currentPortalUserId = pId;
                }
            }
        }
        catch { }
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            // Single DB call: get all questions, then derive category summary from same data
            questions = await TemplateService.GetAllQuestionsAsync(
                portalUserId: currentPortalUserId
            );
            categories = TemplateService.GetCategoriesSummary(questions);
            ApplyFilters();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error loading questions: " + ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task GenerateAndRefresh()
    {
        if (isGenerating) return;
        isGenerating = true;
        StateHasChanged();

        try
        {
            // Synthesize fresh, brand-new Logo & Mikro questions dynamically
            await Task.Delay(300); // Smooth visual feedback
            questions = await TemplateService.GenerateFreshDynamicQuestionsAsync(
                count: 6,
                category: selectedCategory,
                portalUserId: currentPortalUserId
            );
            categories = await TemplateService.GetCategoriesSummaryAsync();
            ApplyFilters();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error generating dynamic questions: " + ex.Message);
        }
        finally
        {
            isGenerating = false;
            StateHasChanged();
        }
    }

    private void SelectCategory(PromptCategoryType category)
    {
        selectedCategory = category;
        ApplyFilters();
    }

    private void SelectOrigin(QuestionOriginType origin)
    {
        selectedOrigin = origin;
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        if (questions == null) return;

        var query = questions.AsEnumerable();

        if (selectedCategory != PromptCategoryType.All)
        {
            query = query.Where(q => q.Category == selectedCategory);
        }

        if (selectedOrigin != QuestionOriginType.All)
        {
            query = query.Where(q => q.OriginType == selectedOrigin);
        }

        if (onlyFavorited)
        {
            query = query.Where(q => q.IsFavorited);
        }

        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            var st = searchQuery.Trim().ToLowerInvariant();
            query = query.Where(q =>
                q.Title.ToLowerInvariant().Contains(st) ||
                q.Prompt.ToLowerInvariant().Contains(st) ||
                q.TargetRole.ToLowerInvariant().Contains(st) ||
                q.AlternativePhrasings.Any(a => a.ToLowerInvariant().Contains(st)) ||
                q.Tags.Any(t => t.ToLowerInvariant().Contains(st))
            );
        }

        filteredQuestions = query.ToList();
    }

    private void HandleSearch() => ApplyFilters();

    private void ClearSearch()
    {
        searchQuery = "";
        ApplyFilters();
    }

    private void ResetFilters()
    {
        selectedCategory = PromptCategoryType.All;
        selectedOrigin = QuestionOriginType.All;
        searchQuery = "";
        onlyFavorited = false;
        ApplyFilters();
    }

    private void ToggleExpand(string id)
    {
        if (expandedQuestionIds.Contains(id))
            expandedQuestionIds.Remove(id);
        else
            expandedQuestionIds.Add(id);
    }

    private async Task CopyText(string text, string elementId)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
            copiedIds.Add(elementId);
            StateHasChanged();

            _ = Task.Delay(2000).ContinueWith(_ =>
            {
                copiedIds.Remove(elementId);
                InvokeAsync(StateHasChanged);
            });
        }
        catch { }
    }

    private async Task ToggleFavorite(PromptTemplate q)
    {
        var effectiveUserId = currentPortalUserId > 0 ? currentPortalUserId : 1;

        // Persist into SQLite Favorites table
        q.IsFavorited = await AuditService.ToggleFavoriteAsync(
            effectiveUserId,
            "PromptTemplate",
            q.Id,
            q.Prompt,
            q.CategoryName
        );

        if (onlyFavorited && !q.IsFavorited)
        {
            ApplyFilters();
        }
        StateHasChanged();
    }

    private void OpenAddModal()
    {
        newCustomItem = new CustomPromptTemplateItem
        {
            CategoryId = 1,
            OriginTypeId = 1,
            CreatedByPortalUserId = currentPortalUserId
        };
        showAddModal = true;
    }

    private void CloseAddModal() => showAddModal = false;

    private async Task SaveCustomQuestion()
    {
        if (string.IsNullOrWhiteSpace(newCustomItem.Prompt))
            return;

        if (string.IsNullOrWhiteSpace(newCustomItem.Title))
            newCustomItem.Title = newCustomItem.Prompt;

        newCustomItem.CreatedByPortalUserId = currentPortalUserId;
        await TemplateService.AddCustomQuestionAsync(newCustomItem);
        showAddModal = false;
        await LoadData();
    }

    private async Task DeleteCustomQuestion(PromptTemplate q)
    {
        if (!q.IsCustom) return;
        var deleted = await TemplateService.DeleteCustomQuestionAsync(q.Id, currentPortalUserId);
        if (deleted)
        {
            await LoadData();
        }
    }
}
