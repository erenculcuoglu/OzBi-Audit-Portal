@page "/ozbi-users"
@inject IOzBiAuditService AuditService
@inject NavigationManager Navigation
@using OzBiPortalCRM.Services
@using OzBiPortalCRM.Models

<div class="mb-4 d-flex align-items-center justify-content-between flex-wrap gap-3">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-person-lines-fill text-primary me-2"></i>Kullanıcı Ayak İzi ve Favoriler</h2>
        <p class="text-muted small mb-0">Sisteme kayıtlı OzBI kullanıcıları, etkileşim sayıları, sohbet geçmişi ve favoriler</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <button class="btn @(showFavoritesOnly ? "btn-warning" : "btn-outline-secondary") btn-sm" @onclick="ToggleFavoritesOnlyFilter">
            <i class="bi @(showFavoritesOnly ? "bi-star-fill" : "bi-star")"></i>
            @(showFavoritesOnly ? "Favoriler Gösteriliyor" : "Sadece Favoriler")
        </button>

        <button class="btn btn-outline-secondary btn-sm" @onclick="LoadData">
            <i class="bi bi-arrow-clockwise"></i> Yenile
        </button>
    </div>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger p-3 mb-4" style="border-radius: var(--radius-md);">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMessage
    </div>
}

<!-- Metrics Summary -->
<div class="metrics-grid mb-4">
    <div class="metric-card">
        <div class="metric-icon" style="background: rgba(99, 102, 241, 0.15); color: var(--primary);">
            <i class="bi bi-people"></i>
        </div>
        <div>
            <div class="metric-val">@(usersList?.Count ?? 0)</div>
            <div class="metric-lbl">Toplam Kullanıcı</div>
        </div>
    </div>

    <div class="metric-card">
        <div class="metric-icon" style="background: rgba(245, 158, 11, 0.15); color: var(--warning);">
            <i class="bi bi-star"></i>
        </div>
        <div>
            <div class="metric-val">@favoritedCount</div>
            <div class="metric-lbl">Favori Kullanıcılar</div>
        </div>
    </div>

    <div class="metric-card">
        <div class="metric-icon" style="background: rgba(16, 185, 129, 0.15); color: var(--success);">
            <i class="bi bi-chat-left-text"></i>
        </div>
        <div>
            <div class="metric-val">@totalChats</div>
            <div class="metric-lbl">Oluşturulan Sohbetler</div>
        </div>
    </div>

    <div class="metric-card">
        <div class="metric-icon" style="background: rgba(6, 182, 212, 0.15); color: var(--accent);">
            <i class="bi bi-terminal-code"></i>
        </div>
        <div>
            <div class="metric-val">@totalQueries</div>
            <div class="metric-lbl">Üretilen SQL Sorguları</div>
        </div>
    </div>
</div>

<!-- Search & Filter Bar -->
<div class="glass-card mb-4">
    <div class="row g-3 align-items-center">
        <div class="col-md-8">
            <div class="input-group">
                <span class="input-group-text bg-dark border-secondary text-muted"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control input-custom" placeholder="Kullanıcı adı, ad soyad veya e-posta ile ara..." @bind="searchTerm" @bind:event="oninput" @onkeyup="HandleSearch" />
            </div>
        </div>
        <div class="col-md-4 text-end">
            <span class="text-muted small">Gösterilen: <strong>@(usersList?.Count ?? 0)</strong> kullanıcı</span>
        </div>
    </div>
</div>

<!-- Users Footprint Table -->
@if (isLoading)
{
    <div class="glass-card text-center py-5">
        <div class="spinner-border text-primary mb-3" role="status"></div>
        <div class="text-muted">OzBI kullanıcı ayak izi yükleniyor...</div>
    </div>
}
else if (usersList == null || usersList.Count == 0)
{
    <div class="glass-card text-center py-5">
        <i class="bi bi-person-badge text-muted" style="font-size: 3rem;"></i>
        <h5 class="mt-3 text-muted">Aramanıza uygun kullanıcı bulunamadı</h5>
    </div>
}
else
{
    <div class="custom-table-wrapper">
        <table class="custom-table">
            <thead>
                <tr>
                    <th style="width: 40px;">Favori</th>
                    <th>Kullanıcı Ad Soyad</th>
                    <th>E-posta Adresi</th>
                    <th>Bağlı Tenant / Firma</th>
                    <th>Chat Sayısı</th>
                    <th>SQL Sorguları</th>
                    <th>Son Aktivite</th>
                    <th style="text-align: right;">İşlem</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in usersList)
                {
                    <tr>
                        <td style="text-align: center;">
                            <button class="btn btn-link p-0 text-decoration-none fs-5" @onclick="() => ToggleFavorite(item)">
                                <i class="bi @(item.IsFavorited ? "bi-star-fill text-warning" : "bi-star text-muted opacity-50")"></i>
                            </button>
                        </td>
                        <td>
                            <div class="fw-bold text-main">@(string.IsNullOrEmpty(item.User.NameSurname) ? (item.User.UserName ?? item.User.Email) : item.User.NameSurname)</div>
                            @if (item.User.IsTenantOwner)
                            {
                                <span class="badge bg-purple bg-opacity-20 text-purple border border-purple border-opacity-30" style="font-size: 0.65rem;">
                                    Tenant Sahibi
                                </span>
                            }
                        </td>
                        <td>
                            <code>@(string.IsNullOrEmpty(item.User.Email) ? "-" : item.User.Email)</code>
                        </td>
                        <td>
                            <span class="text-muted small"><i class="bi bi-building"></i> @item.TenantName</span>
                        </td>
                        <td>
                            <span class="badge-status badge-purple">
                                <i class="bi bi-chat-text"></i> @item.TotalChats Sohbet
                            </span>
                        </td>
                        <td>
                            <span class="badge-status badge-info">
                                <i class="bi bi-code-slash"></i> @item.TotalQueries SQL
                            </span>
                        </td>
                        <td>
                            <span class="text-muted small">
                                @(item.LastActivityDate?.ToString("dd.MM.yyyy HH:mm") ?? "-")
                            </span>
                        </td>
                        <td style="text-align: right;">
                            <button class="btn btn-sm btn-primary-custom px-3" @onclick="() => InspectUserChats(item.User.Id)">
                                <i class="bi bi-eye"></i> İncele
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<UserAuditSummary>? rawUsersList;
    private List<UserAuditSummary>? usersList;
    private string searchTerm = string.Empty;
    private string? errorMessage;
    private bool isLoading = true;
    private bool showFavoritesOnly = false;

    private int favoritedCount = 0;
    private int totalChats = 0;
    private int totalQueries = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            rawUsersList = await AuditService.GetUsersFootprintSummaryAsync(searchTerm, portalUserId: 1);
            ApplyFilters();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ApplyFilters()
    {
        if (rawUsersList == null) return;

        var list = rawUsersList.AsEnumerable();

        if (showFavoritesOnly)
        {
            list = list.Where(u => u.IsFavorited);
        }

        usersList = list.OrderByDescending(u => u.IsFavorited).ThenByDescending(u => u.TotalChats).ToList();

        favoritedCount = rawUsersList.Count(u => u.IsFavorited);
        totalChats = usersList.Sum(u => u.TotalChats);
        totalQueries = usersList.Sum(u => u.TotalQueries);
    }

    private async Task ToggleFavorite(UserAuditSummary item)
    {
        item.IsFavorited = await AuditService.ToggleFavoriteAsync(
            portalUserId: 1,
            itemType: "User",
            itemId: item.User.Id,
            itemName: item.User.NameSurname ?? item.User.Email ?? item.User.Id,
            itemSubText: item.TenantName
        );

        ApplyFilters();
    }

    private void ToggleFavoritesOnlyFilter()
    {
        showFavoritesOnly = !showFavoritesOnly;
        ApplyFilters();
    }

    private async Task HandleSearch(KeyboardEventArgs e)
    {
        await LoadData();
    }

    private void InspectUserChats(string userId)
    {
        var targetUser = rawUsersList?.FirstOrDefault(u => u.User.Id == userId);
        if (targetUser != null && !string.IsNullOrEmpty(targetUser.User.TenantId))
        {
            Navigation.NavigateTo($"/tenant/{targetUser.User.TenantId}/chats");
        }
    }
}
