@page "/"
@page "/tenants"
@inject IOzBiAuditService AuditService
@inject NavigationManager Navigation
@using OzBiPortalCRM.Services
@using OzBiPortalCRM.Models

<div class="mb-4 d-flex align-items-center justify-content-between flex-wrap gap-3">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-buildings text-primary me-2"></i>Tenant Seçimi ve Denetim</h2>
        <p class="text-muted small mb-0">OzBI veritabanındaki aktif tenant'lar, sohbet sayıları ve sorgu metrikleri</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <button class="btn @(showFavoritesOnly ? "btn-warning" : "btn-outline-secondary") btn-sm" @onclick="ToggleFavoritesOnlyFilter">
            <i class="bi @(showFavoritesOnly ? "bi-star-fill" : "bi-star")"></i>
            @(showFavoritesOnly ? "Favoriler Gösteriliyor" : "Sadece Favoriler")
        </button>

        <button class="btn btn-outline-secondary btn-sm" @onclick="LoadData">
            <i class="bi bi-arrow-clockwise"></i> Yenile
        </button>
    </div>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger p-3 mb-4" style="border-radius: var(--radius-md); border-left: 4px solid #ef4444;">
        <div class="d-flex align-items-start gap-2 mb-2">
            <i class="bi bi-exclamation-triangle-fill fs-4 text-danger"></i>
            <div>
                <div class="fw-bold fs-6">Veritabanı Bağlantı / Sorgu Uyarısı</div>
                <div class="small text-light opacity-90 mt-1">@errorMessage</div>
            </div>
        </div>
    </div>
}

<!-- Metrics Summary -->
<div class="metrics-grid">
    <div class="metric-card">
        <div class="metric-icon" style="background: rgba(99, 102, 241, 0.15); color: var(--primary);">
            <i class="bi bi-building"></i>
        </div>
        <div>
            <div class="metric-val">@(tenantsList?.Count ?? 0)</div>
            <div class="metric-lbl">Toplam Tenant</div>
        </div>
    </div>

    <div class="metric-card">
        <div class="metric-icon" style="background: rgba(16, 185, 129, 0.15); color: var(--success);">
            <i class="bi bi-chat-left-text"></i>
        </div>
        <div>
            <div class="metric-val">@totalChats</div>
            <div class="metric-lbl">Toplam Sohbet (Chat)</div>
        </div>
    </div>

    <div class="metric-card">
        <div class="metric-icon" style="background: rgba(6, 182, 212, 0.15); color: var(--accent);">
            <i class="bi bi-code-slash"></i>
        </div>
        <div>
            <div class="metric-val">@totalQueries</div>
            <div class="metric-lbl">Üretilen SQL Sorguları</div>
        </div>
    </div>

    <div class="metric-card">
        <div class="metric-icon" style="background: rgba(245, 158, 11, 0.15); color: var(--warning);">
            <i class="bi bi-chat-square-dots"></i>
        </div>
        <div>
            <div class="metric-val">@totalMessages</div>
            <div class="metric-lbl">Toplam AI Mesajı</div>
        </div>
    </div>
</div>

<!-- Search & Filters -->
<div class="glass-card mb-4">
    <div class="row g-3 align-items-center">
        <div class="col-md-8">
            <div class="input-group">
                <span class="input-group-text bg-dark border-secondary text-muted"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control input-custom" placeholder="Tenant adı, e-posta adresi veya Tenant ID ile ara..." @bind="searchTerm" @bind:event="oninput" @bind:after="ApplyFiltersAndSorting" />
                @if (!string.IsNullOrEmpty(searchTerm))
                {
                    <button class="btn btn-outline-secondary" type="button" @onclick="ClearSearch" title="Temizle">
                        <i class="bi bi-x-lg"></i>
                    </button>
                }
            </div>
        </div>
        <div class="col-md-4 text-end">
            <span class="text-muted small">Gösterilen: <strong>@(tenantsList?.Count ?? 0)</strong> kayıt</span>
        </div>
    </div>
</div>

<!-- Tenants Table -->
@if (isLoading)
{
    <div class="glass-card text-center py-5">
        <div class="spinner-border text-primary mb-3" role="status"></div>
        <div class="text-muted">Tenant verileri yükleniyor...</div>
    </div>
}
else if (tenantsList == null || tenantsList.Count == 0)
{
    <div class="glass-card text-center py-5">
        <i class="bi bi-building-x text-muted" style="font-size: 3rem;"></i>
        <h5 class="mt-3 text-muted">Aramanıza uygun Tenant bulunamadı</h5>
    </div>
}
else
{
    <div class="custom-table-wrapper">
        <table class="custom-table">
            <thead>
                <tr>
                    <th style="width: 70px; cursor: pointer; white-space: nowrap; text-align: center;" @onclick='() => SortBy("IsFavorited")'>
                        <div class="d-inline-flex align-items-center justify-content-center gap-1">
                            <span>Favori</span> @GetSortIcon("IsFavorited")
                        </div>
                    </th>
                    <th style="cursor: pointer; white-space: nowrap;" @onclick='() => SortBy("Name")'>
                        <div class="d-inline-flex align-items-center gap-1">
                            <span>Tenant Adı</span> @GetSortIcon("Name")
                        </div>
                    </th>
                    <th style="cursor: pointer; white-space: nowrap;" @onclick='() => SortBy("Email")'>
                        <div class="d-inline-flex align-items-center gap-1">
                            <span>E-posta</span> @GetSortIcon("Email")
                        </div>
                    </th>
                    <th style="cursor: pointer; white-space: nowrap;" @onclick='() => SortBy("IsActive")'>
                        <div class="d-inline-flex align-items-center gap-1">
                            <span>Durum</span> @GetSortIcon("IsActive")
                        </div>
                    </th>
                    <th style="cursor: pointer; white-space: nowrap;" @onclick='() => SortBy("TotalChats")'>
                        <div class="d-inline-flex align-items-center gap-1">
                            <span>Chat Sayısı</span> @GetSortIcon("TotalChats")
                        </div>
                    </th>
                    <th style="cursor: pointer; white-space: nowrap;" @onclick='() => SortBy("TotalQueries")'>
                        <div class="d-inline-flex align-items-center gap-1">
                            <span>SQL Sorguları</span> @GetSortIcon("TotalQueries")
                        </div>
                    </th>
                    <th style="cursor: pointer; white-space: nowrap;" @onclick='() => SortBy("LastActivityDate")'>
                        <div class="d-inline-flex align-items-center gap-1">
                            <span>Son Aktivite</span> @GetSortIcon("LastActivityDate")
                        </div>
                    </th>
                    <th style="cursor: pointer; white-space: nowrap;" @onclick='() => SortBy("TotalLogins")'>
                        <div class="d-inline-flex align-items-center gap-1">
                            <span>Login Sayısı</span> @GetSortIcon("TotalLogins")
                        </div>
                    </th>
                    <th class="col-sticky-action" style="white-space: nowrap; text-align: center;">İşlem</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in tenantsList)
                {
                    var t = item.Tenant;
                    <tr>
                        <td class="text-center" style="width: 50px;">
                            <button class="btn btn-link p-0 text-warning border-0" @onclick="() => ToggleFavorite(item)" title="@(item.IsFavorited ? "Favorilerden Çıkar" : "Favorilere Ekle")">
                                <i class="bi @(item.IsFavorited ? "bi-star-fill" : "bi-star text-muted opacity-50") fs-5"></i>
                            </button>
                        </td>
                        <td>
                            <div class="fw-bold text-main">@(t.Name ?? "İsimsiz Tenant")</div>
                            <div class="text-dim small font-monospace" style="font-size: 0.75rem;">ID: @t.Id</div>
                        </td>
                        <td class="text-muted small">
                            @(t.Email ?? "-")
                        </td>
                        <td>
                            @if (t.IsActive)
                            {
                                <span class="badge-status badge-success"><i class="bi bi-check-circle me-1"></i>Aktif</span>
                            }
                            else
                            {
                                <span class="badge-status badge-danger"><i class="bi bi-x-circle me-1"></i>Pasif</span>
                            }
                        </td>
                        <td class="text-center">
                            <span class="badge-status badge-info"><i class="bi bi-chat-left-text me-1"></i>@item.TotalChats</span>
                        </td>
                        <td class="text-center">
                            <span class="badge-status badge-warning"><i class="bi bi-code-slash me-1"></i>@item.TotalQueries / 50 SQL</span>
                        </td>
                        <td class="text-muted small">
                            @(item.LastActivityDate?.ToString("dd.MM.yyyy HH:mm") ?? "-")
                        </td>
                        <td class="text-center">
                            <span class="badge-status badge-success"><i class="bi bi-box-arrow-in-right me-1"></i>@item.TotalLogins</span>
                        </td>
                        <td class="text-end" style="padding-right: 1.25rem;">
                            <button class="btn btn-sm btn-primary-custom" @onclick="() => SelectTenant(t.Id)">
                                <i class="bi bi-eye me-1"></i> İncele
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<TenantAuditSummary>? rawTenantsList;
    private List<TenantAuditSummary>? tenantsList;
    private bool isLoading = true;
    private string? errorMessage;
    private string searchTerm = string.Empty;
    private bool showFavoritesOnly = false;

    private string sortColumn = "LastActivityDate";
    private bool sortAscending = false;

    private int totalChats = 0;
    private int totalQueries = 0;
    private int totalMessages = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            rawTenantsList = await AuditService.GetTenantsSummaryAsync(searchTerm: null, portalUserId: 1);
            ApplyFiltersAndSorting();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ClearSearch()
    {
        searchTerm = string.Empty;
        ApplyFiltersAndSorting();
    }

    private void ApplyFiltersAndSorting()
    {
        if (rawTenantsList == null) return;

        var list = rawTenantsList.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var term = searchTerm.Trim();
            list = list.Where(t =>
                (t.Tenant.Name != null && t.Tenant.Name.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                (t.Tenant.Email != null && t.Tenant.Email.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                (t.Tenant.Id != null && t.Tenant.Id.Contains(term, StringComparison.OrdinalIgnoreCase))
            );
        }

        if (showFavoritesOnly)
        {
            list = list.Where(t => t.IsFavorited);
        }

        // Apply dynamic column sorting
        list = sortColumn switch
        {
            "IsFavorited" => sortAscending ? list.OrderBy(t => t.IsFavorited) : list.OrderByDescending(t => t.IsFavorited),
            "Name" => sortAscending ? list.OrderBy(t => t.Tenant.Name) : list.OrderByDescending(t => t.Tenant.Name),
            "Email" => sortAscending ? list.OrderBy(t => t.Tenant.Email) : list.OrderByDescending(t => t.Tenant.Email),
            "IsActive" => sortAscending ? list.OrderBy(t => t.Tenant.IsActive) : list.OrderByDescending(t => t.Tenant.IsActive),
            "TotalChats" => sortAscending ? list.OrderBy(t => t.TotalChats) : list.OrderByDescending(t => t.TotalChats),
            "TotalQueries" => sortAscending ? list.OrderBy(t => t.TotalQueries) : list.OrderByDescending(t => t.TotalQueries),
            "LastActivityDate" => sortAscending ? list.OrderBy(t => t.LastActivityDate ?? DateTime.MinValue) : list.OrderByDescending(t => t.LastActivityDate ?? DateTime.MinValue),
            "TotalLogins" => sortAscending ? list.OrderBy(t => t.TotalLogins) : list.OrderByDescending(t => t.TotalLogins),
            _ => list.OrderByDescending(t => t.LastActivityDate ?? DateTime.MinValue)
        };

        tenantsList = list.ToList();

        totalChats = tenantsList.Sum(t => t.TotalChats);
        totalQueries = tenantsList.Sum(t => t.TotalQueries);
        totalMessages = tenantsList.Sum(t => t.TotalMessages);
    }

    private void SortBy(string columnName)
    {
        if (sortColumn == columnName)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortColumn = columnName;
            // Default to descending for numbers & dates, ascending for text
            sortAscending = (columnName == "Name" || columnName == "Email");
        }

        ApplyFiltersAndSorting();
    }

    private MarkupString GetSortIcon(string columnName)
    {
        if (sortColumn != columnName)
        {
            return new MarkupString("<i class=\"bi bi-arrow-down-up text-muted opacity-25 ms-1\" style=\"font-size: 0.75rem;\"></i>");
        }

        var iconClass = sortAscending ? "bi-arrow-up text-primary fw-bold ms-1" : "bi-arrow-down text-primary fw-bold ms-1";
        return new MarkupString($"<i class=\"bi {iconClass}\"></i>");
    }

    private async Task ToggleFavorite(TenantAuditSummary item)
    {
        item.IsFavorited = await AuditService.ToggleFavoriteAsync(
            portalUserId: 1,
            itemType: "Tenant",
            itemId: item.Tenant.Id,
            itemName: item.Tenant.Name,
            itemSubText: item.Tenant.Email
        );

        ApplyFiltersAndSorting();
    }

    private void ToggleFavoritesOnlyFilter()
    {
        showFavoritesOnly = !showFavoritesOnly;
        ApplyFiltersAndSorting();
    }

    private void SelectTenant(string tenantId)
    {
        Navigation.NavigateTo($"/tenant/{tenantId}/chats");
    }
}
