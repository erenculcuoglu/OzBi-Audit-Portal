@code {
    private List<OzBiChatMessage>? feedbackItems;
    private List<TenantAuditSummary>? tenantsList;
    private FeedbackAuditStats? stats;

    private bool isLoading = true;
    private string searchQuery = string.Empty;
    private string selectedTenantId = string.Empty;
    private string filterType = "disliked"; // "disliked", "comments_only", "all", "liked_only", "failed_disliked"

    private HashSet<string> expandedMessageIds = new();
    private HashSet<string> pushedMessageIds = new();
    private HashSet<string> pushingMessageIds = new();
    private bool isPushingAll = false;
    private string? alertMessage;
    private string alertType = "success";

    // Compliance Modal
    private bool isComplianceModalOpen = false;
    private MikroComplianceReport? selectedComplianceReport;
    private string selectedTestedSql = string.Empty;

    public class FeedSqlItem
    {
        public string Description { get; set; } = string.Empty;
        public string Sql { get; set; } = string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            tenantsList = await AuditService.GetTenantsSummaryAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error loading tenants for filter: " + ex.Message);
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            var tenantFilter = string.IsNullOrWhiteSpace(selectedTenantId) ? null : selectedTenantId;
            stats = await AuditService.GetFeedbackStatsAsync(tenantFilter);
            feedbackItems = await AuditService.GetCustomerFeedbacksAsync(
                tenantId: tenantFilter,
                searchTerm: searchQuery,
                filterType: filterType,
                maxResults: 150);

            try
            {
                pushedMessageIds = await FeedbackMonitorService.GetPushedMessageIdsAsync();
            }
            catch (Exception ex)
            {
                Console.WriteLine("Error loading pushed feedback IDs: " + ex.Message);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error loading feedbacks: " + ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task PushSingleFeedbackToSlack(OzBiChatMessage item)
    {
        if (pushingMessageIds.Contains(item.Id)) return;

        pushingMessageIds.Add(item.Id);
        StateHasChanged();

        try
        {
            var success = await FeedbackMonitorService.PushFeedbackByIdAsync(item.Id, "CRM_User");
            if (success)
            {
                pushedMessageIds.Add(item.Id);
                alertType = "success";
                alertMessage = $"\"{item.Chat?.Tenant?.Name ?? "Tenant"}\" müşterisinin geri bildirimi Slack #customer-feedback kanalına başarıyla iletildi!";
            }
            else
            {
                alertType = "danger";
                alertMessage = "Slack bildirimi gönderilemedi. Lütfen webhook yapılandırmasını kontrol edin.";
            }
        }
        catch (Exception ex)
        {
            alertType = "danger";
            alertMessage = "Hata oluştu: " + ex.Message;
        }
        finally
        {
            pushingMessageIds.Remove(item.Id);
            StateHasChanged();
        }
    }

    private async Task PushUnpushedToSlack()
    {
        if (isPushingAll) return;

        isPushingAll = true;
        alertMessage = null;
        StateHasChanged();

        try
        {
            var count = await FeedbackMonitorService.CheckAndPushNewFeedbacksAsync(pushAllUnpushed: true, triggeredBy: "CRM_BulkPush");
            pushedMessageIds = await FeedbackMonitorService.GetPushedMessageIdsAsync();
            alertType = "success";
            alertMessage = $"{count} adet müşteri geri bildirimi Slack #customer-feedback kanalına başarıyla iletildi.";
        }
        catch (Exception ex)
        {
            alertType = "danger";
            alertMessage = "Toplu bildirim gönderilirken hata oluştu: " + ex.Message;
        }
        finally
        {
            isPushingAll = false;
            StateHasChanged();
        }
    }

    private async Task SetFilterType(string newType)
    {
        filterType = newType;
        await LoadData();
    }

    private async Task HandleSearch(KeyboardEventArgs e)
    {
        await LoadData();
    }

    private void ToggleMessageExpansion(string msgId)
    {
        if (expandedMessageIds.Contains(msgId))
        {
            expandedMessageIds.Remove(msgId);
        }
        else
        {
            expandedMessageIds.Add(msgId);
        }
    }

    private void OpenComplianceModal(MikroComplianceReport report, string sql)
    {
        selectedComplianceReport = report;
        selectedTestedSql = sql;
        isComplianceModalOpen = true;
    }

    private string GetScoreColor(int score)
    {
        if (score >= 90) return "#10b981"; // Green
        if (score >= 75) return "#3b82f6"; // Blue
        if (score >= 60) return "#f59e0b"; // Yellow/Amber
        return "#ef4444"; // Red
    }

    private async Task CopySql(string text)
    {
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
    }

    private List<FeedSqlItem> ExtractSqlItemsFromQuery(string? rawQuery)
    {
        var result = new List<FeedSqlItem>();
        if (string.IsNullOrWhiteSpace(rawQuery)) return result;

        var trimmed = rawQuery.Trim();

        // Check if JSON array or JSON object
        if ((trimmed.StartsWith("[") && trimmed.EndsWith("]")) || (trimmed.StartsWith("{") && trimmed.EndsWith("}")))
        {
            try
            {
                using var doc = System.Text.Json.JsonDocument.Parse(trimmed);
                if (doc.RootElement.ValueKind == System.Text.Json.JsonValueKind.Array)
                {
                    foreach (var elem in doc.RootElement.EnumerateArray())
                    {
                        var item = ExtractFromElement(elem);
                        if (item != null) result.Add(item);
                    }
                }
                else if (doc.RootElement.ValueKind == System.Text.Json.JsonValueKind.Object)
                {
                    var item = ExtractFromElement(doc.RootElement);
                    if (item != null) result.Add(item);
                }
            }
            catch
            {
                // Fallback to raw string
            }
        }

        if (result.Count == 0 && !string.IsNullOrWhiteSpace(trimmed))
        {
            result.Add(new FeedSqlItem
            {
                Description = string.Empty,
                Sql = trimmed
            });
        }

        return result;
    }

    private FeedSqlItem? ExtractFromElement(System.Text.Json.JsonElement elem)
    {
        string desc = string.Empty;
        string sql = string.Empty;

        if (TryGetJsonProp(elem, "description", out var val) ||
            TryGetJsonProp(elem, "Description", out val) ||
            TryGetJsonProp(elem, "summary", out val) ||
            TryGetJsonProp(elem, "title", out val))
        {
            desc = val;
        }

        if (TryGetJsonProp(elem, "sql", out var sqlVal) ||
            TryGetJsonProp(elem, "Sql", out sqlVal) ||
            TryGetJsonProp(elem, "query", out sqlVal) ||
            TryGetJsonProp(elem, "Query", out sqlVal) ||
            TryGetJsonProp(elem, "tSql", out sqlVal))
        {
            sql = sqlVal;
        }

        if (string.IsNullOrWhiteSpace(sql))
        {
            if (elem.ValueKind == System.Text.Json.JsonValueKind.String)
                sql = elem.GetString() ?? string.Empty;
            else
                sql = elem.GetRawText();
        }

        if (string.IsNullOrWhiteSpace(sql)) return null;

        return new FeedSqlItem
        {
            Description = desc,
            Sql = sql
        };
    }

    private bool TryGetJsonProp(System.Text.Json.JsonElement elem, string propName, out string value)
    {
        value = string.Empty;
        if (elem.ValueKind == System.Text.Json.JsonValueKind.Object && elem.TryGetProperty(propName, out var prop))
        {
            if (prop.ValueKind == System.Text.Json.JsonValueKind.String)
            {
                value = prop.GetString() ?? string.Empty;
                return !string.IsNullOrWhiteSpace(value);
            }
        }
        return false;
    }
