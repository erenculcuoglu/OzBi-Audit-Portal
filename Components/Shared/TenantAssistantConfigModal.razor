@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string TenantName { get; set; } = string.Empty;
    [Parameter] public string TenantId { get; set; } = string.Empty;
    [Parameter] public List<OzBiAssistant>? Assistants { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private OzBiAssistant? SelectedAssistant;
    private string activeTab = "SCHEMA";
    private string schemaViewMode = "CATALOG";
    private string schemaSearchTerm = string.Empty;
    private HashSet<string> expandedTables = new();
    private List<ParsedTableInfo> parsedTables = new();

    private bool isJsonCopied = false;
    private bool isPromptCopied = false;
    private bool isAgentPromptCopied = false;

    // 🌟 Logo v8.0 Golden Standard Table Catalog (44 Tables)
    private static readonly HashSet<string> StandardLogoV8Tables = new(StringComparer.OrdinalIgnoreCase)
    {
        "CLCARD", "INVOICE", "STLINE", "PAYTRANS", "KSLINES", "CSROLL", "ORFICHE", "ORFLINE",
        "ITEMS", "GNTOTST", "EMUHACC", "EMFLINE", "EMFICHE", "SRVCARD", "PURCHOFFER", "SALESOFFER",
        "BNKACCREF", "BNFLINE", "BNFICHE", "CSHIST", "CLFLINE", "SPECODES", "UNITSETF", "UNITSETL",
        "PRCLIST", "PAYPLANS", "SLSCLREL", "SLSMAN", "SHIPINFO", "DISTTEMP", "DISTLINE", "PROJECT",
        "KASCARD", "BANKACC", "BNCARD", "ITMCLSF", "CRDREF", "STFICHE", "INVDEF", "EMUHACCREF",
        "L_CAPIFIRM", "L_CAPIWHOUSE", "L_DAILYEXCHANGES", "LG_SLSMAN"
    };

    // 🌟 Mikro v27 Golden Standard Table Catalog (47 Tables)
    private static readonly HashSet<string> StandardMikroV27Tables = new(StringComparer.OrdinalIgnoreCase)
    {
        "CARI_HESAPLAR", "CARI_HESAP_HAREKETLERI", "STOKLAR", "STOK_HAREKETLERI", "SIPARISLER",
        "ODEME_EMIRLERI", "BANKALAR", "KASALAR", "DEPOLAR", "STOK_DEPO_DETAYLARI", "STOK_SATIS_FIYAT_LISTELERI",
        "PERSONELLER", "VERILEN_TEKLIFLER", "STOK_HAREKETLERI_GIRIS_CIKIS", "BANKALAR_YONETIM",
        "MUHASEBE_HESAP_KODLARI", "MUHASEBE_FISLERI", "MUHASEBE_FIS_DETAYLARI", "HIZMET_KARTLARI",
        "MASRAF_KARTLARI", "ODEME_PLANLARI", "SEKTORLER", "BOLGELER", "CARI_HESAP_GRUP_KODLARI",
        "STOK_ANA_GRUPLARI", "STOK_ALT_GRUPLARI", "STOK_URETICILERI", "STOK_SEKTORLERI", "BIRIMLER",
        "ISEM_KARTLARI", "ISEM_HAREKETLERI", "ISEM_ROTA_HAREKETLERI", "ISEM_KAYNAK_HAREKETLERI",
        "KULLANICILAR", "FIRMALAR", "SUBELER", "PROJELER", "SORUMLULUK_MERKEZLERI"
    };

    private string DetectedErpType
    {
        get
        {
            var assistantName = (SelectedAssistant?.Name ?? "").ToUpperInvariant();
            var prompt = (SelectedAssistant?.UserAdditionalPrompt ?? "").ToUpperInvariant();
            var schemaText = (SelectedAssistant?.DatabaseDefinition ?? "").ToUpperInvariant();

            if (assistantName.Contains("LOGO") || prompt.Contains("LOGO") || schemaText.Contains("LG_") || schemaText.Contains("L_CAPI"))
                return "LOGO";

            if (assistantName.Contains("MIKRO") || prompt.Contains("MIKRO") || schemaText.Contains("CARI_HESAPLAR") || schemaText.Contains("STOKLAR"))
                return "MIKRO";

            return "GENERIC";
        }
    }

    private HashSet<string> CurrentStandardTables => DetectedErpType == "MIKRO" ? StandardMikroV27Tables : StandardLogoV8Tables;

    protected override void OnParametersSet()
    {
        if (Assistants != null && Assistants.Count > 0)
        {
            if (SelectedAssistant == null || !Assistants.Any(a => a.Id == SelectedAssistant.Id))
            {
                SelectedAssistant = Assistants.FirstOrDefault(a => a.IsActive) ?? Assistants.First();
                ParseSchema();
            }
        }
    }

    private void SelectAssistant(OzBiAssistant assistant)
    {
        SelectedAssistant = assistant;
        schemaSearchTerm = string.Empty;
        expandedTables.Clear();
        ParseSchema();
    }

    private void ToggleTableExpand(string tableName)
    {
        if (expandedTables.Contains(tableName))
            expandedTables.Remove(tableName);
        else
            expandedTables.Add(tableName);
    }

    private void ParseSchema()
    {
        parsedTables.Clear();
        if (SelectedAssistant == null || string.IsNullOrWhiteSpace(SelectedAssistant.DatabaseDefinition))
            return;

        try
        {
            using var doc = JsonDocument.Parse(SelectedAssistant.DatabaseDefinition);
            if (doc.RootElement.ValueKind == JsonValueKind.Array)
            {
                foreach (var el in doc.RootElement.EnumerateArray())
                {
                    var tableName = el.TryGetProperty("TABLE_NAME", out var tn) ? tn.GetString() ?? "" : "";
                    var type = el.TryGetProperty("Type", out var tp) ? tp.GetString() ?? "TABLE" : "TABLE";
                    var desc = el.TryGetProperty("Description", out var ds) ? ds.GetString() ?? "" : "";
                    
                    var tableInfo = new ParsedTableInfo
                    {
                        TableName = tableName,
                        Type = type,
                        Description = desc
                    };

                    if (el.TryGetProperty("Columns", out var cols) && cols.ValueKind == JsonValueKind.Array)
                    {
                        foreach (var col in cols.EnumerateArray())
                        {
                            var cName = col.TryGetProperty("Name", out var cn) ? cn.GetString() ?? "" : "";
                            var cType = col.TryGetProperty("Type", out var ct) ? ct.GetString() ?? "" : "";
                            var cDesc = col.TryGetProperty("Description", out var cd) ? cd.GetString() ?? "" : "";

                            tableInfo.Columns.Add(new ParsedColumnInfo
                            {
                                Name = cName,
                                Type = cType,
                                Description = cDesc
                            });
                        }
                    }

                    parsedTables.Add(tableInfo);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("[TenantAssistantConfigModal] Error parsing DatabaseDefinition JSON: " + ex.Message);
        }
    }

    private int TotalColumnCount => parsedTables.Sum(t => t.Columns.Count);

    private List<ParsedTableInfo> FilteredTables
    {
        get
        {
            if (string.IsNullOrWhiteSpace(schemaSearchTerm))
                return parsedTables;

            var term = schemaSearchTerm.Trim().ToLowerInvariant();
            return parsedTables.Where(t =>
                t.TableName.ToLowerInvariant().Contains(term) ||
                t.Description.ToLowerInvariant().Contains(term) ||
                t.Columns.Any(c => c.Name.ToLowerInvariant().Contains(term) || c.Description.ToLowerInvariant().Contains(term))
            ).ToList();
        }
    }

    private string FormattedJsonSchema
    {
        get
        {
            if (string.IsNullOrWhiteSpace(SelectedAssistant?.DatabaseDefinition))
                return "{}";

            try
            {
                using var doc = JsonDocument.Parse(SelectedAssistant.DatabaseDefinition);
                return JsonSerializer.Serialize(doc, new JsonSerializerOptions { WriteIndented = true });
            }
            catch
            {
                return SelectedAssistant.DatabaseDefinition;
            }
        }
    }

    private string DetectedPromptVersion
    {
        get
        {
            var prompt = SelectedAssistant?.UserAdditionalPrompt ?? "";
            if (prompt.Contains("v8.0") || prompt.Contains("Yalın & Pozitif Mimari") || prompt.Contains("v8"))
                return "Logo v8.0 Uyumlu (Pozitif Mimari)";
            if (prompt.Contains("v7.5"))
                return "Logo v7.5 Şema Uyumlu";
            if (prompt.Contains("v7.3") || prompt.Contains("v7.0"))
                return "Logo v7.x (Eski Sürüm)";
            if (prompt.Contains("v27") || prompt.Contains("v27.1"))
                return "Mikro v27 Altın Prompt";
            if (prompt.Contains("Mikro") || prompt.Contains("MIKRO"))
                return "Mikro ERP Standart Prompt";
            if (!string.IsNullOrWhiteSpace(prompt))
                return "Özel Yapılandırılmış Prompt";
            return "Prompt Atanmamış";
        }
    }

    private string DetectedPromptVersionClass
    {
        get
        {
            var v = DetectedPromptVersion;
            if (v.Contains("v8.0")) return "badge-v8";
            if (v.Contains("v7.5")) return "badge-v75";
            if (v.Contains("v7.x")) return "badge-old";
            if (v.Contains("Mikro") || v.Contains("v27")) return "badge-mikro";
            if (v.Contains("Özel")) return "badge-custom";
            return "badge-old";
        }
    }

    private List<string> MatchingStandardTables
    {
        get
        {
            var cleanNames = parsedTables.Select(GetCleanTableName).ToHashSet(StringComparer.OrdinalIgnoreCase);
            return cleanNames.Where(n => CurrentStandardTables.Contains(n)).OrderBy(n => n).ToList();
        }
    }

    private List<string> MissingStandardTables
    {
        get
        {
            var cleanNames = parsedTables.Select(GetCleanTableName).ToHashSet(StringComparer.OrdinalIgnoreCase);
            
            if (DetectedErpType == "MIKRO")
            {
                var essentialMikro = new[] { "CARI_HESAPLAR", "CARI_HESAP_HAREKETLERI", "STOKLAR", "STOK_HAREKETLERI", "SIPARISLER", "ODEME_EMIRLERI", "BANKALAR", "KASALAR", "DEPOLAR", "MUHASEBE_HESAP_KODLARI" };
                return essentialMikro.Where(n => !cleanNames.Contains(n)).ToList();
            }
            else
            {
                var essentialLogo = new[] { "CLCARD", "INVOICE", "STLINE", "PAYTRANS", "KSLINES", "CSROLL", "ORFICHE", "ITEMS", "GNTOTST", "EMUHACC" };
                return essentialLogo.Where(n => !cleanNames.Contains(n)).ToList();
            }
        }
    }

    private List<string> ExtraCustomTables
    {
        get
        {
            var cleanNames = parsedTables.Select(GetCleanTableName).ToHashSet(StringComparer.OrdinalIgnoreCase);
            return cleanNames.Where(n => !CurrentStandardTables.Contains(n)).OrderBy(n => n).ToList();
        }
    }

    private string GetCleanTableName(ParsedTableInfo t)
    {
        var name = t.TableName;
        if (name.StartsWith("LG_") || name.StartsWith("lg_"))
        {
            var parts = name.Split('_');
            if (parts.Length >= 3)
            {
                return string.Join("_", parts.Skip(2));
            }
        }
        return name;
    }

    private async Task CopyJsonSchema()
    {
        if (string.IsNullOrEmpty(FormattedJsonSchema)) return;
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", FormattedJsonSchema);
        isJsonCopied = true;
        StateHasChanged();
        _ = Task.Delay(2000).ContinueWith(_ => { isJsonCopied = false; InvokeAsync(StateHasChanged); });
    }

    private async Task CopyAssistantPrompt()
    {
        var text = SelectedAssistant?.UserAdditionalPrompt ?? "";
        if (string.IsNullOrEmpty(text)) return;
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
        isPromptCopied = true;
        StateHasChanged();
        _ = Task.Delay(2000).ContinueWith(_ => { isPromptCopied = false; InvokeAsync(StateHasChanged); });
    }

    private async Task CopyAgentPrompt()
    {
        var text = SelectedAssistant?.UserAdditionalAgentPrompt ?? "";
        if (string.IsNullOrEmpty(text)) return;
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
        isAgentPromptCopied = true;
        StateHasChanged();
        _ = Task.Delay(2000).ContinueWith(_ => { isAgentPromptCopied = false; InvokeAsync(StateHasChanged); });
    }

    private string FormatBytes(int bytes)
    {
        if (bytes <= 0) return "0 B";
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{(bytes / 1024.0):0.0} KB";
        return $"{(bytes / (1024.0 * 1024.0)):0.0} MB";
    }

    private async Task CloseModal()
    {
        await OnClose.InvokeAsync();
    }

    public class ParsedTableInfo
    {
        public string TableName { get; set; } = string.Empty;
        public string Type { get; set; } = "TABLE";
        public string Description { get; set; } = string.Empty;
        public List<ParsedColumnInfo> Columns { get; set; } = new();
    }

    public class ParsedColumnInfo
    {
        public string Name { get; set; } = string.Empty;
        public string Type { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
    }
}
