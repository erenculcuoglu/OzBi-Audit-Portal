@using System.Text.Json
@using OzBiPortalCRM.Models
@using OzBiPortalCRM.Services
@inject IJSRuntime JSRuntime

@if (IsOpen)
{
    <div class="assistant-modal-overlay" @onclick="CloseModal">
        <div class="assistant-modal-dialog" @onclick:stopPropagation>
            
            <!-- 🌟 Modal Top Header -->
            <div class="assistant-modal-header">
                <div class="d-flex align-items-center gap-3 flex-wrap">
                    <!-- ERP Type Badge -->
                    <div class="erp-brand-badge @(DetectedErpType == "LOGO" ? "erp-logo" : (DetectedErpType == "MIKRO" ? "erp-mikro" : "erp-generic"))">
                        @if (DetectedErpType == "LOGO")
                        {
                            <span class="erp-dot"></span>
                            <i class="bi bi-layers-fill me-1"></i>
                            <span>Logo Tiger / Go ERP</span>
                        }
                        else if (DetectedErpType == "MIKRO")
                        {
                            <span class="erp-dot"></span>
                            <i class="bi bi-grid-3x3-gap-fill me-1"></i>
                            <span>Mikro v16 / v17 ERP</span>
                        }
                        else
                        {
                            <span class="erp-dot"></span>
                            <i class="bi bi-database me-1"></i>
                            <span>Genel / Özel ERP</span>
                        }
                    </div>

                    <div class="header-titles">
                        <div class="d-flex align-items-center gap-2">
                            <h3 class="tenant-title mb-0">@TenantName</h3>
                            <span class="tenant-id-pill">ID: @TenantId</span>
                        </div>
                        <div class="header-subtitle">
                            <i class="bi bi-shield-check text-emerald me-1"></i>
                            MariaDB Canlı Şema & Asistan Prompt Denetim Paneli
                        </div>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn-glass-close" @onclick="CloseModal" title="Kapat">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>

            <!-- 🎛️ Assistant Switcher & Live Sync Strip -->
            @if (Assistants != null && Assistants.Count > 0)
            {
                <div class="assistant-selector-strip">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="selector-label"><i class="bi bi-robot me-1 text-cyan"></i>Tanımlı Asistan:</span>
                        <div class="assistant-pill-group">
                            @foreach (var ast in Assistants)
                            {
                                var isSelected = SelectedAssistant?.Id == ast.Id;
                                <button class="assistant-pill-btn @(isSelected ? "active" : "")"
                                        @onclick="() => SelectAssistant(ast)">
                                    <span class="assistant-name">@(string.IsNullOrWhiteSpace(ast.Name) ? "İsimsiz Asistan" : ast.Name)</span>
                                    @if (ast.IsActive)
                                    {
                                        <span class="status-indicator-active" title="Aktif"></span>
                                    }
                                </button>
                            }
                        </div>
                    </div>

                    @if (SelectedAssistant != null)
                    {
                        <div class="sync-timestamp">
                            <i class="bi bi-arrow-repeat text-cyan me-1"></i>
                            <span>Son Güncelleme: </span>
                            <strong>@(SelectedAssistant.DateModified?.ToString("dd.MM.yyyy HH:mm") ?? SelectedAssistant.DateCreated?.ToString("dd.MM.yyyy HH:mm") ?? "-")</strong>
                        </div>
                    }
                </div>
            }

            <!-- 📜 Modal Body Content -->
            <div class="assistant-modal-body">
                @if (IsLoading)
                {
                    <div class="loading-state-box">
                        <div class="spinner-glow mb-3"></div>
                        <div class="loading-text">MariaDB üzerinden asistan ve şema verileri çekiliyor...</div>
                    </div>
                }
                else if (SelectedAssistant == null)
                {
                    <div class="empty-state-box">
                        <i class="bi bi-exclamation-octagon text-amber fs-1 mb-2"></i>
                        <h5>Bu Tenant İçin Tanımlı Asistan Bulunamadı</h5>
                        <p class="text-muted small">MariaDB `asistant` tablosunda bu tenant ID'ye bağlı bir kayıt yer almıyor.</p>
                    </div>
                }
                else
                {
                    <!-- 💎 High-End KPI Stats Cards -->
                    <div class="kpi-grid mb-4">
                        <!-- KPI 1: AI Model -->
                        <div class="kpi-card">
                            <div class="kpi-icon-wrap icon-purple">
                                <i class="bi bi-cpu-fill"></i>
                            </div>
                            <div class="kpi-content">
                                <div class="kpi-label">Yapay Zeka Modeli</div>
                                <div class="kpi-value text-white" title="@SelectedAssistant.AIModelName">
                                    @(SelectedAssistant.AIModelName ?? "GPT-5.6 Terra")
                                </div>
                                <div class="kpi-sub text-cyan">
                                    <i class="bi bi-diagram-2 me-1"></i>@(SelectedAssistant.SubModel ?? "Varsayılan Sub-Model")
                                </div>
                            </div>
                        </div>

                        <!-- KPI 2: JSON Schema -->
                        <div class="kpi-card">
                            <div class="kpi-icon-wrap icon-emerald">
                                <i class="bi bi-database-fill-check"></i>
                            </div>
                            <div class="kpi-content">
                                <div class="kpi-label">Yüklü JSON Şeması</div>
                                <div class="kpi-value text-emerald">
                                    @FormatBytes(SelectedAssistant.DatabaseDefinition?.Length ?? 0)
                                </div>
                                <div class="kpi-sub text-light">
                                    <strong>@parsedTables.Count</strong> Tablo &bull; <strong>@TotalColumnCount</strong> Kolon
                                </div>
                            </div>
                        </div>

                        <!-- KPI 3: Prompt Version -->
                        <div class="kpi-card">
                            <div class="kpi-icon-wrap icon-cyan">
                                <i class="bi bi-chat-quote-fill"></i>
                            </div>
                            <div class="kpi-content">
                                <div class="kpi-label">Asistan Promptu</div>
                                <div class="kpi-value text-cyan">
                                    @FormatBytes(SelectedAssistant.UserAdditionalPrompt?.Length ?? 0)
                                </div>
                                <div class="kpi-sub">
                                    <span class="prompt-ver-badge @DetectedPromptVersionClass">@DetectedPromptVersion</span>
                                </div>
                            </div>
                        </div>

                        <!-- KPI 4: Parameters -->
                        <div class="kpi-card">
                            <div class="kpi-icon-wrap icon-amber">
                                <i class="bi bi-sliders2"></i>
                            </div>
                            <div class="kpi-content">
                                <div class="kpi-label">Model Parametreleri</div>
                                <div class="kpi-value text-amber">
                                    Temp: @(SelectedAssistant.Temperature?.ToString("0.0#") ?? "0.1")
                                </div>
                                <div class="kpi-sub text-muted">
                                    TopP: @(SelectedAssistant.TopP?.ToString("0.0#") ?? "0.95") &bull; Limit: @(SelectedAssistant.LimitSize?.ToString() ?? "50") Satır
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 🚀 Modern 2-Row Segmented Navigation Bar -->
                    <div class="segmented-tabs-wrapper mb-3">
                        <!-- Row 1: Core Content (3 Tabs) -->
                        <div class="segmented-row row-top">
                            <button class="tab-item @(activeTab == "SCHEMA" ? "active" : "")" @onclick="@(() => activeTab = "SCHEMA")">
                                <div class="d-flex align-items-center gap-2 text-truncate">
                                    <i class="bi bi-filetype-json text-cyan fs-6"></i>
                                    <span class="tab-title">1. JSON Veritabanı Şeması</span>
                                </div>
                                <span class="tab-counter">@parsedTables.Count Tablo</span>
                            </button>

                            <button class="tab-item @(activeTab == "PROMPT" ? "active" : "")" @onclick="@(() => activeTab = "PROMPT")">
                                <div class="d-flex align-items-center gap-2 text-truncate">
                                    <i class="bi bi-chat-square-text text-amber fs-6"></i>
                                    <span class="tab-title">2. Asistan Promptu</span>
                                </div>
                                <span class="tab-counter">@FormatBytes(SelectedAssistant.UserAdditionalPrompt?.Length ?? 0)</span>
                            </button>

                            <button class="tab-item @(activeTab == "AGENT" ? "active" : "")" @onclick="@(() => activeTab = "AGENT")">
                                <div class="d-flex align-items-center gap-2 text-truncate">
                                    <i class="bi bi-person-workspace text-purple fs-6"></i>
                                    <span class="tab-title">3. Analist Agent Promptu</span>
                                </div>
                                @if (!string.IsNullOrEmpty(SelectedAssistant.UserAdditionalAgentPrompt))
                                {
                                    <span class="tab-badge-active">Mevcut</span>
                                }
                                else
                                {
                                    <span class="tab-badge-muted">Varsayılan</span>
                                }
                            </button>
                        </div>

                        <!-- Row 2: Settings & Standards Health Audit (2 Tabs) -->
                        <div class="segmented-row row-bottom">
                            <button class="tab-item @(activeTab == "SETTINGS" ? "active" : "")" @onclick="@(() => activeTab = "SETTINGS")">
                                <div class="d-flex align-items-center gap-2 text-truncate">
                                    <i class="bi bi-gear-wide-connected text-light fs-6"></i>
                                    <span class="tab-title">4. Sistem & Model Parametreleri</span>
                                </div>
                                <span class="tab-pill-hint">Limit, Temp, TopP</span>
                            </button>

                            <button class="tab-item tab-health @(activeTab == "DIFF" ? "active" : "")" @onclick="@(() => activeTab = "DIFF")">
                                <div class="d-flex align-items-center gap-2 text-truncate">
                                    <i class="bi bi-shield-check text-emerald fs-6"></i>
                                    <span class="tab-title">5. @(DetectedErpType == "LOGO" ? "Logo v8.0" : (DetectedErpType == "MIKRO" ? "Mikro v27" : "ERP")) Sağlık & Fark Analizi</span>
                                </div>
                                @if (MissingStandardTables.Count > 0)
                                {
                                    <span class="tab-badge-warning">@MissingStandardTables.Count Eksik Tablo</span>
                                }
                                else
                                {
                                    <span class="tab-badge-success"><i class="bi bi-check-all me-1"></i>Tam Uyumlu</span>
                                }
                            </button>
                        </div>
                    </div>

                    <!-- 📄 TAB 1: JSON SCHEMA -->
                    @if (activeTab == "SCHEMA")
                    {
                        <div class="tab-pane-content">
                            <!-- Filter & Action Controls -->
                            <div class="schema-toolbar">
                                <div class="search-box-custom">
                                    <i class="bi bi-search search-icon"></i>
                                    <input type="text" class="search-input" 
                                           placeholder="Tablo veya kolon adı ara (örn: @(DetectedErpType == "LOGO" ? "CLCARD, INVOICE, LOGICALREF" : "CARI_HESAPLAR, STOKLAR, evrak_no"))..." 
                                           @bind="schemaSearchTerm" @bind:event="oninput" />
                                    @if (!string.IsNullOrEmpty(schemaSearchTerm))
                                    {
                                        <button class="clear-search-btn" @onclick="() => schemaSearchTerm = string.Empty">
                                            <i class="bi bi-x-circle-fill"></i>
                                        </button>
                                    }
                                </div>

                                <div class="toolbar-actions">
                                    <div class="view-mode-toggle">
                                        <button class="mode-btn @(schemaViewMode == "CATALOG" ? "active" : "")"
                                                @onclick="@(() => schemaViewMode = "CATALOG")">
                                            <i class="bi bi-grid-fill me-1"></i> Tablo Kataloğu
                                        </button>
                                        <button class="mode-btn @(schemaViewMode == "RAW" ? "active" : "")"
                                                @onclick="@(() => schemaViewMode = "RAW")">
                                            <i class="bi bi-code-slash me-1"></i> Formatlı JSON
                                        </button>
                                    </div>

                                    <button class="btn-copy-action @(isJsonCopied ? "copied" : "")" @onclick="CopyJsonSchema">
                                        <i class="bi @(isJsonCopied ? "bi-check-circle-fill text-emerald" : "bi-clipboard-fill")"></i>
                                        <span>@(isJsonCopied ? "Panoya Kopyalandı!" : "JSON'ı Kopyala")</span>
                                    </button>
                                </div>
                            </div>

                            @if (string.IsNullOrWhiteSpace(SelectedAssistant.DatabaseDefinition))
                            {
                                <div class="empty-schema-notice">
                                    <i class="bi bi-file-earmark-x text-amber fs-2 mb-2"></i>
                                    <div>Bu asistan için `DatabaseDefinition` kolonu boş.</div>
                                </div>
                            }
                            else if (schemaViewMode == "CATALOG")
                            {
                                var filtered = FilteredTables;
                                <div class="catalog-summary-bar">
                                    <span>Görüntülenen: <strong class="text-cyan">@filtered.Count</strong> / @parsedTables.Count Tablo</span>
                                    <span>Filtrelenen Kolon: <strong class="text-white">@filtered.Sum(t => t.Columns.Count)</strong></span>
                                </div>

                                <div class="table-cards-list">
                                    @foreach (var table in filtered)
                                    {
                                        var isExpanded = expandedTables.Contains(table.TableName);
                                        <div class="table-accordion-card @(isExpanded ? "expanded" : "")">
                                            <div class="table-card-header" @onclick="() => ToggleTableExpand(table.TableName)">
                                                <div class="d-flex align-items-center gap-2.5 flex-wrap">
                                                    <div class="accordion-chevron">
                                                        <i class="bi @(isExpanded ? "bi-chevron-down" : "bi-chevron-right")"></i>
                                                    </div>
                                                    <span class="table-name-code">@table.TableName</span>
                                                    <span class="table-type-tag">@table.Type</span>
                                                    @if (!string.IsNullOrEmpty(table.Description))
                                                    {
                                                        <span class="table-desc-text">&bull; @table.Description</span>
                                                    }
                                                </div>
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="column-count-pill">
                                                        <i class="bi bi-columns me-1"></i>@table.Columns.Count Kolon
                                                    </span>
                                                </div>
                                            </div>

                                            @if (isExpanded)
                                            {
                                                <div class="table-card-body">
                                                    <div class="table-responsive">
                                                        <table class="columns-table">
                                                            <thead>
                                                                <tr>
                                                                    <th style="width: 28%;">Kolon Adı</th>
                                                                    <th style="width: 16%;">Veri Tipi</th>
                                                                    <th style="width: 56%;">Açıklama / Formül / İlişki Mantığı</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @foreach (var col in table.Columns)
                                                                {
                                                                    <tr>
                                                                        <td class="col-name-cell">@col.Name</td>
                                                                        <td class="col-type-cell"><span class="type-pill">@col.Type</span></td>
                                                                        <td class="col-desc-cell">
                                                                            @if (!string.IsNullOrEmpty(col.Description))
                                                                            {
                                                                                <span>@col.Description</span>
                                                                            }
                                                                            else
                                                                            {
                                                                                <span class="text-muted">-</span>
                                                                            }
                                                                        </td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="raw-code-container">
                                    <pre class="code-editor-viewport"><code>@FormattedJsonSchema</code></pre>
                                </div>
                            }
                        </div>
                    }

                    <!-- 🧠 TAB 2: ASSISTANT PROMPT -->
                    @if (activeTab == "PROMPT")
                    {
                        <div class="tab-pane-content">
                            <div class="prompt-meta-toolbar">
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <span class="prompt-ver-badge-large @DetectedPromptVersionClass">
                                        <i class="bi bi-patch-check-fill me-1.5"></i> @DetectedPromptVersion
                                    </span>
                                    <span class="prompt-stats-text">
                                        (@(SelectedAssistant.UserAdditionalPrompt?.Length ?? 0) Karakter &bull; ~@((SelectedAssistant.UserAdditionalPrompt?.Length ?? 0) / 6) Kelime)
                                    </span>
                                </div>

                                <button class="btn-copy-action @(isPromptCopied ? "copied" : "")" @onclick="CopyAssistantPrompt">
                                    <i class="bi @(isPromptCopied ? "bi-check-circle-fill text-emerald" : "bi-clipboard-fill")"></i>
                                    <span>@(isPromptCopied ? "Prompt Kopyalandı!" : "Asistan Promptunu Kopyala")</span>
                                </button>
                            </div>

                            @if (string.IsNullOrWhiteSpace(SelectedAssistant.UserAdditionalPrompt))
                            {
                                <div class="empty-schema-notice">
                                    <i class="bi bi-chat-square-dots text-amber fs-2 mb-2"></i>
                                    <div>Bu asistan için `UserAdditionalPrompt` kolonu boş. Özel bir kural yönergesi bulunmuyor.</div>
                                </div>
                            }
                            else
                            {
                                <div class="prompt-editor-viewport">
                                    <pre class="prompt-pre-text">@SelectedAssistant.UserAdditionalPrompt</pre>
                                </div>
                            }
                        </div>
                    }

                    <!-- 🏛️ TAB 3: AGENT PROMPT -->
                    @if (activeTab == "AGENT")
                    {
                        <div class="tab-pane-content">
                            <div class="prompt-meta-toolbar">
                                <div class="agent-info-text">
                                    <i class="bi bi-info-circle-fill text-cyan me-1.5"></i>
                                    SQL çıktısını kurumsal yönetim özetine dönüştüren <strong>McKinsey / Baş Kurumsal Analist</strong> yönergesi.
                                </div>

                                @if (!string.IsNullOrEmpty(SelectedAssistant.UserAdditionalAgentPrompt))
                                {
                                    <button class="btn-copy-action @(isAgentPromptCopied ? "copied" : "")" @onclick="CopyAgentPrompt">
                                        <i class="bi @(isAgentPromptCopied ? "bi-check-circle-fill text-emerald" : "bi-clipboard-fill")"></i>
                                        <span>@(isAgentPromptCopied ? "Kopyalandı!" : "Agent Promptunu Kopyala")</span>
                                    </button>
                                }
                            </div>

                            @if (string.IsNullOrWhiteSpace(SelectedAssistant.UserAdditionalAgentPrompt))
                            {
                                <div class="empty-schema-notice">
                                    <i class="bi bi-person-x text-secondary fs-2 mb-2"></i>
                                    <div>Bu tenant için özel Kurumsal Analist promptu (`UserAdditionalAgentPrompt`) tanımlanmamış.</div>
                                    <div class="text-muted small mt-1">Sistem genelindeki varsayılan analist promptu kullanılmaktadır.</div>
                                </div>
                            }
                            else
                            {
                                <div class="prompt-editor-viewport">
                                    <pre class="prompt-pre-text">@SelectedAssistant.UserAdditionalAgentPrompt</pre>
                                </div>
                            }
                        </div>
                    }

                    <!-- ⚙️ TAB 4: SYSTEM SETTINGS -->
                    @if (activeTab == "SETTINGS")
                    {
                        <div class="tab-pane-content">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="settings-card">
                                        <div class="settings-card-title">
                                            <i class="bi bi-sliders text-cyan"></i>
                                            <span>Model Çıktı & Davranış Ayarları</span>
                                        </div>
                                        
                                        <div class="setting-row">
                                            <span class="setting-label">Asistan Modu</span>
                                            <span class="setting-value text-white">@(SelectedAssistant.AsistantMode == 1 ? "Sorgu Modu (SQL)" : "Asistan Modu")</span>
                                        </div>
                                        <div class="setting-row">
                                            <span class="setting-label">Sıcaklık (Temperature)</span>
                                            <span class="setting-value text-amber">@(SelectedAssistant.Temperature?.ToString("0.0#") ?? "0.1")</span>
                                        </div>
                                        <div class="setting-row">
                                            <span class="setting-label">TopP Değeri</span>
                                            <span class="setting-value text-amber">@(SelectedAssistant.TopP?.ToString("0.0#") ?? "0.95")</span>
                                        </div>
                                        <div class="setting-row">
                                            <span class="setting-label">Satır Limiti (LimitSize)</span>
                                            <span class="setting-value text-cyan">@(SelectedAssistant.LimitSize?.ToString() ?? "50") Satır</span>
                                        </div>
                                        <div class="setting-row border-0">
                                            <span class="setting-label">Sürekli Sohbet (Continuous Chat)</span>
                                            <span class="badge @(SelectedAssistant.IsContinuousChatEnabled ? "bg-success" : "bg-secondary")">
                                                @(SelectedAssistant.IsContinuousChatEnabled ? "Açık" : "Kapalı")
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="settings-card">
                                        <div class="settings-card-title">
                                            <i class="bi bi-terminal-fill text-purple"></i>
                                            <span>Özel Sistem Promptu (Custom System Prompt)</span>
                                        </div>
                                        
                                        @if (!string.IsNullOrEmpty(SelectedAssistant.CustomSystemPrompt))
                                        {
                                            <div class="custom-sys-prompt-box">
                                                <pre class="mb-0 text-light small">@SelectedAssistant.CustomSystemPrompt</pre>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="empty-setting-notice">
                                                <i class="bi bi-dash-circle d-block mb-1 fs-4 text-muted"></i>
                                                Özel sistem promptu tanımlı değil. (Global system prompt devrede)
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- 🛡️ TAB 5: HEALTH CHECK & DIFF -->
                    @if (activeTab == "DIFF")
                    {
                        <div class="tab-pane-content">
                            <!-- Hero Health Banner -->
                            <div class="health-hero-banner">
                                <div>
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <h5 class="fw-bold text-white mb-0">
                                            <i class="bi bi-patch-check-fill text-emerald me-1.5"></i>
                                            @(DetectedErpType == "LOGO" ? "Logo v8.0 Altın Standart Şema Analizi" : (DetectedErpType == "MIKRO" ? "Mikro v27 Altın Standart Şema Analizi" : "ERP Standart Şema Analizi"))
                                        </h5>
                                    </div>
                                    <div class="text-muted small">
                                        Bu tenant'ın yüklü şeması (@parsedTables.Count Tablo), OzBI'nin en güncel @(DetectedErpType == "LOGO" ? "Logo v8.0" : "Mikro v27") referans şeması (@CurrentStandardTables.Count Tablo) ile kıyaslanmaktadır.
                                    </div>
                                </div>

                                <div class="health-counters-group">
                                    <div class="health-counter-pill bg-success-glow">
                                        <div class="counter-num text-emerald">@MatchingStandardTables.Count</div>
                                        <div class="counter-lbl">Eşleşen Tablo</div>
                                    </div>
                                    <div class="health-counter-pill @(MissingStandardTables.Count > 0 ? "bg-warning-glow" : "bg-neutral-glow")">
                                        <div class="counter-num @(MissingStandardTables.Count > 0 ? "text-amber" : "text-muted")">@MissingStandardTables.Count</div>
                                        <div class="counter-lbl">Eksik Tablo</div>
                                    </div>
                                    <div class="health-counter-pill bg-info-glow">
                                        <div class="counter-num text-cyan">@ExtraCustomTables.Count</div>
                                        <div class="counter-lbl">Ek / Özel Tablo</div>
                                    </div>
                                </div>
                            </div>

                            @if (MissingStandardTables.Count > 0)
                            {
                                <div class="missing-tables-alert">
                                    <div class="d-flex align-items-center gap-2 mb-2 text-amber fw-bold">
                                        <i class="bi bi-exclamation-triangle-fill"></i>
                                        <span>Altın Standart Şemada Olup Bu Tenant'ta Eksik Olan Tablolar:</span>
                                    </div>
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var missing in MissingStandardTables)
                                        {
                                            <span class="missing-table-tag">@missing</span>
                                        }
                                    </div>
                                    <div class="alert-footnote">
                                        @if (DetectedErpType == "LOGO")
                                        {
                                            <span>* <code>PAYTRANS</code> (Vadesi geçmiş borç/alacak), <code>KSLINES</code> (Kasa hareketleri) ve <code>EMUHACC</code> (Muhasebe hesapları) tablolarının eksikliği hatalı SQL üretimine neden olabilir.</span>
                                        }
                                        else
                                        {
                                            <span>* Bu tabloların eksik olması durumunda ilgili finansal ve stok raporlarında SQL hataları oluşabilir.</span>
                                        }
                                    </div>
                                </div>
                            }

                            <!-- Matching Tables Tag Cloud -->
                            <div class="mb-4">
                                <div class="section-title-small">
                                    <i class="bi bi-check-circle-fill text-emerald me-1.5"></i>
                                    Mevcut ve Eşleşen Tablolar (@MatchingStandardTables.Count Tablo)
                                </div>
                                <div class="tables-tag-cloud">
                                    @foreach (var t in MatchingStandardTables)
                                    {
                                        <span class="tag-table-match">@t</span>
                                    }
                                </div>
                            </div>

                            @if (ExtraCustomTables.Count > 0)
                            {
                                <div>
                                    <div class="section-title-small">
                                        <i class="bi bi-plus-circle-fill text-cyan me-1.5"></i>
                                        Tenant'a Özel / Standart Dışı Tablolar (@ExtraCustomTables.Count Tablo)
                                    </div>
                                    <div class="tables-tag-cloud">
                                        @foreach (var t in ExtraCustomTables)
                                        {
                                            <span class="tag-table-custom">@t</span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
            </div>

            <!-- 🚪 Modal Footer -->
            <div class="assistant-modal-footer">
                <div class="footer-security-note">
                    <i class="bi bi-lock-fill text-emerald me-1"></i>
                    MariaDB bağlantısı <strong>salt okunur (Read-Only)</strong> güvenlik modunda izole edilmiştir.
                </div>
                <button type="button" class="btn-footer-close" @onclick="CloseModal">Kapat</button>
            </div>
        </div>
    </div>
}

