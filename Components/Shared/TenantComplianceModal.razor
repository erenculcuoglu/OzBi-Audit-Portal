@using OzBiPortalCRM.Models
@using OzBiPortalCRM.Services
@inject IJSRuntime JSRuntime

@if (IsOpen && Scorecard != null)
{
    <div class="modal-backdrop-custom" @onclick="CloseModal">
        <div class="modal-dialog-custom glass-card border-secondary border-opacity-50 text-main" style="max-width: 740px; width: 92%; max-height: 90vh; overflow-y: auto;" @onclick:stopPropagation>
            
            <!-- Modal Header -->
            <div class="d-flex align-items-center justify-content-between pb-3 border-bottom border-secondary border-opacity-25 mb-3">
                <div class="d-flex align-items-center gap-2.5">
                    <div class="p-2 rounded bg-primary bg-opacity-20 text-primary fs-5">
                        <i class="bi bi-heart-pulse-fill"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <h4 class="fw-bold mb-0 text-main">@Scorecard.TenantName</h4>
                            <span class="badge-status badge-info" style="font-size: 0.72rem;">@Scorecard.ErpTypeName</span>
                        </div>
                        <div class="text-muted small">Sistem ve ERP Sağlık Özeti</div>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
            </div>

            <!-- Executive Summary Card -->
            <div class="p-3.5 rounded-3 mb-3 d-flex align-items-center justify-content-between flex-wrap gap-3"
                 style="background: linear-gradient(135deg, rgba(15, 23, 42, 0.95), rgba(30, 41, 59, 0.85)); border: 1px solid rgba(255, 255, 255, 0.1);">
                
                <!-- Left: Score Badge -->
                <div class="d-flex align-items-center gap-3">
                    <div class="text-center p-2.5 rounded-circle border"
                         style="width: 76px; height: 76px; display: flex; align-items: center; justify-content: center; flex-direction: column; background: rgba(0,0,0,0.5); border-color: @GetScoreColor(Scorecard.OverallScore) !important; box-shadow: 0 0 15px @GetScoreGlowColor(Scorecard.OverallScore);">
                        <span class="fs-2 fw-bold" style="color: @GetScoreColor(Scorecard.OverallScore); line-height: 1;">@Scorecard.OverallScore</span>
                        <span class="text-muted" style="font-size: 0.65rem;">/ 100</span>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge px-2.5 py-1 fw-bold" style="background: @GetScoreColor(Scorecard.OverallScore); color: #000; font-size: 0.85rem;">
                                @Scorecard.GradeLabel
                            </span>
                            <span class="text-muted small">(Derece: @Scorecard.Grade)</span>
                        </div>
                        <div class="text-light small" style="max-width: 320px; line-height: 1.35;">
                            @GetHumanSummary(Scorecard)
                        </div>
                    </div>
                </div>

                <!-- Right: Clean Metric Badges -->
                <div class="d-flex gap-2 flex-wrap">
                    <div class="text-center p-2 rounded bg-black bg-opacity-30 border border-success border-opacity-30 px-3">
                        <div class="fs-5 fw-bold text-success">@Scorecard.CompliantCount</div>
                        <div class="text-muted" style="font-size: 0.72rem;">Kusursuz Sorgu</div>
                    </div>
                    <div class="text-center p-2 rounded bg-black bg-opacity-30 border border-warning border-opacity-30 px-3">
                        <div class="fs-5 fw-bold text-warning">@Scorecard.WarningCount</div>
                        <div class="text-muted" style="font-size: 0.72rem;">İyileştirilebilir</div>
                    </div>
                    <div class="text-center p-2 rounded bg-black bg-opacity-30 border border-danger border-opacity-30 px-3">
                        <div class="fs-5 fw-bold @(Scorecard.CriticalCount > 0 ? "text-danger" : "text-muted")">@Scorecard.CriticalCount</div>
                        <div class="text-muted" style="font-size: 0.72rem;">Kritik Hata</div>
                    </div>
                </div>
            </div>

            <!-- Single Distribution Bar -->
            <div class="mb-3 px-1">
                <div class="d-flex justify-content-between text-muted small mb-1" style="font-size: 0.75rem;">
                    <span><i class="bi bi-bar-chart me-1"></i>Sorgu Başarı Dağılımı (%@Scorecard.CompliantPercentage Başarılı)</span>
                    <span>Toplam <strong>@Scorecard.TotalQueriesEvaluated</strong> Sorgu</span>
                </div>
                <div class="progress" style="height: 8px; background-color: rgba(255, 255, 255, 0.08); border-radius: 4px; overflow: hidden;">
                    @if (Scorecard.CompliantPercentage > 0)
                    {
                        <div class="progress-bar bg-success" style="width: @Scorecard.CompliantPercentage%;"></div>
                    }
                    @if (Scorecard.WarningPercentage > 0)
                    {
                        <div class="progress-bar bg-warning" style="width: @Scorecard.WarningPercentage%;"></div>
                    }
                    @if (Scorecard.CriticalPercentage > 0)
                    {
                        <div class="progress-bar bg-danger" style="width: @Scorecard.CriticalPercentage%;"></div>
                    }
                </div>
            </div>

            <!-- Actionable Recommendations (Human Language) -->
            <div class="mb-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <h6 class="fw-bold text-light mb-0" style="font-size: 0.9rem;">
                        <i class="bi bi-lightbulb-fill text-warning me-1.5"></i>
                        @(Scorecard.TopViolations.Count > 0 ? "İyileştirme Tavsiyeleri ve İpuçları" : "Sistem Durumu")
                    </h6>
                    @if (Scorecard.TopViolations.Count > 0)
                    {
                        <span class="text-muted small" style="font-size: 0.75rem;">
                            @Scorecard.TopViolations.Count tavsiye bulundu
                        </span>
                    }
                </div>

                @if (Scorecard.TopViolations.Count == 0)
                {
                    <div class="p-3 text-center rounded bg-success bg-opacity-10 border border-success border-opacity-25 text-success">
                        <i class="bi bi-check-circle-fill fs-4 mb-1 d-block"></i>
                        <div class="fw-semibold small">Harika! Bu firmada hiçbir kural ihlali veya aksama bulunmuyor.</div>
                        <div class="text-muted small mt-0.5" style="font-size: 0.75rem;">Tüm yapay zeka sorguları standartlara tam uyumlu çalışmaktadır.</div>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-2">
                        @foreach (var (v, idx) in Scorecard.TopViolations.Select((item, index) => (item, index + 1)))
                        {
                            var isExpanded = expandedViolations.Contains(v.RuleId);
                            var isWarning = v.Severity.Equals("Warning", StringComparison.OrdinalIgnoreCase);
                            var cardBg = isWarning ? "bg-warning bg-opacity-10 border-warning border-opacity-25" : "bg-danger bg-opacity-10 border-danger border-opacity-25";
                            var iconColor = isWarning ? "text-warning" : "text-danger";

                            <div class="p-3 rounded border @cardBg" style="transition: all 0.2s ease;">
                                <div class="d-flex align-items-start justify-content-between gap-2">
                                    <div class="d-flex align-items-start gap-2.5">
                                        <i class="bi @(isWarning ? "bi-exclamation-circle-fill" : "bi-x-circle-fill") @iconColor mt-0.5" style="font-size: 1.1rem;"></i>
                                        <div>
                                            <div class="fw-bold text-light mb-0.5" style="font-size: 0.88rem;">
                                                @GetSimplifiedTitle(v.Title)
                                            </div>
                                            <div class="text-muted small" style="font-size: 0.78rem;">
                                                Bu durum son sorgularda <strong class="text-light">@v.Count kez</strong> (%@v.Percentage) karşılaşıldı.
                                            </div>
                                        </div>
                                    </div>

                                    @if (!string.IsNullOrEmpty(v.RecommendedFix))
                                    {
                                        <button class="btn btn-sm btn-link text-info p-0 text-decoration-none small" style="font-size: 0.75rem; white-space: nowrap;" @onclick="() => ToggleViolationDetail(v.RuleId)">
                                            <i class="bi @(isExpanded ? "bi-chevron-up" : "bi-chevron-down") me-0.5"></i>
                                            @(isExpanded ? "Gizle" : "Detay")
                                        </button>
                                    }
                                </div>

                                @if (isExpanded && !string.IsNullOrEmpty(v.RecommendedFix))
                                {
                                    <div class="mt-2.5 pt-2 border-top border-secondary border-opacity-25">
                                        <div class="text-info small fw-semibold mb-1" style="font-size: 0.75rem;">
                                            <i class="bi bi-wrench me-1"></i> Tavsiye Edilen Çözüm:
                                        </div>
                                        <div class="p-2 rounded bg-black bg-opacity-50 text-light font-monospace small" style="font-size: 0.75rem; word-break: break-word;">
                                            @v.RecommendedFix
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Modal Footer -->
            <div class="d-flex align-items-center justify-content-between pt-2.5 border-top border-secondary border-opacity-25 flex-wrap gap-2">
                <div class="text-muted small" style="font-size: 0.72rem;">
                    <i class="bi bi-clock-history me-1"></i> Son Güncelleme: @Scorecard.LastEvaluatedAt.ToString("dd.MM.yyyy HH:mm")
                </div>

                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-info btn-sm" @onclick="OnRefreshRequested" disabled="@isRefreshing">
                        @if (isRefreshing)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            <span>Hesaplanıyor...</span>
                        }
                        else
                        {
                            <i class="bi bi-arrow-clockwise me-1"></i>
                            <span>Yeniden Analiz Et</span>
                        }
                    </button>

                    <button type="button" class="btn btn-secondary btn-sm px-3" @onclick="CloseModal">
                        Kapat
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public TenantComplianceScorecard? Scorecard { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback OnRefresh { get; set; }

    private HashSet<string> expandedViolations = new();
    private bool isRefreshing = false;

    private void ToggleViolationDetail(string ruleId)
    {
        if (expandedViolations.Contains(ruleId))
            expandedViolations.Remove(ruleId);
        else
            expandedViolations.Add(ruleId);
    }

    private async Task CloseModal()
    {
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    private async Task OnRefreshRequested()
    {
        if (OnRefresh.HasDelegate)
        {
            isRefreshing = true;
            try
            {
                await OnRefresh.InvokeAsync();
            }
            finally
            {
                isRefreshing = false;
            }
        }
    }

    private string GetHumanSummary(TenantComplianceScorecard sc)
    {
        if (sc.OverallScore >= 95)
            return "Yapay zeka sorguları sisteme tam uyumlu ve çok yüksek performansla çalışıyor.";
        if (sc.OverallScore >= 80)
            return "Genel sistem performansı iyi. Birkaç küçük optimizasyon önerisi bulunuyor.";
        if (sc.OverallScore >= 60)
            return "Bazı sorgularda filtreleme ve şablon uyumsuzlukları mevcut, gözden geçirilmesi önerilir.";
        return "Sorgularda sıkça hata ve kural ihlali oluşuyor, teknik inceleme önerilir.";
    }

    private string GetSimplifiedTitle(string rawTitle)
    {
        if (string.IsNullOrWhiteSpace(rawTitle)) return "Genel İyileştirme Önerisi";
        
        // Strip out brackets like [M-06], [M-03] if present in title
        var title = rawTitle;
        if (title.StartsWith("[") && title.Contains("]"))
        {
            var endIdx = title.IndexOf("]");
            if (endIdx + 1 < title.Length)
                title = title.Substring(endIdx + 1).Trim();
        }

        return title;
    }

    private string GetScoreColor(int score)
    {
        if (score >= 90) return "#10b981"; // emerald green
        if (score >= 75) return "#38bdf8"; // sky blue
        if (score >= 60) return "#f59e0b"; // amber
        return "#ef4444"; // red
    }

    private string GetScoreGlowColor(int score)
    {
        if (score >= 90) return "rgba(16, 185, 129, 0.3)";
        if (score >= 75) return "rgba(56, 189, 248, 0.3)";
        if (score >= 60) return "rgba(245, 158, 11, 0.3)";
        return "rgba(239, 68, 68, 0.3)";
    }
}
