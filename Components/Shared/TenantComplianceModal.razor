@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public TenantComplianceScorecard? Scorecard { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback OnRefresh { get; set; }

    private HashSet<string> expandedViolations = new();
    private bool isRefreshing = false;
    private string activeFilter = "ALL";
    private string? copiedRuleId = null;

    private List<TenantRuleViolationStat> filteredViolations
    {
        get
        {
            if (Scorecard == null || Scorecard.TopViolations == null) return new();
            if (activeFilter == "WARNING")
                return Scorecard.TopViolations.Where(v => IsWarningSeverity(v.Severity)).ToList();
            if (activeFilter == "CRITICAL")
                return Scorecard.TopViolations.Where(v => !IsWarningSeverity(v.Severity)).ToList();
            return Scorecard.TopViolations;
        }
    }

    private bool IsWarningSeverity(string? severity)
    {
        if (string.IsNullOrWhiteSpace(severity)) return true;
        return severity.Equals("Warning", StringComparison.OrdinalIgnoreCase) ||
               severity.Equals("Info", StringComparison.OrdinalIgnoreCase);
    }

    private void ToggleViolationDetail(string ruleId)
    {
        if (expandedViolations.Contains(ruleId))
            expandedViolations.Remove(ruleId);
        else
            expandedViolations.Add(ruleId);
    }

    private async Task CopyToClipboard(string ruleId, string text)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
            copiedRuleId = ruleId;
            StateHasChanged();
            
            _ = Task.Run(async () =>
            {
                await Task.Delay(2000);
                if (copiedRuleId == ruleId)
                {
                    copiedRuleId = null;
                    await InvokeAsync(StateHasChanged);
                }
            });
        }
        catch { }
    }

    private async Task CloseModal()
    {
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    private async Task OnRefreshRequested()
    {
        if (OnRefresh.HasDelegate)
        {
            isRefreshing = true;
            try
            {
                await OnRefresh.InvokeAsync();
            }
            finally
            {
                isRefreshing = false;
            }
        }
    }

    private string GetHumanSummary(TenantComplianceScorecard sc)
    {
        if (sc.OverallScore >= 95)
            return "Yapay zeka sorguları sisteme tam uyumlu ve olağanüstü performansla çalışıyor.";
        if (sc.OverallScore >= 80)
            return "Genel sistem ve T-SQL performansı iyi. Birkaç küçük optimizasyon tavsiyesi bulunuyor.";
        if (sc.OverallScore >= 60)
            return "Sorgularda performans ve filtreleme eksikleri mevcut, optimize edilmesi önerilir.";
        return "Sorgularda kural ihlali ve sözdizimi riskleri tespit edildi, teknik revizyon gereklidir.";
    }

    private string GetSimplifiedTitle(string rawTitle)
    {
        if (string.IsNullOrWhiteSpace(rawTitle)) return "Genel İyileştirme Önerisi";
        
        var title = rawTitle;
        if (title.StartsWith("[") && title.Contains("]"))
        {
            var endIdx = title.IndexOf("]");
            if (endIdx + 1 < title.Length)
                title = title.Substring(endIdx + 1).Trim();
        }

        return title;
    }

    private string GetScoreColor(int score)
    {
        if (score >= 90) return "#10b981"; // Emerald
        if (score >= 75) return "#38bdf8"; // Sky Blue
        if (score >= 60) return "#f59e0b"; // Amber
        return "#ef4444"; // Red
    }

    private string GetScoreGlowColor(int score)
    {
        if (score >= 90) return "rgba(16, 185, 129, 0.4)";
        if (score >= 75) return "rgba(56, 189, 248, 0.4)";
        if (score >= 60) return "rgba(245, 158, 11, 0.4)";
        return "rgba(239, 68, 68, 0.4)";
    }
}
