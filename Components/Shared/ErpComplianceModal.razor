@using OzBiPortalCRM.Services
@inject IJSRuntime JSRuntime

@if (IsOpen && Report != null)
{
    var erpReport = Report as ErpComplianceReport;
    var erpTitle = SystemTypeName ?? (erpReport?.SystemTypeName ?? "ERP Uyum Analizi");

    <div class="modal-backdrop-custom" @onclick="CloseModal">
        <div class="modal-dialog-custom glass-card border-secondary border-opacity-50 text-main" style="max-width: 720px; width: 90%; max-height: 90vh; overflow-y: auto;" @onclick:stopPropagation>
            <!-- Modal Header -->
            <div class="d-flex align-items-center justify-content-between pb-3 border-bottom border-secondary border-opacity-25 mb-4">
                <div>
                    <h4 class="fw-bold mb-0">@erpTitle T-SQL Denetim Raporu</h4>
                    <div class="text-muted small">@erpTitle Şema & Prompt Standartları Uyumluluk Analizi</div>
                </div>
                <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
            </div>

            <!-- Score Summary Card -->
            <div class="p-4 rounded mb-4 d-flex align-items-center justify-content-between flex-wrap gap-3"
                 style="background: linear-gradient(135deg, rgba(15, 23, 42, 0.9), rgba(30, 41, 59, 0.9)); border: 1px solid rgba(255, 255, 255, 0.1);">
                <div class="d-flex align-items-center gap-3">
                    <div class="text-center p-3 rounded-circle border"
                         style="width: 80px; height: 80px; display: flex; align-items: center; justify-content: center; flex-direction: column; background: rgba(0,0,0,0.4); border-color: @GetScoreColor(Report.Score) !important;">
                        <span class="fs-3 fw-bold" style="color: @GetScoreColor(Report.Score); line-height: 1;">@Report.Score</span>
                        <span class="text-muted" style="font-size: 0.65rem;">/ 100</span>
                    </div>
                    <div>
                        <span class="badge px-3 py-1 mb-1 fw-bold fs-6" style="background: @GetScoreColor(Report.Score); color: #000;">
                            @Report.GradeLabel
                        </span>
                        <div class="text-main small">@Report.SummaryText</div>
                    </div>
                </div>

                <div class="d-flex gap-3">
                    <div class="text-center p-2 rounded bg-black bg-opacity-30 border border-secondary border-opacity-25 px-3">
                        <div class="fs-5 fw-bold text-success">@Report.PassedChecks.Count</div>
                        <div class="text-muted small">Geçilen Kural</div>
                    </div>
                    <div class="text-center p-2 rounded bg-black bg-opacity-30 border border-secondary border-opacity-25 px-3">
                        <div class="fs-5 fw-bold @(Report.Violations.Count > 0 ? "text-danger" : "text-muted")">@Report.Violations.Count</div>
                        <div class="text-muted small">İhlal / Ceza</div>
                    </div>
                </div>
            </div>

            <!-- Cross-Check Sync Status Card -->
            @if (erpReport != null)
            {
                <div class="p-3 mb-4 rounded border d-flex align-items-center justify-content-between flex-wrap gap-2 @(erpReport.IsPromptSynced ? "bg-success bg-opacity-10 border-success border-opacity-30 text-success" : "bg-warning bg-opacity-10 border-warning border-opacity-30 text-warning")">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi @(erpReport.IsPromptSynced ? "bi-arrow-repeat fs-4 text-success" : "bi-exclamation-circle-fill fs-4 text-warning")"></i>
                        <div>
                            <div class="fw-bold small">Cross-Check Şema & Asistan Prompt Uyum Durumu</div>
                            <div class="small opacity-90" style="font-size: 0.825rem;">@erpReport.PromptSyncDetails</div>
                        </div>
                    </div>
                    <span class="badge @(erpReport.IsPromptSynced ? "bg-success" : "bg-warning text-dark") px-2.5 py-1">
                        @erpReport.PromptVersionLabel
                    </span>
                </div>
            }

            <!-- Rule Violations (Penalties) -->
            @if (Report.Violations.Count > 0)
            {
                <div class="mb-4">
                    <h6 class="fw-bold text-danger mb-3 d-flex align-items-center gap-2">
                        <i class="bi bi-exclamation-triangle-fill"></i> Tespit Edilen Kural İhlalleri & Puan Düşüşleri
                    </h6>

                    <div class="d-flex flex-column gap-3">
                        @foreach (var v in Report.Violations)
                        {
                            var isWarning = v.Severity?.Equals("Warning", StringComparison.OrdinalIgnoreCase) == true;
                            var isInfo = v.Severity?.Equals("Info", StringComparison.OrdinalIgnoreCase) == true;
                            
                            var cardBg = isWarning ? "bg-warning bg-opacity-10 border-warning border-opacity-30" :
                                         isInfo ? "bg-info bg-opacity-10 border-info border-opacity-30" :
                                         "bg-danger bg-opacity-10 border-danger border-opacity-30";

                            var titleColor = isWarning ? "text-warning" : isInfo ? "text-info" : "text-danger";
                            var iconClass = isWarning ? "bi bi-exclamation-triangle me-1" : isInfo ? "bi bi-info-circle me-1" : "bi bi-x-circle me-1";
                            var badgeBg = isWarning ? "bg-warning text-dark" : isInfo ? "bg-info text-dark" : "bg-danger text-white";

                            <div class="p-3 rounded border @cardBg">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="fw-bold @titleColor">
                                        <i class="@iconClass"></i> [@v.RuleId] @v.Title
                                    </span>
                                    <span class="badge @badgeBg font-monospace">
                                        -@v.PenaltyPoints Puan
                                    </span>
                                </div>
                                <div class="text-main small mb-2">
                                    <strong>Sorun:</strong> @v.IssueDescription
                                </div>
                                <div class="p-2 rounded bg-black bg-opacity-40 text-warning small font-monospace mb-2" style="font-size: 0.8rem;">
                                    <i class="bi bi-book me-1"></i> <strong>@erpTitle Standardı:</strong> @v.V26RuleReference
                                </div>
                                <div class="text-success small fw-semibold">
                                    <i class="bi bi-magic me-1"></i> <strong>Çözüm Önerisi:</strong> @v.RecommendedFix
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Passed Rules -->
            @if (Report.PassedChecks.Count > 0)
            {
                <div class="mb-4">
                    <h6 class="fw-bold text-success mb-3 d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill"></i> Başarıyla Uyulan @erpTitle Kuralları
                    </h6>

                    <div class="row g-2">
                        @foreach (var p in Report.PassedChecks)
                        {
                            <div class="col-md-6">
                                <div class="p-2.5 rounded bg-success bg-opacity-10 border border-success border-opacity-20 d-flex align-items-start gap-2 h-100">
                                    <i class="bi bi-patch-check-fill text-success fs-5"></i>
                                    <div>
                                        <div class="fw-bold text-success small">[@p.RuleId] @p.Title</div>
                                        <div class="text-muted" style="font-size: 0.775rem;">@p.Description</div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Original T-SQL Query Code Box -->
            <div class="mb-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="fw-bold small text-info"><i class="bi bi-code-slash me-1"></i>Denetlenen T-SQL Sorgusu</span>
                    <button class="btn-copy" @onclick="CopySql">
                        <i class="bi bi-clipboard"></i> Kopyala
                    </button>
                </div>
                <div class="sql-code-block">
                    <code>@TestedSql</code>
                </div>
            </div>

            <!-- Footer -->
            <div class="text-end pt-3 border-top border-secondary border-opacity-25">
                <button class="btn btn-secondary px-4" @onclick="CloseModal">Kapat</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public MikroComplianceReport? Report { get; set; }
    [Parameter] public string? SystemTypeName { get; set; }
    [Parameter] public string TestedSql { get; set; } = string.Empty;

    private async Task CloseModal()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private string GetScoreColor(int score)
    {
        if (score >= 90) return "#10b981"; // Green
        if (score >= 75) return "#3b82f6"; // Blue
        if (score >= 60) return "#f59e0b"; // Yellow/Amber
        return "#ef4444"; // Red
    }

    private async Task CopySql()
    {
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", TestedSql);
    }
}
