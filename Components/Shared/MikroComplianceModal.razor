@using OzBiPortalCRM.Services

<ErpComplianceModal IsOpen="IsOpen" IsOpenChanged="IsOpenChanged" Report="Report" SystemTypeName="@SystemTypeName" TestedSql="@TestedSql" />

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public MikroComplianceReport? Report { get; set; }
    [Parameter] public string? SystemTypeName { get; set; }
    [Parameter] public string TestedSql { get; set; } = string.Empty;
}
